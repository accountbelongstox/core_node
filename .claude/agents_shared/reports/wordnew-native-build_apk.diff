+def resolve_app_version(app: dict) -> tuple[str, int]:
+    version_name = str(app.get("version") or "")
+    match = VERSION_PATTERN.fullmatch(version_name)
+    if not match:
+        fail(f"{app.get('_manifest', app['id'])}: version must be MAJOR.MINOR.PATCH, got '{version_name}'.")
+    major, minor, patch = (int(part) for part in match.groups())
+    version_code = major * VERSION_CODE_MAJOR_STEP + minor * VERSION_CODE_MINOR_STEP + patch
+    minor_limit = VERSION_CODE_MAJOR_STEP // VERSION_CODE_MINOR_STEP
+    if minor >= minor_limit or patch >= VERSION_CODE_MINOR_STEP or not 0 < version_code <= VERSION_CODE_MAX:
+        fail(f"Version '{version_name}' of {app['id']} has no valid versionCode: MINOR must be < {minor_limit}, "
+             f"PATCH < {VERSION_CODE_MINOR_STEP}, and the code within 1..{VERSION_CODE_MAX}.")
+    return version_name, version_code
+
+
+def keystore_is_complete(data: bytes) -> bool:
+    if data[:4] in KEYSTORE_MAGIC_HEADERS:
+        return True
+    if len(data) < 2 or data[0] != DER_SEQUENCE_TAG:
+        return False
+    if data[1] < DER_LONG_FORM_FLAG:
+        return len(data) == 2 + data[1]
+    width = data[1] - DER_LONG_FORM_FLAG
+    if width == 0:
+        return True
+    return len(data) == 2 + width + int.from_bytes(data[2:2 + width], "big")
+
+
+def read_release_signing(app: dict, repo_root: Path) -> tuple[bytes, dict[str, str]]:
+    prefix = re.sub(r"[^A-Z0-9]", "_", str(app["id"]).upper())
+    names = {key: template.format(prefix=prefix) for key, template in SIGNING_SECRET_NAMES.items()}
+    if str(repo_root) not in sys.path:
+        sys.path.insert(0, str(repo_root))
+    try:
+        from pycore.pyfoundations.secret_manager import get_secret_key
+    except ImportError as error:
+        fail(f"Cannot load the secret-store reader from {repo_root}: {error}")
+    values = {key: get_secret_key(name) for key, name in names.items()}
+    missing = [names[key] for key, value in values.items() if not value]
+    if missing:
+        fail(f"Release signing secrets are missing: {', '.join(missing)}. "
+             f"Put them in {SECRET_STORE_RAW_DIR}/ (the keystore as single-line base64), "
+             f"or decrypt them with the {SECRET_DECRYPT_STEP}. Debug builds need no signing secrets.")
+    try:
+        keystore = base64.b64decode(values.pop("keystore"), validate=True)
+    except (binascii.Error, ValueError):
+        keystore = b""
+    if not keystore_is_complete(keystore):
+        fail(f"{names['keystore']} is not a complete keystore. Store it as single-line base64 "
+             f"in {SECRET_STORE_RAW_DIR}/{names['keystore']}.")
+    return keystore, {SIGNING_ENVIRONMENT_NAMES[key]: value for key, value in values.items()}
+
