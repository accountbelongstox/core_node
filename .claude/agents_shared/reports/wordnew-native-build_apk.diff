+@contextmanager
+def release_signing_environment(keystore: bytes, credentials: dict[str, str], repo_root: Path) -> Iterator[dict[str, str]]:
+    temp_dir = Path(tempfile.gettempdir()).resolve()
+    if temp_dir == repo_root or repo_root in temp_dir.parents:
+        fail(f"The temporary directory {temp_dir} is inside the repository; point TMPDIR/TEMP outside it.")
+    handle, keystore_name = tempfile.mkstemp(prefix=KEYSTORE_TEMP_PREFIX, suffix=KEYSTORE_TEMP_SUFFIX, dir=temp_dir)
+    keystore_path = Path(keystore_name)
+    try:
+        with os.fdopen(handle, "wb") as stream:
+            stream.write(keystore)
+        yield {**credentials, SIGNING_ENVIRONMENT_NAMES["keystore"]: str(keystore_path)}
+    finally:
+        try:
+            keystore_path.unlink(missing_ok=True)
+        except OSError as error:
+            log(f"WARNING: could not remove the temporary keystore {keystore_path}: {error}")
+
