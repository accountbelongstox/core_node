+def ensure_gradle_wrapper(root: Path, android_dir: Path) -> None:
+    missing = [name for name in GRADLE_WRAPPER_FILES if not (android_dir / name).is_file()]
+    if not missing:
+        return
+    template = root / CAPACITOR_ANDROID_TEMPLATE
+    if not template.is_file():
+        fail(f"Gradle wrapper files are missing in {android_dir}: {', '.join(missing)}. "
+             f"The Capacitor Android template {template} is missing too; run bun install in {root}.")
+    with tarfile.open(template, "r:gz") as archive:
+        members = {member.name.removeprefix("./"): member for member in archive.getmembers() if member.isfile()}
+        absent = [name for name in missing if name not in members]
+        if absent:
+            fail(f"Gradle wrapper files are missing in {android_dir} and in {template}: {', '.join(absent)}")
+        for name in missing:
+            destination = android_dir / name
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            with archive.extractfile(members[name]) as source, destination.open("xb") as target:
+                shutil.copyfileobj(source, target)
+            log(f"Restored {name} from {template}")
+
