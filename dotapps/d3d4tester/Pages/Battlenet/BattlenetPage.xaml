<UserControl x:Class="DotApps.d3d4tester.Pages.Battlenet.BattlenetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:DotApps.d3d4tester.Components">
  <!-- Battle.net management, no scrolling: live client state strip on top, sub-tabs for guard + restart rules, network hold, global region + accounts -->
  <UserControl.Resources>
    <ResourceDictionary Source="/d3d4tester;component/Assets/Styles/CompactPage.xaml"/>
  </UserControl.Resources>
  <Grid Margin="8,6,8,4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Live client state -->
    <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LblStateTitle" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="LblClientState" Grid.Column="1" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="TxtClientState" Grid.Column="2" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="LblUiRegion" Grid.Column="3" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="TxtUiRegion" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="LblStateDetail" Grid.Column="5" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="TxtStateDetail" Grid.Column="6" Grid.ColumnSpan="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="8" Orientation="Horizontal">
          <Button x:Name="BtnProbe" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnProbe_Click"/>
          <Button x:Name="BtnRestart" Style="{StaticResource WarningButtonStyle}" Click="BtnRestart_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="TabsBattlenet" Grid.Row="2">
      <!-- Guard + restart rules -->
      <TabItem x:Name="TabGuard">
        <StackPanel Margin="4,8,4,4">
          <CheckBox x:Name="ChkEnsureNormal" Margin="0,0,0,6"/>
          <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="56"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="ChkAbnormalRestart" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox x:Name="TxtAbnormalTimeout" Grid.Column="1" TextAlignment="Right" Margin="0,0,6,6"/>
            <TextBlock x:Name="LblAbnormalSec" Grid.Column="2" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkLoginRestart" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtLoginTimeout" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblLoginSec" Grid.Row="1" Grid.Column="2" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="TxtGuardDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </TabItem>

      <!-- Network hold (D4 download) -->
      <TabItem x:Name="TabNetHold">
        <Grid Margin="4,8,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <CheckBox x:Name="ChkNetHold" Margin="0,0,0,4"/>
            <CheckBox x:Name="ChkNetHoldOnBoot"/>
            <comp:StartupShortcutPathLabel Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock x:Name="LblNetHoldInterval" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="TxtNetHoldInterval" Width="52" TextAlignment="Right" Margin="0,0,4,0"/>
              <TextBlock x:Name="LblNetHoldSec" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblD4InstallPath" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="TxtD4InstallPath" Grid.Column="1" Margin="0,0,6,0"/>
              <Button x:Name="BtnD4InstallPathBrowse" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="BtnD4InstallPathBrowse_Click"/>
            </Grid>
            <WrapPanel Margin="0,0,0,2">
              <Button x:Name="BtnEnsureClient" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4" Click="BtnEnsureClient_Click"/>
              <Button x:Name="BtnNetHoldNow" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnNetHoldNow_Click"/>
              <Button x:Name="BtnOpenD4Page" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnOpenD4Page_Click"/>
              <Button x:Name="BtnPauseDownload" Style="{StaticResource WarningButtonStyle}" Margin="0,0,6,4" Click="BtnPauseDownload_Click"/>
              <Button x:Name="BtnResumeDownload" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4" Click="BtnResumeDownload_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtNetHoldDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock x:Name="LblNetHoldStatus" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtNetHoldStatus" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <ProgressBar x:Name="PrgNetHold" Grid.Row="1" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtNetHoldProgress" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="LblNetHoldHistory" Grid.Row="3" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
            <ListBox x:Name="LstNetHoldHistory" Grid.Row="4" MinHeight="60"/>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Global region + accounts per region -->
      <TabItem x:Name="TabRegion">
        <Grid Margin="4,8,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
              <TextBlock x:Name="LblRegion" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbRegion">
                <ComboBoxItem x:Name="ItemRegionCn"/>
                <ComboBoxItem x:Name="ItemRegionAsia"/>
              </ComboBox>
            </DockPanel>
            <CheckBox x:Name="ChkRegionPrompt" Grid.Row="1" Margin="0,0,0,6"/>
            <TextBlock x:Name="LblAccounts" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
            <ListBox x:Name="LstAccounts" Grid.Row="3" MinHeight="60" SelectionChanged="LstAccounts_SelectionChanged"/>
          </Grid>
          <StackPanel Grid.Column="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LblAccountLabel" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtAccountLabel" Grid.Column="1" Margin="0,0,0,4"/>
              <TextBlock x:Name="LblAccountEmail" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtAccountEmail" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
              <TextBlock x:Name="LblAccountPassword" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <PasswordBox x:Name="PwdAccountPassword" Grid.Row="2" Grid.Column="1"/>
            </Grid>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="BtnSaveAccount" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnSaveAccount_Click"/>
              <Button x:Name="BtnRemoveAccount" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnRemoveAccount_Click"/>
              <Button x:Name="BtnUseAccount" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4" Click="BtnUseAccount_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtAccountsDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
