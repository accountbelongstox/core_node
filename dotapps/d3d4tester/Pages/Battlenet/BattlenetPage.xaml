<UserControl x:Class="DotApps.d3d4tester.Pages.Battlenet.BattlenetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Battle.net management: guard + restart rules, global region, accounts per region, live client state -->
  <Grid Margin="8,6,8,4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock x:Name="LblGuardTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
          <CheckBox x:Name="ChkEnsureNormal" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="ChkAbnormalRestart" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="TxtAbnormalTimeout" Grid.Column="1" TextAlignment="Right" Margin="0,0,6,4"/>
            <TextBlock x:Name="LblAbnormalSec" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <CheckBox x:Name="ChkLoginRestart" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtLoginTimeout" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblLoginSec" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="TxtGuardDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock x:Name="LblNetHoldTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
          <CheckBox x:Name="ChkNetHold" Margin="0,0,0,4"/>
          <CheckBox x:Name="ChkNetHoldOnBoot" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock x:Name="LblNetHoldInterval" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtNetHoldInterval" Width="64" TextAlignment="Right" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblNetHoldSec" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="80"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblNetHoldStatus" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtNetHoldStatus" Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap"/>
          </Grid>
          <ProgressBar x:Name="PrgNetHold" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,4"/>
          <TextBlock x:Name="TxtNetHoldProgress" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="LblNetHoldHistory" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
          <ListBox x:Name="LstNetHoldHistory" Height="110" Margin="0,0,0,6"/>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="80"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblD4InstallPath" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtD4InstallPath" Grid.Column="1" Margin="0,0,6,0"/>
            <Button x:Name="BtnD4InstallPathBrowse" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="BtnD4InstallPathBrowse_Click"/>
          </Grid>
          <WrapPanel>
            <Button x:Name="BtnEnsureClient" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4" Click="BtnEnsureClient_Click"/>
            <Button x:Name="BtnNetHoldNow" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnNetHoldNow_Click"/>
            <Button x:Name="BtnOpenD4Page" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnOpenD4Page_Click"/>
            <Button x:Name="BtnPauseDownload" Style="{StaticResource WarningButtonStyle}" Margin="0,0,6,4" Click="BtnPauseDownload_Click"/>
            <Button x:Name="BtnResumeDownload" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4" Click="BtnResumeDownload_Click"/>
          </WrapPanel>
          <TextBlock x:Name="TxtNetHoldDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorderStyle}" Padding="10,8">
        <StackPanel>
          <TextBlock x:Name="LblStateTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="80"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LblClientState" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4"/>
            <TextBlock x:Name="TxtClientState" Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="LblUiRegion" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4"/>
            <TextBlock x:Name="TxtUiRegion" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
            <TextBlock x:Name="LblStateDetail" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStateDetail" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BtnProbe" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnProbe_Click"/>
            <Button x:Name="BtnRestart" Style="{StaticResource WarningButtonStyle}" Click="BtnRestart_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,8" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock x:Name="LblRegionTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="80"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LblRegion" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <ComboBox x:Name="CmbRegion" Grid.Column="1">
            <ComboBoxItem x:Name="ItemRegionCn"/>
            <ComboBoxItem x:Name="ItemRegionAsia"/>
          </ComboBox>
        </Grid>
        <CheckBox x:Name="ChkRegionPrompt" Margin="0,0,0,6"/>

        <TextBlock x:Name="LblAccounts" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
        <ListBox x:Name="LstAccounts" Height="96" Margin="0,0,0,6" SelectionChanged="LstAccounts_SelectionChanged"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="80"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="LblAccountLabel" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtAccountLabel" Grid.Column="1" Margin="0,0,0,4"/>
          <TextBlock x:Name="LblAccountEmail" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtAccountEmail" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
          <TextBlock x:Name="LblAccountPassword" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <PasswordBox x:Name="PwdAccountPassword" Grid.Row="2" Grid.Column="1"/>
        </Grid>
        <WrapPanel Margin="0,6,0,0">
          <Button x:Name="BtnSaveAccount" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnSaveAccount_Click"/>
          <Button x:Name="BtnRemoveAccount" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnRemoveAccount_Click"/>
          <Button x:Name="BtnUseAccount" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4" Click="BtnUseAccount_Click"/>
        </WrapPanel>
        <TextBlock x:Name="TxtAccountsDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
