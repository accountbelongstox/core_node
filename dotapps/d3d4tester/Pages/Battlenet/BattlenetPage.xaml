<UserControl x:Class="DotApps.d3d4tester.Pages.Battlenet.BattlenetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Battle.net management: guard switch, global region, login credentials, live client state -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="900" HorizontalAlignment="Left">
      <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblGuardTitle" Style="{StaticResource SectionHeaderTextStyle}"/>
          <CheckBox x:Name="ChkEnsureNormal" Margin="0,0,0,4"/>
          <TextBlock x:Name="TxtGuardDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblRegionTitle" Style="{StaticResource SectionHeaderTextStyle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LblRegion" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <ComboBox x:Name="CmbRegion" Grid.Column="1" Margin="0,0,0,8">
              <ComboBoxItem x:Name="ItemRegionCn"/>
              <ComboBoxItem x:Name="ItemRegionAsia"/>
            </ComboBox>
            <TextBlock x:Name="LblCredentials" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0"/>
            <TextBlock x:Name="TxtCredentialsState" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
            <Button x:Name="BtnEditCredentials" Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="8,0,0,0" Click="BtnEditCredentials_Click"/>
          </Grid>
          <TextBlock x:Name="TxtCredentialsDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblStateTitle" Style="{StaticResource SectionHeaderTextStyle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LblClientState" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <TextBlock x:Name="TxtClientState" Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" Margin="0,0,0,8"/>
            <TextBlock x:Name="LblUiRegion" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <TextBlock x:Name="TxtUiRegion" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="LblStateDetail" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0"/>
            <TextBlock x:Name="TxtStateDetail" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnProbe" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnProbe_Click"/>
            <Button x:Name="BtnRestart" Style="{StaticResource WarningButtonStyle}" Click="BtnRestart_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
