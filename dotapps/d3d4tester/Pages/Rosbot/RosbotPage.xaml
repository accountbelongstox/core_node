<UserControl x:Class="DotApps.d3d4tester.Pages.Rosbot.RosbotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Layout 1:1 Python rosbot_extension_panel: row 0 = config (paths + bot settings) | control panel, row 1 = ROSBOT log -->
  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="200"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" MinWidth="420"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0">
      <!-- Paths -->
      <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblPathSettings" Style="{StaticResource SectionHeaderTextStyle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LblRosbotPath" Grid.Row="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <TextBox x:Name="TxtRosDirectory" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"/>
            <Button x:Name="BtnBrowseRosbot" Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Margin="0,0,0,8" Click="BtnBrowseRosbot_Click"/>
            <TextBlock x:Name="LblBattlenetPath" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <TextBox x:Name="TxtBattlenetPath" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"/>
            <Button x:Name="BtnBrowseBattlenet" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Margin="0,0,0,8" Click="BtnBrowseBattlenet_Click"/>
            <TextBlock x:Name="LblD3Path" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0"/>
            <TextBox x:Name="TxtD3Path" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"/>
            <Button x:Name="BtnBrowseD3" Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Click="BtnBrowseD3_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Bot settings: 3x3, Python _create_bot_settings order -->
      <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblBotSettings" Style="{StaticResource SectionHeaderTextStyle}"/>
          <UniformGrid Columns="3">
            <CheckBox x:Name="ChkAutoEnableLatestRos" Margin="0,0,12,8"/>
            <CheckBox x:Name="ChkBluePortalPriority" Margin="0,0,12,8"/>
            <CheckBox x:Name="ChkFirstbornBlueGateReuse" Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkPickupBloodShards" Margin="0,0,12,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
              <CheckBox x:Name="ChkSmartEcho" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="TxtSmartEchoWaitSeconds" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="LblSeconds" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <CheckBox x:Name="ChkTestMode" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="TxtTestTimeoutMinutes" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="LblMinutes1" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="ChkPreventStuck" Margin="0,0,12,0"/>
            <CheckBox x:Name="ChkStartup" Margin="0,0,12,0"/>
            <DockPanel LastChildFill="False">
              <CheckBox x:Name="ChkTimeoutRestart" VerticalAlignment="Center" Margin="0,0,8,0">
                <CheckBox.Content>
                  <TextBlock x:Name="TxtTimeoutRestart" TextWrapping="Wrap" MaxWidth="180"/>
                </CheckBox.Content>
              </CheckBox>
              <TextBox x:Name="TxtTimeoutMinutes" Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="LblMinutes2" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
            </DockPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Control panel (Python control_frame) -->
    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock x:Name="LblControlPanel" Style="{StaticResource SectionHeaderTextStyle}"/>
        <Button x:Name="BtnStartRosbot" Style="{StaticResource SuccessButtonStyle}" HorizontalAlignment="Stretch" MinHeight="36" Margin="0,0,0,8" Click="BtnStartRosbot_Click"/>
        <Button x:Name="BtnEnsureBattlenet" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnEnsureBattlenet_Click"/>
        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,4,0,12"/>
        <Button x:Name="BtnUpdateRosbot" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnUpdateRosbot_Click"/>
        <Button x:Name="BtnOpenTampermonkey" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnOpenTampermonkey_Click"/>
        <Button x:Name="BtnSetAccountPassword" HorizontalAlignment="Stretch" Click="BtnSetAccountPassword_Click"/>
      </StackPanel>
    </Border>

    <!-- ROSBOT log (Python _create_log_display_row) -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LblRosbotLog" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <Border x:Name="ChipLogStatus" Grid.Column="2" Style="{StaticResource StatusChipStyle}" Margin="0,0,8,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtLogStatus" FontFamily="{StaticResource MonoFontFamily}"/>
          </Border>
          <Border x:Name="ChipLogLatency" Grid.Column="3" Style="{StaticResource StatusChipInfoStyle}" Margin="0,0,12,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtLogLatency" FontFamily="{StaticResource MonoFontFamily}"/>
          </Border>
          <CheckBox x:Name="ChkDebugLogLatency" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="BtnOpenLogFile" Grid.Column="5" Style="{StaticResource SubtleButtonStyle}" Click="BtnOpenLogFile_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8E5;" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtOpenLogFile" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
        <TextBox x:Name="TxtRosbotLog" Grid.Row="1" Style="{StaticResource MonoLogTextBoxStyle}" MinHeight="120">
          <TextBox.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="MiCopyLog" Click="MiCopyLog_Click"/>
            </ContextMenu>
          </TextBox.ContextMenu>
        </TextBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
