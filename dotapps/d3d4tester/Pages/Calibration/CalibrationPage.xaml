<UserControl x:Class="DotApps.d3d4tester.Pages.Calibration.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="CalButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="CalSuccessButton" TargetType="Button" BasedOn="{StaticResource SuccessButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="CalDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="CalAccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="CalRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="GroupName" Value="ClientType"/>
    </Style>
    <Style x:Key="CalStep" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CalGridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKey}" Value="exported">
          <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKey}" Value="labeled">
          <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPatch}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="200"/>
      <RowDefinition Height="Auto" MinHeight="120"/>
    </Grid.RowDefinitions>

    <!-- Client type + capture (Python _create_client_and_button_row) -->
    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="LblClientMode" DockPanel.Dock="Left" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0"/>
        <RadioButton x:Name="RadioBattlenet" DockPanel.Dock="Left" Style="{StaticResource CalRadio}"/>
        <RadioButton x:Name="RadioD3Game" DockPanel.Dock="Left" Style="{StaticResource CalRadio}"/>
        <RadioButton x:Name="RadioD4Game" DockPanel.Dock="Left" Style="{StaticResource CalRadio}"/>
        <Button x:Name="BtnCapture" DockPanel.Dock="Right" Style="{StaticResource CalAccentButton}" Margin="0"/>
      </DockPanel>
    </Border>

    <!-- YOLO data management (Python _create_yolo_section) -->
    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtYoloTitle" Grid.Row="0" Style="{StaticResource SectionHeaderTextStyle}"/>

        <WrapPanel Grid.Row="1">
          <Button x:Name="BtnYoloConfig" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloRecordToggle" Style="{StaticResource CalSuccessButton}"/>
          <Button x:Name="BtnYoloFlowOpenLabel" Style="{StaticResource CalButton}" Margin="16,0,8,8"/>
          <Button x:Name="BtnYoloImportPatch" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloCleanUnlabeled" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloTrain" Style="{StaticResource CalAccentButton}"/>
          <Button x:Name="BtnYoloTaskSets" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloModelTest" Style="{StaticResource CalButton}"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LblYoloProject" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}"/>
          <ComboBox x:Name="CboYoloProject" Grid.Column="1" MinWidth="160" Margin="0,0,8,0" DisplayMemberPath="Display" SelectedValuePath="Path"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="BtnYoloLoadProject" Style="{StaticResource CalButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnYoloCreateProject" Style="{StaticResource CalButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnYoloOpenProjectDir" Style="{StaticResource CalButton}" Margin="0"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource InsetBorderStyle}" Padding="8,4" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TxtWorkflowStep1" Style="{StaticResource CalStep}"/>
            <TextBlock x:Name="TxtWorkflowStep2" Style="{StaticResource CalStep}"/>
            <TextBlock x:Name="TxtWorkflowStep3" Style="{StaticResource CalStep}"/>
          </StackPanel>
        </Border>

        <DataGrid x:Name="DgYoloSegments" Grid.Row="4" MinHeight="120"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" RowStyle="{StaticResource CalGridRow}">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="ColTimestamp" Binding="{Binding Timestamp}" Width="*" MinWidth="180"/>
            <DataGridTextColumn x:Name="ColFrames" Binding="{Binding Frames}" Width="80"/>
            <DataGridTextColumn x:Name="ColStatus" Binding="{Binding Status}" Width="100"/>
            <DataGridTextColumn x:Name="ColSize" Binding="{Binding Size}" Width="90"/>
          </DataGrid.Columns>
          <DataGrid.ContextMenu>
            <ContextMenu x:Name="SegmentContextMenu">
              <MenuItem x:Name="MiSegmentOpenFolder"/>
              <MenuItem x:Name="MiSegmentExportFrames"/>
              <MenuItem x:Name="MiSegmentOpenLabel"/>
              <Separator/>
              <MenuItem x:Name="MiSegmentDelete"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>

        <WrapPanel Grid.Row="5" Margin="0,8,0,0">
          <Button x:Name="BtnYoloRefresh" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloExportSelected" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloOpenLabel" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloMerge" Style="{StaticResource CalButton}"/>
          <Button x:Name="BtnYoloDelete" Style="{StaticResource CalDangerButton}"/>
          <Button x:Name="BtnYoloImportPatchToolbar" Style="{StaticResource CalButton}"/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Record log (Python _create_record_log_panel) -->
    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
          <Button x:Name="BtnOpenRecordDir" DockPanel.Dock="Right" Style="{StaticResource CalButton}" Margin="0"/>
          <Button x:Name="BtnExportGameFrames" DockPanel.Dock="Right" Style="{StaticResource CalButton}" Margin="0,0,8,0"/>
          <TextBlock x:Name="TxtRecordLogTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="TxtRecordLog" Grid.Row="1" Height="140" Style="{StaticResource MonoLogTextBoxStyle}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
