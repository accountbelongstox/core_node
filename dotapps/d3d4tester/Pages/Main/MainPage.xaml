<UserControl x:Class="DotApps.d3d4tester.Pages.Main.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotApps.d3d4tester.ViewModels"
             xmlns:comp="clr-namespace:DotApps.d3d4tester.Components">
  <!-- Layout 1:1 Python main_functions_panel: left = config + skill table, right = auxiliary options, bottom = hotkeys + options -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource PageMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="420"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="2*" MinWidth="260"/>
      </Grid.ColumnDefinitions>

      <!-- Skill configuration card -->
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSkillConfigTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock x:Name="LblCurrentConfig" Style="{StaticResource FieldLabelTextStyle}"/>
              <Border Style="{StaticResource StatusChipSuccessStyle}">
                <TextBlock x:Name="TxtCurrentConfig"/>
              </Border>
            </StackPanel>
            <ComboBox x:Name="CboConfig" Grid.Column="3" MinWidth="140" VerticalAlignment="Center"/>
          </Grid>

          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112"/>
              <ColumnDefinition Width="*" MinWidth="96"/>
              <ColumnDefinition Width="*" MinWidth="120"/>
              <ColumnDefinition Width="76"/>
              <ColumnDefinition Width="76"/>
              <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSkill" Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="LblKey" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="LblStrategy" Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="LblInterval" Grid.Column="3" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="LblDelay" Grid.Column="4" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="LblRandom" Grid.Column="5" Style="{StaticResource CaptionTextStyle}"/>
          </Grid>
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>

          <ItemsControl x:Name="SkillRowsItemsControl" ItemsSource="{Binding SkillRows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SkillRowViewModel}">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*" MinWidth="96"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="76"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <comp:HotkeyInputBox Grid.Column="1" Hotkey="{Binding Key, Mode=TwoWay}" Margin="0,0,8,0"
                                       Visibility="{Binding IsKeyEditable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                  <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left" Margin="0,0,8,0"
                          Visibility="{Binding IsKeyEditable, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding KeyLabel}"/>
                  </Border>
                  <ComboBox Grid.Column="2" SelectedIndex="{Binding StrategyIndex, Mode=TwoWay}" Margin="0,0,8,0"
                            ItemsSource="{Binding Source={x:Static vm:SkillRowViewModel.StrategyDisplayNames}}"/>
                  <TextBox Grid.Column="3" Text="{Binding Interval, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" Margin="0,0,8,0"/>
                  <TextBox Grid.Column="4" Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" Margin="0,0,8,0"/>
                  <TextBox Grid.Column="5" Text="{Binding RandomDelay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Auxiliary options card (bag offset + automation) -->
      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <comp:AuxiliaryOptionsBlock x:Name="AuxOptions"/>
      </Border>

      <!-- Bottom bar: hotkeys + options (Python _create_bottom_bar_in_frame) -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}">
        <StackPanel>
          <TextBlock x:Name="LblHotkeysTitle" Style="{StaticResource SectionHeaderTextStyle}"/>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblMacroStartHotkey" Grid.Row="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <comp:HotkeyInputBox x:Name="TxtMacroStartHotkey" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="LblAssistantHotkey" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <comp:HotkeyInputBox x:Name="TxtAssistantHotkey" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="LblQuickSwitch" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
            <comp:HotkeyInputBox x:Name="TxtQuickSwitch" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
            <Button x:Name="BtnCombatMacroToggle" Grid.Row="0" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CombatMacroToggleCommand}"/>
          </Grid>
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,4,0,12"/>
          <WrapPanel>
            <CheckBox x:Name="ChkPlaySoundOnSwitch" Margin="0,0,24,8" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkSmartPauseBar" Margin="0,0,24,8" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <CheckBox x:Name="ChkCustomStand" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="TxtCustomStandKey" Width="80" VerticalAlignment="Center"/>
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
