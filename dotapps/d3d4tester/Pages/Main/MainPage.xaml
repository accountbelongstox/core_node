<UserControl x:Class="DotApps.d3d4tester.Pages.Main.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotApps.d3d4tester.ViewModels"
             xmlns:comp="clr-namespace:DotApps.d3d4tester.Components">
  <!-- Compact, no scrolling: left = skill table + hotkeys/options, right = auxiliary options (Python main_functions_panel content) -->
  <UserControl.Resources>
    <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="CompactHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="8,6,8,4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" MinWidth="380"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="2*" MinWidth="250"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Skill configuration card -->
      <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}">
        <StackPanel>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSkillConfigTitle" Style="{StaticResource CompactHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock x:Name="LblCurrentConfig" Style="{StaticResource FieldLabelTextStyle}"/>
              <Border Style="{StaticResource StatusChipSuccessStyle}">
                <TextBlock x:Name="TxtCurrentConfig"/>
              </Border>
            </StackPanel>
            <ComboBox x:Name="CboConfig" Grid.Column="3" MinWidth="110" VerticalAlignment="Center"/>
          </Grid>

          <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72"/>
              <ColumnDefinition Width="*" MinWidth="64"/>
              <ColumnDefinition Width="*" MinWidth="88"/>
              <ColumnDefinition Width="54"/>
              <ColumnDefinition Width="54"/>
              <ColumnDefinition Width="54"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSkill" Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblKey" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblStrategy" Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblInterval" Grid.Column="3" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblDelay" Grid.Column="4" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblRandom" Grid.Column="5" Style="{StaticResource CaptionTextStyle}"/>
          </Grid>
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,2"/>

          <ItemsControl x:Name="SkillRowsItemsControl" ItemsSource="{Binding SkillRows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SkillRowViewModel}">
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*" MinWidth="64"/>
                    <ColumnDefinition Width="*" MinWidth="88"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="54"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"/>
                  <comp:HotkeyInputBox Grid.Column="1" Hotkey="{Binding Key, Mode=TwoWay}" Margin="0,0,6,0"
                                       Visibility="{Binding IsKeyEditable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                  <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left" Margin="0,0,6,0"
                          Visibility="{Binding IsKeyEditable, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding KeyLabel}"/>
                  </Border>
                  <!-- ItemsSource must precede SelectedIndex: WPF applies attributes in order and an index set on an empty list is lost -->
                  <ComboBox Grid.Column="2" ItemsSource="{Binding Source={x:Static vm:SkillRowViewModel.StrategyDisplayNames}}"
                            SelectedIndex="{Binding StrategyIndex, Mode=TwoWay}" Margin="0,0,6,0"/>
                  <TextBox Grid.Column="3" Text="{Binding Interval, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" Margin="0,0,6,0"/>
                  <TextBox Grid.Column="4" Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" Margin="0,0,6,0"/>
                  <TextBox Grid.Column="5" Text="{Binding RandomDelay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Hotkeys + options (Python _create_bottom_bar_in_frame), one compact row each -->
      <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}">
        <StackPanel>
          <TextBlock x:Name="LblHotkeysTitle" Style="{StaticResource CompactHeaderStyle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblMacroStartHotkey" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <comp:HotkeyInputBox x:Name="TxtMacroStartHotkey" Grid.Column="1" Margin="0,0,10,0"/>
            <TextBlock x:Name="LblAssistantHotkey" Grid.Column="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <comp:HotkeyInputBox x:Name="TxtAssistantHotkey" Grid.Column="3" Margin="0,0,10,0"/>
            <TextBlock x:Name="LblQuickSwitch" Grid.Column="4" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <comp:HotkeyInputBox x:Name="TxtQuickSwitch" Grid.Column="5" Margin="0,0,10,0"/>
            <Button x:Name="BtnCombatMacroToggle" Grid.Column="6" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CombatMacroToggleCommand}"/>
          </Grid>
          <WrapPanel Margin="0,6,0,0">
            <CheckBox x:Name="ChkPlaySoundOnSwitch" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkSmartPauseBar" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ChkCustomStand" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="TxtCustomStandKey" Width="64" VerticalAlignment="Center"/>
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Auxiliary options card (bag offset + automation) -->
    <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}" VerticalAlignment="Top">
      <comp:AuxiliaryOptionsBlock x:Name="AuxOptions"/>
    </Border>
  </Grid>
</UserControl>
