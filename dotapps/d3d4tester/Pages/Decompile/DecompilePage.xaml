<UserControl x:Class="DotApps.d3d4tester.Pages.Decompile.DecompilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:DotApps.d3d4tester.Components">
  <!-- Test tab, no scrolling: sub-tabs for the CoreNodeBridge ROSBOT plugin (live game state), the decompile tools (ILSpy, de4dot-cex,
       autoit-ripper, UPX; one-click ROSBOT / RBAssist / any file, output folder) and the log (selected while an operation runs) -->
  <UserControl.Resources>
    <ResourceDictionary Source="/d3d4tester;component/Assets/Styles/CompactPage.xaml"/>
  </UserControl.Resources>
  <TabControl x:Name="TabsDecompile" Margin="8,4,8,4">
    <TabItem x:Name="TabBridge">
      <components:RosbotBridgePanel x:Name="BridgePanel" Margin="4,8,4,4"/>
    </TabItem>

    <TabItem x:Name="TabTools">
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock x:Name="TxtToolsDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtToolsStatus" Style="{StaticResource MonoTextStyle}" Margin="0,0,0,4"/>
            <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="BtnInstall_Click"/>
            <TextBlock x:Name="TxtChainDesc" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnChain" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnChain_Click"/>
              <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtChainStatus" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock x:Name="LblRosbotTitle" Style="{StaticResource CompactHeaderStyle}"/>
              <TextBlock x:Name="TxtRosbotDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
              <TextBlock x:Name="TxtRosbotDir" Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
              <WrapPanel>
                <Button x:Name="BtnRosbot" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnRosbot_Click"/>
                <Button x:Name="BtnRecoverSources" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRecoverSources_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock x:Name="LblRbAssistTitle" Style="{StaticResource CompactHeaderStyle}"/>
              <TextBlock x:Name="TxtRbAssistDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRbAssistPath" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnBrowseRbAssist" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnBrowseRbAssist_Click"/>
                <Button x:Name="BtnRbAssist" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRbAssist_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CompactCardStyle}">
            <StackPanel>
              <TextBlock x:Name="LblFileTitle" Style="{StaticResource CompactHeaderStyle}"/>
              <TextBlock x:Name="TxtFileDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <WrapPanel>
                <Button x:Name="BtnFile" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnFile_Click"/>
                <Button x:Name="BtnExportIl" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnExportIl_Click"/>
                <Button x:Name="BtnOpenOutput" Style="{StaticResource SubtleButtonStyle}" Click="BtnOpenOutput_Click"/>
              </WrapPanel>
              <TextBlock x:Name="TxtOutputDir" Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </TabItem>

    <TabItem x:Name="TabLog">
      <TextBox x:Name="TxtLog" Margin="0,6,0,0" Style="{StaticResource MonoLogTextBoxStyle}" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </TabItem>
  </TabControl>
</UserControl>
