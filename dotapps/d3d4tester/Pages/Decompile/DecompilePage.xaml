<UserControl x:Class="DotApps.d3d4tester.Pages.Decompile.DecompilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Decompile tools: toolchain install (ILSpy, de4dot-cex, autoit-ripper, UPX), one-click ROSBOT / RBAssist / any file, output folder, log -->
  <Grid Margin="8,6,8,4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock x:Name="LblToolsTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtToolsDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtToolsStatus" Style="{StaticResource MonoTextStyle}" Margin="0,0,0,6"/>
            <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="BtnInstall_Click"/>
            <TextBlock x:Name="TxtChainDesc" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,6"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnChain" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnChain_Click"/>
              <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtChainStatus" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock x:Name="LblRosbotTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtRosbotDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtRosbotDir" Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
            <Button x:Name="BtnRosbot" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="BtnRosbot_Click"/>
            <Button x:Name="BtnRecoverSources" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="BtnRecoverSources_Click"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock x:Name="LblRbAssistTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtRbAssistDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtRbAssistPath" Margin="0,0,6,0"/>
              <Button x:Name="BtnBrowseRbAssist" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseRbAssist_Click"/>
            </Grid>
            <Button x:Name="BtnRbAssist" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="BtnRbAssist_Click"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Padding="10,8">
          <StackPanel>
            <TextBlock x:Name="LblFileTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtFileDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnFile" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnFile_Click"/>
              <Button x:Name="BtnExportIl" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnExportIl_Click"/>
              <Button x:Name="BtnOpenOutput" Style="{StaticResource SubtleButtonStyle}" Click="BtnOpenOutput_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtOutputDir" Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblLog" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtLog" Grid.Row="1" Style="{StaticResource MonoLogTextBoxStyle}" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
