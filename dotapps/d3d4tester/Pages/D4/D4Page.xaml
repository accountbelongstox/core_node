<UserControl x:Class="DotApps.d3d4tester.Pages.D4.D4Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotApps.d3d4tester.ViewModels"
             xmlns:theme="clr-namespace:DotCore.UITheme;assembly=DotCore.UITheme">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Status value chip: semantic tone from the tile (shared chip style + semantic brushes) -->
    <Style x:Key="D4ToneChipStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Plain">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Success">
          <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Danger">
          <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Info">
          <Setter Property="Background" Value="{DynamicResource InfoSubtleBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Plain status value: shown only for the Plain tone -->
    <Style x:Key="D4PlainValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Plain">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="D4StatusTileTemplate" DataType="{x:Type vm:D4StatusTileViewModel}">
      <Border Style="{StaticResource CardSecondaryBorderStyle}" Padding="10,8" Margin="0,0,8,8" ToolTip="{Binding Value}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Glyph}"
                       FontSize="{StaticResource FontSizeIconSmall}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Label}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Style="{StaticResource D4PlainValueTextStyle}" Text="{Binding Value}"/>
          <Border Style="{StaticResource D4ToneChipStyle}">
            <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Start/Stop: Success when stopped, Warning when running (1:1 Python green/red toggle) -->
    <Style x:Key="D4StartStopButtonStyle" TargetType="Button" BasedOn="{StaticResource SuccessButtonStyle}">
      <Setter Property="MinWidth" Value="168"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpFarmingRunning}" Value="True">
          <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
          <Setter Property="theme:ControlAssist.HoverBackground" Value="{DynamicResource WarningHoverBrush}"/>
          <Setter Property="theme:ControlAssist.PressedBackground" Value="{DynamicResource WarningPressedBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Running chip in the toolbar -->
    <Style x:Key="D4RunningChipStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpFarmingRunning}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Selected sub-tab item (accent bar + selected fill) -->
    <Style x:Key="D4NavItemSelectedStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SubtleFillSelectedBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PageMargin}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: sub-tab navigation (1:1 Python _create_subtab_navigation) -->
    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Width="168" Margin="0,0,12,0" VerticalAlignment="Stretch">
      <StackPanel>
        <TextBlock x:Name="LblD4Title" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8"/>
        <Border Style="{StaticResource D4NavItemSelectedStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Style="{StaticResource IconTextStyle}" Text="&#xE7FC;" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="LblNavExpFarming" Grid.Column="2" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- Right: EXP Farming content (1:1 Python _create_exp_farming_content) -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock x:Name="LblExpFarmingTitle" Style="{StaticResource SubtitleTextStyle}"/>
        <TextBlock x:Name="LblExpFarmingSubtitle" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Toolbar: start/stop, debug images, running chip -->
      <Border Grid.Row="1" Style="{StaticResource ToolbarPanelStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnExpFarmingStartStop" Grid.Column="0" Style="{StaticResource D4StartStopButtonStyle}" Margin="0,0,8,0"
                  Command="{Binding ToggleExpFarmingCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="IconStartStop" Style="{StaticResource IconTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StartStopText}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnExpFarmingDebug" Style="{StaticResource SecondaryButtonStyle}" Click="BtnExpFarmingDebug_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xEB9F;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDebugButton" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnStartD4" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnStartD4_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE768;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStartD4" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="96" Height="4" Margin="16,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
          <Border Grid.Column="3" Style="{StaticResource D4RunningChipStyle}">
            <TextBlock Text="{Binding Tiles[0].Value}"/>
          </Border>
        </Grid>
      </Border>

      <!-- Game status grid (Python _create_game_status_area) -->
      <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}" Padding="12,12,4,4">
        <StackPanel>
          <Grid Margin="0,0,8,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblGameStatusTitle" Style="{StaticResource SectionHeaderTextStyle}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding UpdatedAtText}" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource D4StatusTileTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Log (Python exp_farming_log) -->
      <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblLogTitle" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
            <Button x:Name="BtnClearLog" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Click="BtnClearLog_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtClearLog" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBox x:Name="TxtExpFarmingLog" Grid.Row="1" Style="{StaticResource MonoLogTextBoxStyle}" MinHeight="120"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
