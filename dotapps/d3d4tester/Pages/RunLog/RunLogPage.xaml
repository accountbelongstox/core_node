<UserControl x:Class="DotApps.d3d4tester.Pages.RunLog.RunLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Row 0: test functions (1:1 Python log_panel _create_test_panel: 8 buttons per row, auto-wrap) -->
    <GroupBox x:Name="GrpTestFunctions" Grid.Row="0" Header="Test Functions" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelBorderBrush}" Margin="0,0,0,8">
      <UniformGrid x:Name="TestButtonsGrid" Columns="8" Margin="2"/>
    </GroupBox>

    <!-- Row 1: control panel (1:1 Python _create_control_panel) -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnClearLogs" Grid.Column="0" Content="Clear" Padding="10,2" Margin="0,0,4,0" Click="BtnClearLogs_Click"/>
      <Button x:Name="BtnSaveLogs" Grid.Column="1" Content="Save" Padding="10,2" Margin="0,0,8,0" Click="BtnSaveLogs_Click"/>
      <CheckBox x:Name="ChkShowDebugLogs" Grid.Column="2" Content="Show DEBUG logs" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Checked="ChkShowDebugLogs_Changed" Unchecked="ChkShowDebugLogs_Changed"/>
      <CheckBox x:Name="ChkAutoScroll" Grid.Column="3" Content="Auto scroll" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextPrimaryBrush}" Checked="ChkAutoScroll_Changed" Unchecked="ChkAutoScroll_Changed"/>
      <ComboBox x:Name="CmbLogLevel" Grid.Column="4" Width="96" Margin="12,0,8,0" SelectionChanged="CmbLogLevel_SelectionChanged"/>
      <Button x:Name="BtnScanLogArea" Grid.Column="5" Content="Scan" Padding="10,2" Click="BtnScanLogArea_Click"/>
    </Grid>

    <!-- Row 2: log output (1:1 Python _create_log_display) -->
    <GroupBox x:Name="GrpLogOutput" Grid.Row="2" Header="Log Output" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelBorderBrush}">
      <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
               Background="{StaticResource BackgroundDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Margin="4"/>
    </GroupBox>
  </Grid>
</UserControl>
