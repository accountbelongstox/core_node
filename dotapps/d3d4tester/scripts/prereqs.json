{
  "app": "d3d4tester",
  "prereqs": [
    {
      "id": "dotnet-sdk-8",
      "required": true,
      "purpose": "Build and hot-reload the WPF app",
      "linux": { "installer": "scripts/shells/linux/debian/install_shells/57_install_dotnet.sh", "env": { "START_DOTNET": "true", "INSTALL_MODE": "full" }, "detect": { "dotnet_sdk_major": 8 } },
      "windows": { "installer": "scripts/shells/win/install_powershells/Step71_InstallDotnet.ps1" }
    },
    {
      "id": "vcredist-x64",
      "required": true,
      "purpose": "Native runtime for OpenCvSharp4 and PaddleOCRSharp",
      "windows": { "installer": "scripts/shells/win/install_powershells/Step71_InstallDotnet.ps1" }
    },
    {
      "id": "browser",
      "required": false,
      "purpose": "Battle.net OAuth login page and the Tampermonkey userscript",
      "linux": { "installer": "scripts/shells/linux/debian/install_shells/41_install_browsers.sh", "args": ["--only", "chrome"], "env": { "INSTALL_CHROME": "true" }, "detect": { "commands": ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "firefox"] } },
      "windows": { "installer": "scripts/shells/win/install_powershells/Step22_InstallChrome.ps1" }
    },
    {
      "id": "python-ultralytics",
      "required": false,
      "purpose": "YOLO training launched from the Calibration tab (yolo CLI)",
      "linux": { "installer": "scripts/shells/linux/debian/install_shells/15_install_default_python_prereq_packages.sh", "pip": ["ultralytics"], "detect": { "python_imports": ["ultralytics"] } },
      "windows": { "installer": "scripts/shells/win/install_powershells/Step8_InstallDefaultPython.ps1", "pip": ["ultralytics"] }
    }
  ],
  "manual": [
    {
      "id": "battlenet",
      "platform": "windows",
      "detect": ["Battle.net\\Battle.net.exe", "Battle.net\\Battle.net Launcher.exe"],
      "steps": ["Download and install the Battle.net client from https://download.battle.net", "Sign in once, then set the path on the Rosbot tab or use Scan"]
    },
    {
      "id": "diablo3",
      "platform": "windows",
      "detect": ["Diablo III\\Diablo III64.exe", "Diablo III\\Diablo III.exe"],
      "steps": ["Install Diablo III from the Battle.net client (Games > Diablo III > Install)"]
    },
    {
      "id": "diablo4",
      "platform": "windows",
      "detect": ["Diablo IV\\Diablo IV.exe"],
      "steps": ["Install Diablo IV from the Battle.net client (Games > Diablo IV > Install)"]
    },
    {
      "id": "rosbot",
      "platform": "windows",
      "detect": [],
      "steps": ["Download ROS-BOT from the vendor site with your license", "Unzip it, then set the ROSBOT directory on the Rosbot tab or use Scan"]
    },
    {
      "id": "tampermonkey-userscript",
      "platform": "windows",
      "detect": [],
      "steps": ["Install the Tampermonkey extension in your browser", "Rosbot tab > Open Tampermonkey script, then install pyapps/d3-check/scripts/d3check_oauth_login_tampermonkey.user.js"]
    },
    {
      "id": "segoe-fluent-icons",
      "platform": "windows10",
      "detect": ["Fonts\\SegoeIcons.ttf"],
      "steps": ["Windows 10 only: download Segoe Fluent Icons from https://aka.ms/SegoeFluentIcons and install SegoeIcons.ttf (Windows 11 has it built in)"]
    }
  ]
}
