<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DotApps.d3d4tester</RootNamespace>
    <AssemblyName>d3d4tester</AssemblyName>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="D3D4TesterCore\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="I18n\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Templates\**\*" Exclude="Templates\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\app_icon.ico" />
    <EmbeddedResource Include="Config\default_config.json" LogicalName="d3d4tester.default_config.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <ProjectReference Include="tools\decompile\dnguard-static\compatibility\RosbotRecovery.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="tools\decompile\dnguard-dynamic\collector\DnGuardDynamicCollector.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="tools\rosbot-plugin\CoreNodeBridge\CoreNodeBridge.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <ProjectReference Include="..\..\dotcore\DotCore.Foundations\DotCore.Foundations.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.Common\DotCore.Common.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.Utils\DotCore.Utils.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.UITheme\DotCore.UITheme.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.Infrastructure\DotCore.Infrastructure.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.ScreenCapture\DotCore.ScreenCapture.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.YoloRecord\DotCore.YoloRecord.csproj" />
    <ProjectReference Include="D3D4TesterCore\D3D4TesterCore.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.VocAnnotator\DotCore.VocAnnotator.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.VocAnnotatorUI\DotCore.VocAnnotatorUI.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.YoloTrain\DotCore.YoloTrain.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.YoloTaskSet\DotCore.YoloTaskSet.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.UIInspect\DotCore.UIInspect.csproj" />
    <ProjectReference Include="..\..\dotcore\DotCore.Decompile\DotCore.Decompile.csproj" />
  </ItemGroup>
  <Target Name="CopyRecoveryTool" AfterTargets="Build">
    <MSBuild Projects="tools\decompile\dnguard-static\compatibility\RosbotRecovery.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RecoveryToolTarget" />
    </MSBuild>
    <MSBuild Projects="tools\decompile\dnguard-dynamic\collector\DnGuardDynamicCollector.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=x64">
      <Output TaskParameter="TargetOutputs" ItemName="DynamicCollectorTarget" />
    </MSBuild>
    <MSBuild Projects="tools\rosbot-plugin\CoreNodeBridge\CoreNodeBridge.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RosbotBridgePluginTarget" />
    </MSBuild>
    <Copy SourceFiles="@(RosbotBridgePluginTarget)" DestinationFolder="$(TargetDir)tools\rosbot-plugins\CoreNodeBridge" SkipUnchangedFiles="true"
          Condition="Exists('@(RosbotBridgePluginTarget)')" />
    <PropertyGroup>
      <RecoveryToolDirectory>@(RecoveryToolTarget->'%(RootDir)%(Directory)')</RecoveryToolDirectory>
      <DynamicCollectorDirectory>@(DynamicCollectorTarget->'%(RootDir)%(Directory)')</DynamicCollectorDirectory>
    </PropertyGroup>
    <ItemGroup>
      <RecoveryToolFiles Include="$(RecoveryToolDirectory)*.dll;$(RecoveryToolDirectory)*.json" />
      <DynamicCollectorFiles Include="$(DynamicCollectorDirectory)*.exe;$(DynamicCollectorDirectory)*.dll;$(DynamicCollectorDirectory)*.config;$(DynamicCollectorDirectory)*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(RecoveryToolFiles)" DestinationFolder="$(TargetDir)tools\compatibility" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DynamicCollectorFiles)" DestinationFolder="$(TargetDir)tools\dynamic" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBundledToolsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <BundledToolFiles Include="$(TargetDir)tools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledToolFiles)" DestinationFiles="@(BundledToolFiles->'$(PublishDir)tools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
