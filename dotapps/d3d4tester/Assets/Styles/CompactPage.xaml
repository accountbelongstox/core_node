<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Compact page density (merged into a page's resources): tighter cards and inputs so a tab fits 800x600 without scrolling -->
  <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
    <Setter Property="Padding" Value="10,8"/>
  </Style>
  <Style x:Key="CompactHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="4,2"/>
  </Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
    <Setter Property="Padding" Value="4,2"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Padding" Value="6,2,24,2"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="10,3"/>
  </Style>
</ResourceDictionary>
