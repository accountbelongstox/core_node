<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Fluent 2 motion for app content: durations and reusable entrance styles. Control-level motion lives in DotCore.UITheme AppStyles. -->
  <Duration x:Key="FluentMotionShort">0:0:0.083</Duration>
  <Duration x:Key="FluentMotionNormal">0:0:0.167</Duration>
  <Duration x:Key="FluentMotionLong">0:0:0.25</Duration>
  <CubicEase x:Key="FluentMotionEaseOut" EasingMode="EaseOut"/>

  <!-- Fade in when shown -->
  <Style x:Key="FluentContentFade" TargetType="ContentControl">
    <Style.Triggers>
      <Trigger Property="IsVisible" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource FluentMotionNormal}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Fade + slide up when shown (cards, panels); apply to any FrameworkElement via Style -->
  <Style x:Key="FluentEntranceStyle" TargetType="FrameworkElement">
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TranslateTransform/>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsVisible" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource FluentMotionNormal}"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0"
                               Duration="{StaticResource FluentMotionLong}" EasingFunction="{StaticResource FluentMotionEaseOut}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
