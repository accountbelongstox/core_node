<Window x:Class="DotApps.d3d4tester.Windows.AnnotatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="700" MinWidth="760" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource DialogWindowStyle}">
  <Grid Margin="12,0,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar: images dir, save dir, save -->
    <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnOpenDir" Grid.Column="0" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,4,0" Click="BtnOpenDir_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8B7;" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtOpenDir" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnSetSaveDir" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" Click="BtnSetSaveDir_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE792;" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtSetSaveDir" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="TxtSaveDir" Grid.Column="2" Style="{StaticResource MutedTextStyle}" FontFamily="{StaticResource MonoFontFamily}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Text=""/>
        <Button x:Name="BtnSave" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="BtnSave_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE74E;" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtSave" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="200"/>
      </Grid.ColumnDefinitions>

      <!-- Images (list scrolls inside its card) -->
      <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="LblImages" Style="{StaticResource SectionHeaderTextStyle}"/>
          <ListBox x:Name="LstImages" Grid.Row="1" SelectionChanged="LstImages_SelectionChanged"/>
        </Grid>
      </Border>

      <!-- Image canvas -->
      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
        <Border Style="{StaticResource InsetBorderStyle}" Padding="0">
          <ScrollViewer x:Name="ScrollCanvas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="CanvasImage" Background="Transparent" ClipToBounds="True">
              <Image x:Name="ImgDisplay"
                     MouseDown="CanvasImage_MouseDown"
                     MouseMove="CanvasImage_MouseMove"
                     MouseUp="CanvasImage_MouseUp"/>
            </Canvas>
          </ScrollViewer>
        </Border>
      </Border>

      <!-- Classes -->
      <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="LblClasses" Style="{StaticResource SectionHeaderTextStyle}"/>
          <ListBox x:Name="LstClasses" Grid.Row="1" SelectionChanged="LstClasses_SelectionChanged"/>
          <TextBlock x:Name="LblCurrentClass" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,12,0,4"/>
          <TextBox x:Name="TxtCurrentClass" Grid.Row="3" Text="object" Margin="{StaticResource FieldMargin}"/>
          <Button x:Name="BtnAddRect" Grid.Row="4" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False" Click="BtnAddRect_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
