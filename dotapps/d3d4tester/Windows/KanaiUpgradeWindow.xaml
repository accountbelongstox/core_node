<Window x:Class="DotApps.d3d4tester.Windows.KanaiUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1240" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Style="{StaticResource DialogWindowStyle}">
  <!-- Kanai's Cube rare -> legendary hunt: targets of the selected gear set (left) | run, bag hints, history (right) -->
  <Grid Margin="12,4,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <Border x:Name="ChipState" DockPanel.Dock="Right" Style="{StaticResource StatusChipInfoStyle}" VerticalAlignment="Center">
        <TextBlock x:Name="TxtState"/>
      </Border>
      <StackPanel>
        <TextBlock x:Name="TxtHeader" Style="{StaticResource SubtitleTextStyle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="TxtHowTo" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,12,0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="6*"/>
      </Grid.ColumnDefinitions>

      <!-- Targets: planned items with type, chance per transmute, minimum rank; required affixes of the selected row -->
      <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="90"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,6">
            <Button x:Name="BtnClearTargets" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Click="BtnClearTargets_Click"/>
            <TextBlock x:Name="LblTargets" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
          </DockPanel>
          <ListView x:Name="LstTargets" Grid.Row="1" SelectionChanged="LstTargets_SelectionChanged" ButtonBase.Click="Choice_Changed">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                <Setter Property="ToolTip" Value="{Binding Detail}"/>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="ColWanted" Width="34">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Wanted, Mode=TwoWay}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="ColItem" Width="210">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Height="30" MaxWidth="30" Stretch="Uniform" Margin="0,0,6,0"/>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Slot}" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="ColType" Width="86" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn x:Name="ColChance" Width="76" DisplayMemberBinding="{Binding Chance}"/>
                <GridViewColumn x:Name="ColRank" Width="96">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding RankNames}" SelectedIndex="{Binding RankIndex, Mode=TwoWay}" MinWidth="80" SelectionChanged="Rank_Changed"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="ColStatCount" Width="60" DisplayMemberBinding="{Binding StatSummary}"/>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock x:Name="LblStats" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" Margin="0,8,0,4"/>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="170">
            <ItemsControl x:Name="LstStats" ButtonBase.Click="Choice_Changed">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Required, Mode=TwoWay}" ToolTip="{Binding Code}" Margin="0,2,14,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <TabControl x:Name="Tabs" Grid.Column="2">
        <!-- Run: options, materials and the cost / affordability calculation, controls, live log -->
        <TabItem x:Name="TabRun">
          <Grid Margin="4,6,4,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardSecondaryBorderStyle}" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblStop" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="CmbStop" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="Option_Changed"/>
                <TextBlock x:Name="LblCheck" Grid.Column="3" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="CmbCheck" Grid.Column="4" Margin="0,0,0,6" SelectionChanged="Option_Changed"/>
                <CheckBox x:Name="ChkCompatible" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,6" Click="Option_Changed"/>
                <CheckBox x:Name="ChkOcr" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,0,6" Click="Option_Changed"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                  <TextBlock x:Name="LblMax" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox x:Name="TxtMax" Width="70" LostFocus="Option_Changed"/>
                </StackPanel>
                <CheckBox x:Name="ChkArmed" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Click="Option_Changed"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CardSecondaryBorderStyle}" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock x:Name="LblMaterials" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4"/>
                <UniformGrid Columns="4" Margin="0,0,0,6">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="LblDeathsBreath" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox x:Name="TxtDeathsBreath" LostFocus="Stock_Changed"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="LblReusableParts" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox x:Name="TxtReusableParts" LostFocus="Stock_Changed"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="LblArcaneDust" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox x:Name="TxtArcaneDust" LostFocus="Stock_Changed"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock x:Name="LblVeiledCrystal" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox x:Name="TxtVeiledCrystal" LostFocus="Stock_Changed"/>
                  </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="TxtPlan" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,0,0,8">
              <Button x:Name="BtnStart" DockPanel.Dock="Left" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="0,0,8,0" Click="BtnStart_Click"/>
              <Button x:Name="BtnStop" DockPanel.Dock="Left" Style="{StaticResource DangerButtonStyle}" MinWidth="80" Margin="0,0,8,0" Click="BtnStop_Click"/>
              <Button x:Name="BtnScan" DockPanel.Dock="Left" MinWidth="96" Margin="0,0,8,0" Click="BtnScan_Click"/>
              <TextBlock x:Name="TxtRunStatus" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <ListView x:Name="LstLog" Grid.Row="3">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Detail}"/>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="ColLogTime" Width="66" DisplayMemberBinding="{Binding Time}"/>
                  <GridViewColumn Width="30" DisplayMemberBinding="{Binding Mark}"/>
                  <GridViewColumn x:Name="ColLogKind" Width="90" DisplayMemberBinding="{Binding Kind}"/>
                  <GridViewColumn x:Name="ColLogDetail" Width="440" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </TabItem>

        <!-- Bag hints: rares that can become a target, legendaries that look like one (one capture, no OCR) -->
        <TabItem x:Name="TabHints">
          <DockPanel Margin="4,6,4,4">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button x:Name="BtnScanHints" DockPanel.Dock="Left" Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Margin="0,0,8,0" Click="BtnScan_Click"/>
              <TextBlock x:Name="TxtScanSummary" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <ListView x:Name="LstHints">
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="ColHintCell" Width="60" DisplayMemberBinding="{Binding Cell}"/>
                  <GridViewColumn x:Name="ColHintKind" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                  <GridViewColumn x:Name="ColHintItem" Width="200" DisplayMemberBinding="{Binding Item}"/>
                  <GridViewColumn x:Name="ColHintScore" Width="56" DisplayMemberBinding="{Binding Score}"/>
                  <GridViewColumn x:Name="ColHintTarget" Width="260" DisplayMemberBinding="{Binding Target}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- History: totals, runs (newest first), products of the selected run -->
        <TabItem x:Name="TabHistory">
          <Grid Margin="4,6,4,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="3*"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="BtnClearHistory" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Click="BtnClearHistory_Click"/>
              <TextBlock x:Name="TxtTotals" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <ListView x:Name="LstHistory" Grid.Row="1" SelectionChanged="LstHistory_SelectionChanged">
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="ColRunTime" Width="120" DisplayMemberBinding="{Binding Time}"/>
                  <GridViewColumn x:Name="ColRunBuild" Width="150" DisplayMemberBinding="{Binding Build}"/>
                  <GridViewColumn x:Name="ColRunTransmutes" Width="56" DisplayMemberBinding="{Binding Transmutes}"/>
                  <GridViewColumn x:Name="ColRunProducts" Width="56" DisplayMemberBinding="{Binding Products}"/>
                  <GridViewColumn x:Name="ColRunTargets" Width="56" DisplayMemberBinding="{Binding Targets}"/>
                  <GridViewColumn x:Name="ColRunOutcome" Width="110" DisplayMemberBinding="{Binding Outcome}"/>
                  <GridViewColumn x:Name="ColRunDuration" Width="60" DisplayMemberBinding="{Binding Duration}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <ListView x:Name="LstProducts" Grid.Row="3">
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="ColProdCell" Width="60" DisplayMemberBinding="{Binding Cell}"/>
                  <GridViewColumn x:Name="ColProdItem" Width="200" DisplayMemberBinding="{Binding Item}"/>
                  <GridViewColumn x:Name="ColProdSource" Width="80" DisplayMemberBinding="{Binding Source}"/>
                  <GridViewColumn x:Name="ColProdTarget" Width="60" DisplayMemberBinding="{Binding Target}"/>
                  <GridViewColumn x:Name="ColProdDetail" Width="300" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
