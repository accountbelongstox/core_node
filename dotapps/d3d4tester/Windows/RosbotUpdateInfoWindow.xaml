<Window x:Class="DotApps.d3d4tester.Windows.RosbotUpdateInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" MinWidth="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
  <Grid Margin="20,4,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: state icon + heading -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}"
              Background="{DynamicResource InfoSubtleBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
        <TextBlock x:Name="IconGlyph" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource InfoTextBrush}" Text="&#xE896;"/>
      </Border>
      <TextBlock x:Name="TxtHeading" Grid.Column="1" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>

    <!-- Update available: message card -->
    <Border x:Name="UpdateCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Visibility="Collapsed">
      <TextBlock x:Name="TxtUpdateMessage" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
    </Border>

    <!-- No update: detection card + usage card (scrolls inside) -->
    <Grid x:Name="NoUpdatePanel" Grid.Row="1" Margin="0,0,0,16" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="DetectionCard" Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="TxtDetectionTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8"/>
          <StackPanel x:Name="DetectionLines"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="TxtUsageTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8"/>
          <Border Grid.Row="1" Style="{StaticResource InsetBorderStyle}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="TxtUsage" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnConfirm" MinWidth="112" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="BtnConfirm_Click"/>
      <Button x:Name="BtnCancel" MinWidth="96" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
