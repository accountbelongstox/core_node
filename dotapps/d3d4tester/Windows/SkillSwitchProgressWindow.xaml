<Window x:Class="DotApps.d3d4tester.Windows.SkillSwitchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="720" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Style="{StaticResource DialogWindowStyle}">
  <!-- Skill switch progress: step list (time, stage, result, detail) | capture and recognition detail of the selected step -->
  <Grid Margin="12,4,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TxtStatus" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="6*"/>
      </Grid.ColumnDefinitions>
      <ListView x:Name="LstSteps" SelectionChanged="LstSteps_SelectionChanged">
        <ListView.View>
          <GridView>
            <GridViewColumn x:Name="ColTime" Width="70" DisplayMemberBinding="{Binding Time}"/>
            <GridViewColumn x:Name="ColResult" Width="34" DisplayMemberBinding="{Binding Result}"/>
            <GridViewColumn x:Name="ColStage" Width="96" DisplayMemberBinding="{Binding Stage}"/>
            <GridViewColumn x:Name="ColDetail" Width="300" DisplayMemberBinding="{Binding Detail}"/>
          </GridView>
        </ListView.View>
      </ListView>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto" MinHeight="70"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource InsetBorderStyle}">
          <Image x:Name="ImgCapture" Stretch="Uniform"/>
        </Border>
        <TextBox x:Name="TxtDetail" Grid.Row="2" Style="{StaticResource MonoLogTextBoxStyle}" MaxHeight="160"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="BtnClose" MinWidth="96" IsCancel="True" Click="BtnClose_Click"/>
    </StackPanel>
  </Grid>
</Window>
