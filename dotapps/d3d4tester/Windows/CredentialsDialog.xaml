<Window x:Class="DotApps.d3d4tester.Windows.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}"
        FocusManager.FocusedElement="{Binding ElementName=TxtEmail}">
  <Grid Margin="20,4,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="{StaticResource ControlCornerRadius}"
              Background="{DynamicResource InfoSubtleBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
        <TextBlock Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource InfoTextBrush}" Text="&#xE77B;"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TxtHeader" Style="{StaticResource SubtitleTextStyle}"/>
        <TextBlock x:Name="TxtHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblRegionType" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
        <ComboBox x:Name="ComboRegion" Grid.Row="0" Grid.Column="1" Margin="{StaticResource FieldMargin}" MinWidth="140" HorizontalAlignment="Left"/>

        <TextBlock x:Name="LblAccount" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,8"/>
        <TextBox x:Name="TxtEmail" Grid.Row="1" Grid.Column="1" Margin="{StaticResource FieldMargin}"/>

        <TextBlock x:Name="LblPassword" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0"/>
        <PasswordBox x:Name="TxtPassword" Grid.Row="2" Grid.Column="1"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnOk" MinWidth="96" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="BtnOk_Click"/>
      <Button x:Name="BtnCancel" MinWidth="96" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
