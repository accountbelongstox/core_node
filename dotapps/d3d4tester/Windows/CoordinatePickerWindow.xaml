<Window x:Class="DotApps.d3d4tester.Windows.CoordinatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1400" Height="800" MinWidth="960" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="Undo"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="Undo" Executed="UndoCommand_Executed"/>
  </Window.CommandBindings>
  <!-- Layout 1:1 Python CoordinatePicker: left tool menu (pick type, values, template matching, history, actions) | screenshot canvas -->
  <Grid Margin="12,0,12,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Pick type -->
      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblPickMode" Style="{StaticResource SectionHeaderTextStyle}"/>
          <UniformGrid Columns="3">
            <ToggleButton x:Name="TglPoint" Margin="0,0,4,0" Click="PickType_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE7C9;" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtPoint" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="TglRect" Margin="2,0,2,0" Click="PickType_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE739;" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtRect" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="TglCircle" Margin="4,0,0,0" Click="PickType_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xEA3A;" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtCircle" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Values -->
      <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblValues" Style="{StaticResource SectionHeaderTextStyle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblWidth" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}"/>
            <TextBox x:Name="TxtWidth" Grid.Column="1" TextAlignment="Right" Margin="0,0,8,0" LostFocus="ValueBox_LostFocus"/>
            <TextBlock x:Name="LblHeight" Grid.Column="2" Style="{StaticResource FieldLabelTextStyle}"/>
            <TextBox x:Name="TxtHeight" Grid.Column="3" TextAlignment="Right" Margin="0,0,8,0" LostFocus="ValueBox_LostFocus"/>
            <TextBlock x:Name="LblRadius" Grid.Column="4" Style="{StaticResource FieldLabelTextStyle}"/>
            <TextBox x:Name="TxtRadius" Grid.Column="5" TextAlignment="Right" LostFocus="ValueBox_LostFocus"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Template matching -->
      <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <StackPanel>
          <TextBlock x:Name="LblTemplateMatching" Style="{StaticResource SectionHeaderTextStyle}"/>
          <Button x:Name="BtnSelectTemplates" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="BtnSelectTemplates_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8B3;" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtSelectTemplates" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- History (scrolls inside its card) -->
      <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblHistory" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Style="{StaticResource StatusChipInfoStyle}" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="TxtPicksCount"/>
            </Border>
            <Button x:Name="BtnUndo" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" Command="Undo"/>
          </Grid>
          <ListView x:Name="HistoryList" Grid.Row="1">
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="ColId" Width="36" DisplayMemberBinding="{Binding Index}"/>
                <GridViewColumn x:Name="ColType" Width="56" DisplayMemberBinding="{Binding TypeName}"/>
                <GridViewColumn x:Name="ColCoords" Width="104" DisplayMemberBinding="{Binding CoordsText}"/>
                <GridViewColumn x:Name="ColName" Width="96" DisplayMemberBinding="{Binding Name}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>

      <!-- Actions -->
      <UniformGrid Grid.Row="4" Columns="2">
        <Button x:Name="BtnRefresh" Margin="0,0,4,8" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72C;" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtRefresh" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnExport" Style="{StaticResource SuccessButtonStyle}" Margin="4,0,0,8" Click="BtnExport_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xEDE1;" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtExport" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnClose" Margin="0,0,4,0" Click="BtnClose_Click"/>
        <Button x:Name="BtnComplete" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0" Click="BtnClose_Click"/>
      </UniformGrid>
    </Grid>

    <!-- Screenshot canvas -->
    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource InsetBorderStyle}" Padding="0">
          <Grid>
            <Canvas x:Name="PickCanvas" ClipToBounds="True" Cursor="Cross" Background="Transparent"
                    SizeChanged="PickCanvas_SizeChanged" MouseLeftButtonDown="PickCanvas_MouseLeftButtonDown" MouseMove="PickCanvas_MouseMove">
              <Image x:Name="ScreenshotImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Canvas>
            <TextBlock x:Name="TxtEmptyCanvas" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtHint" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtCursor" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
