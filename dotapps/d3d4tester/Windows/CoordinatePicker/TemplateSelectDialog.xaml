<Window x:Class="DotApps.d3d4tester.Windows.CoordinatePicker.TemplateSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" Height="600" MinWidth="360" MinHeight="400"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
  <!-- Layout 1:1 Python CoordinatePicker._on_select_templates: templates by category, drawing modes, Apply / Reset / Cancel -->
  <Grid Margin="16,4,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTemplates" Style="{StaticResource SectionHeaderTextStyle}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TemplatesPanel"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardMargin}">
      <StackPanel>
        <TextBlock x:Name="LblDrawingModes" Style="{StaticResource SectionHeaderTextStyle}"/>
        <WrapPanel>
          <CheckBox x:Name="ChkModePoint" Margin="0,0,24,0"/>
          <CheckBox x:Name="ChkModeRect" Margin="0,0,24,0"/>
          <CheckBox x:Name="ChkModeCircle"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnReset" Style="{StaticResource WarningButtonStyle}" Margin="0,0,8,0" Click="BtnReset_Click"/>
      <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="BtnApply" Style="{StaticResource SuccessButtonStyle}" IsDefault="True" Click="BtnApply_Click"/>
    </StackPanel>
  </Grid>
</Window>
