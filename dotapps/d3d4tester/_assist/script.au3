	If Not IsHWnd ( $HWND ) Then $HWND = GUICtrlGetHandle ( $HWND )
	Return _SENDMESSAGE ( $HWND , $TVM_GETSCROLLTIME )
EndFunc
Func _GUICTRLTREEVIEW_GETSELECTED ( $HWND , $HITEM )
