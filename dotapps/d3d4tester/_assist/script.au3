	EndSwitch
	Local $TAUXILIARY = DllStructCreate ( "byte[" & BinaryLen ( $BBINARY1 ) & "];byte[" & BinaryLen ( $BBINARY2 ) & "]" )
	DllStructSetData ( $TAUXILIARY , 1 , $BBINARY1 )
