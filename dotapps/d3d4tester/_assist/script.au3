	FileWrite ( $FILE , "error_logic_rbpath=Ros-Bot程序路径不再存在。该值已清除。" & @CRLF )
	FileWrite ( $FILE , "error_logic_screenshottimer=“每X分钟获取屏幕截图”的最小设置为1分钟。该值已重置为默认值1分钟。" & @CRLF )
	FileWrite ( $FILE , "error_mpcontrol=错误：无法获得masterprofile下拉控件" & @CRLF )
