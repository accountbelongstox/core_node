Func __GUICTRLCOMBOBOX_ISPRESSED ( $SHEXKEY , $VDLL = "user32.dll" )
	Local $A_R = DllCall ( $VDLL , "short" , "GetAsyncKeyState" , "int" , "0x" & $SHEXKEY )
