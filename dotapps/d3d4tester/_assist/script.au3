EndFunc
Func _GUICTRLTREEVIEW_GETSELECTEDIMAGEINDEX ( $HWND , $HITEM )
	If Not IsHWnd ( $HITEM ) Then $HITEM = _GUICTRLTREEVIEW_GETITEMHANDLE ( $HWND , $HITEM )
	Local $TITEM = $__G_TTVITEMEX
	DllStructSetData ( $TITEM , "Mask" , $TVIF_SELECTEDIMAGE )
