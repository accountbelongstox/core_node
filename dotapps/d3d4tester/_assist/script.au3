	DllStructSetData ( $TITEM , "Mask" , $LVIF_STATE )
	DllStructSetData ( $TITEM , "Item" , $IINDEX )
	DllStructSetData ( $TITEM , "SubItem" , 0 )
	DllStructSetData ( $TITEM , "StateMask" , 65535 )
