Func _GUICTRLHEADER_ADDITEM ( $HWND , $STEXT , $IWIDTH = 50 , $IALIGN = 0 , $IIMAGE = + 4294967295 , $BONRIGHT = False )
	Return _GUICTRLHEADER_INSERTITEM ( $HWND , _GUICTRLHEADER_GETITEMCOUNT ( $HWND ) , $STEXT , $IWIDTH , $IALIGN , $IIMAGE , $BONRIGHT )
EndFunc
