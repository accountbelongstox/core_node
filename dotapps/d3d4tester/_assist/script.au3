					If $AINPUTIDS [ 3 ] [ $I ] = "checkbox" Then $SCHECKBOX &= $AINPUTIDS [ 1 ] [ $I ] & "=" & $AINPUTIDS [ 2 ] [ $I ] & $SGRSEP
					If $AINPUTIDS [ 3 ] [ $I ] = "button" Then $SBUTTON &= $AINPUTIDS [ 1 ] [ $I ] & "=" & $AINPUTIDS [ 2 ] [ $I ] & $SGRSEP
