	If Not IsHWnd ( $HWND ) Then $HWND = GUICtrlGetHandle ( $HWND )
	Return _SENDMESSAGE ( $HWND , $CB_FINDSTRING , $IINDEX , $STEXT , 0 , "int" , "wstr" )
EndFunc
