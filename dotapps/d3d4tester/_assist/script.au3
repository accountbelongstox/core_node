Func LOADLANGUAGE ( $STRING )
	Local $R = IniRead ( "lang_" & $CURLANG & ".ini" , "lang" , $STRING , IniRead ( "lang_en.ini" , "lang" , $STRING , "ERR_" & $STRING ) )
	If $R = "" Then Return IniRead ( "lang_en.ini" , "lang" , $STRING , "ERR_" & $STRING )
	Return $R
EndFunc
$LANGLIST = _FILESEARCH ( "lang_*.ini" )
Dim $LANGCTRLS [ $LANGLIST [ 0 ] + 1 ]
For $I = 1 To $LANGLIST [ 0 ]
	$LANGLIST [ $I ] = StringTrimRight ( StringRight ( $LANGLIST [ $I ] , 6 ) , 4 )
Next
If Not IsAdmin ( ) Then
	_RERUNASADMIN ( )
	Exit
EndIf
Func _RERUNASADMIN ( )
	Local $SPARAMETERS = ""
	If Not @Compiled Then
		$SPARAMETERS = """" & @ScriptFullPath & """"
	EndIf
	ShellExecute ( @AutoItExe , $SPARAMETERS , "" , "runas" )
	If @error Then Return MsgBox ( 16 + 262144 , LOADLANGUAGE ( "string_error" ) , LOADLANGUAGE ( "error_elevate" ) )
EndFunc
If Not IsAdmin ( ) Then
	WRITELOG ( "请以管理员权限启动!" )
	Exit
EndIf
