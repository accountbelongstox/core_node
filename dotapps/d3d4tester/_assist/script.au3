Func TAKESCREENSHOT ( $PATH , $NAME = LOADLANGUAGE ( "string_screenshot" ) )
	Local $HWND = WinGetHandle ( $D3CLASS )
	If Not @error Then
		Local $A [ 5 ] = [ 4 , 0 , 0 , + 4294967295 , + 4294967295 ]
		If GUICtrlRead ( $RADIOSCREENSHOTCUSTOM ) = $GUI_CHECKED And $NAME = LOADLANGUAGE ( "string_screenshot" ) Then
			$A = StringSplit ( GUICtrlRead ( $INPUTSCREENSHOTCROP ) , "," )
		EndIf
		Local $D3WINDOW = _SCREENCAPTURE_CAPTUREWND ( $PATH & "\" & $NAME & "-" & @YEAR & "-" & @MON & "-" & @MDAY & "-" & @HOUR & "_" & @MIN & "_" & @SEC & ".jpg" , $HWND , $A [ 1 ] , $A [ 2 ] , $A [ 3 ] , $A [ 4 ] )
		If @error <> 0 Then
			WRITELOG ( LOADLANGUAGE ( "string_error_savingscreenshot" ) & ": " & @error & " - " & $PATH & "\" & $NAME & "-" & @YEAR & @MON & @MDAY & @HOUR & @MIN & @SEC & ".jpg" , 1 )
		EndIf
	Else
		WRITELOG ( LOADLANGUAGE ( "string_error_d3winhandle" ) )
	EndIf
EndFunc
Func TAKESCREENSHOT2 ( $PATH , $NAME = LOADLANGUAGE ( "string_screenshot" ) )
	Local $HWND = WinGetHandle ( $D3CLASS )
	If @error Or $HWND = 0 Then
		WRITELOG ( "无法获取窗口句柄" )
		Return
	EndIf
	If Not FileExists ( $PATH ) Then DirCreate ( $PATH )
	Local $A [ 5 ] = [ 4 , 0 , 0 , + 4294967295 , + 4294967295 ]
	If GUICtrlRead ( $RADIOSCREENSHOTCUSTOM ) = $GUI_CHECKED And $NAME = "Screenshot" Then
		Local $TMP = StringSplit ( GUICtrlRead ( $INPUTSCREENSHOTCROP ) , "," )
		If $TMP [ 0 ] = 4 Then $A = $TMP
	EndIf
	Local $SIZE = WinGetClientSize ( $HWND )
	Local $IWIDTH = $SIZE [ 0 ]
	Local $IHEIGHT = $SIZE [ 1 ]
	Local $HDC = _WINAPI_GETDC ( $HWND )
	Local $HMEMDC = _WINAPI_CREATECOMPATIBLEDC ( $HDC )
	Local $HBMP = _WINAPI_CREATECOMPATIBLEBITMAP ( $HDC , $IWIDTH , $IHEIGHT )
	Local $HOLD = _WINAPI_SELECTOBJECT ( $HMEMDC , $HBMP )
	_WINAPI_BITBLT ( $HMEMDC , 0 , 0 , $IWIDTH , $IHEIGHT , $HDC , 0 , 0 , 13369376 )
	_WINAPI_SELECTOBJECT ( $HMEMDC , $HOLD )
	_WINAPI_DELETEDC ( $HMEMDC )
	_WINAPI_RELEASEDC ( $HWND , $HDC )
	Local $HGDIBMP = _GDIPLUS_BITMAPCREATEFROMHBITMAP ( $HBMP )
	If $A [ 3 ] > 0 And $A [ 4 ] > 0 Then
		Local $HCROP = _GDIPLUS_BITMAPCLONEAREA ( $HGDIBMP , $A [ 1 ] , $A [ 2 ] , $A [ 3 ] , $A [ 4 ] )
		_GDIPLUS_BITMAPDISPOSE ( $HGDIBMP )
		$HGDIBMP = $HCROP
	EndIf
	Local $SFILE = StringFormat ( "%s\%s-%04d-%02d-%02d-%02d_%02d_%02d.jpg" , $PATH , $NAME , @YEAR , @MON , @MDAY , @HOUR , @MIN , @SEC )
	_GDIPLUS_IMAGESAVETOFILE ( $HGDIBMP , $SFILE )
	_GDIPLUS_BITMAPDISPOSE ( $HGDIBMP )
	If Not FileExists ( $SFILE ) Then
		WRITELOG ( "截图保存失败: " & $SFILE )
	EndIf
EndFunc
Func TRIMSCREENSHOTCOUNT ( $PATH , $KEEP , $FILTER )
	If $KEEP <> 0 Then
		Local $LIST = _FILESEARCH ( $PATH & "\" & $FILTER , 0 )
		If $LIST [ 0 ] > $KEEP Then
			For $I = 1 To $LIST [ 0 ] - $KEEP
				FileDelete ( $LIST [ $I ] )
			Next
		EndIf
	EndIf
EndFunc
Func WRITELOG ( $TEXT , $TOFILE = 0 )
	_GUICTRLEDIT_APPENDTEXT ( $EDITLOG , @HOUR & ":" & @MIN & ":" & @SEC & " " & $TEXT & @CRLF )
	If $TOFILE Then
		FileWriteLine ( $LOGFILE , @YEAR & "-" & @MON & "-" & @MDAY & " " & @HOUR & ":" & @MIN & ":" & @SEC & " - " & $TEXT )
	EndIf
	If StringLen ( GUICtrlRead ( $EDITLOG ) ) > 20000 Then
		GUICtrlSetData ( $EDITLOG , "" )
	EndIf
EndFunc
Func PUSHPLUS ( $STOKEN , $STITLE , $SCONTENT , $STEMPLATE = "html" )
	Local $OHTTP = ObjCreate ( "WinHttp.WinHttpRequest.5.1" )
	$OHTTP .SetTimeouts ( 3000 , 3000 , 3000 , 3000 )
	Local $SURL = "https://www.pushplus.plus/send"
	Local $SDATA = "{ ""token"":""" & $STOKEN & """, ""title"":""" & $STITLE & """, ""content"":""" & $SCONTENT & """, ""template"":""" & $STEMPLATE & """ }"
	$OHTTP .Open ( "POST" , $SURL , False )
	If @error Then
		WRITELOG ( "pushplus无法访问" )
		Return SetError ( 2 , 0 , "Open Url失败" )
	EndIf
	$OHTTP .SetRequestHeader ( "Content-Type" , "application/json" )
	$OHTTP .Send ( $SDATA )
	If @error Then
		WRITELOG ( "pushplus发送请求失败" )
		Return SetError ( 4 , 0 , "发送失败" )
	EndIf
	Local $SRESPONSE = $OHTTP .ResponseText
	If @error Then
		WRITELOG ( "pushplus获取响应失败" )
		Return SetError ( 5 , 0 , "发送失败" )
	EndIf
	ConsoleWrite ( "Response: " & $SRESPONSE & @CRLF )
	Return $SRESPONSE
EndFunc
Func ARRAYTOCSV ( $AARRAY )
	If Not IsArray ( $AARRAY ) Then Return ""
	Local $SRESULT = ""
	For $I = 0 To UBound ( $AARRAY ) + 4294967295
		$SRESULT &= $AARRAY [ $I ] & ","
	Next
	If StringRight ( $SRESULT , 1 ) = "," Then
		$SRESULT = StringTrimRight ( $SRESULT , 1 )
	EndIf
	Return $SRESULT
EndFunc
Func _GETD3DPIBYWINDOW ( )
	Local $HWND = WinGetHandle ( "[CLASS:D3 Main Window Class]" )
	If @error Then Return 1.0
	Local $DPI = DllCall ( "User32.dll" , "uint" , "GetDpiForWindow" , "hwnd" , $HWND )
	If @error Or Not IsArray ( $DPI ) Then Return 1.0
	Return $DPI [ 0 ] / 96
EndFunc
Func MIND3WINDOWS ( )
	Local $D3H = GUICtrlRead ( $INPUTD3HIGH )
	Local $D3W = GUICtrlRead ( $INPUTD3WIDTH )
	Local $SCALE = _GETD3DPIBYWINDOW ( )
	$W_OFFSET = Ceiling ( 16 / $SCALE )
	$H_OFFSET = Ceiling ( 30 / $SCALE )
	$W = Ceiling ( $D3W / $SCALE )
	$H = Ceiling ( $D3H / $SCALE )
	WinActivate ( "[CLASS:D3 Main Window Class]" , "" )
	Local $X = @DesktopWidth - ( $W + $W_OFFSET / 2 )
	Local $Y = 0
	$POS = MouseGetPos ( )
	$MOUNSX = $POS [ 0 ]
	$MOUNSY = $POS [ 1 ]
	WinMove ( "[CLASS:D3 Main Window Class]" , "" , $X , $Y , $W + $W_OFFSET , Round ( ( $W + $W_OFFSET ) / 16 ) * 9 + $H_OFFSET )
	Sleep ( 10 )
	MouseClick ( "left" , $X + 9 , $Y , 1 , 0 )
	MouseMove ( $MOUNSX , $MOUNSY , 0 )
	WRITELOG ( "缩小D3至桌面右上方-缩放比" & Round ( $SCALE * 100 ) & "%" )
EndFunc
Func INITBRIDGE ( )
	If $G_PIDBRIDGE = 0 Or Not ProcessExists ( $G_PIDBRIDGE ) Then
		Local $BRIDGEPATH = @ScriptDir & "\bridge64.exe"
		Local $SPEEDPATCH64 = @ScriptDir & "\speedpatch64.dll"
		Local $SPEEDPATCH32 = @ScriptDir & "\speedpatch32.dll"
		If Not FileExists ( $BRIDGEPATH ) Then
			WRITELOG ( "错误 找不到bridge64.exe" & $BRIDGEPATH )
			Return False
		EndIf
		If Not FileExists ( $SPEEDPATCH64 ) Or Not FileExists ( $SPEEDPATCH32 ) Then
			WRITELOG ( "错误 缺少文件speedpatch64.dll或speedpatch32.dll" )
			Return False
		EndIf
		$G_PIDBRIDGE = Run ( """" & $BRIDGEPATH & """" , "" , @SW_HIDE , $STDIN_CHILD + $STDOUT_CHILD )
		If $G_PIDBRIDGE = 0 Then
			WRITELOG ( "启动 bridge64.exe 失败，请以管理员权限运行" )
			Exit
		EndIf
		$G_HSTDINBRIDGE = $G_PIDBRIDGE
	EndIf
	Return True
EndFunc
Func BRIDGEINJECTANDCHANGE ( $VAL1 , $VAL2 )
	Local $SPEEDFACTOR = $INFIGHT ? $VAL2 : $VAL1
	If $SPEEDFACTOR = $LASTSPEEDFACTOR Then Return True
	$LASTSPEEDFACTOR = $SPEEDFACTOR
	GUICtrlSetData ( $LBLSPEED , $SPEEDFACTOR )
	If $INFIGHT <> $LASTINFIGHT Then
		$LASTINFIGHT = $INFIGHT
	EndIf
	If Not INITBRIDGE ( ) Then Return False
	Local $TARGETPID = ProcessExists ( "Diablo III64.exe" )
	StdinWrite ( $G_HSTDINBRIDGE , "inject " & $TARGETPID & @CRLF )
	_BRIDGECLEARSTDOUT ( )
	Sleep ( 50 )
	StdinWrite ( $G_HSTDINBRIDGE , "change " & $SPEEDFACTOR & @CRLF )
	_BRIDGECLEARSTDOUT ( )
	Sleep ( 50 )
	Return True
EndFunc
Func _BRIDGECLEARSTDOUT ( )
	If $G_HSTDINBRIDGE = 0 Then Return
	Local $T = TimerInit ( )
	While TimerDiff ( $T ) < 100
		Local $LINE = StdoutRead ( $G_HSTDINBRIDGE )
		If @error Then ExitLoop
		If $LINE = "" Then ExitLoop
	WEnd
EndFunc
Func CLOSEBRIDGE ( )
	If $G_PIDBRIDGE <> 0 And ProcessExists ( $G_PIDBRIDGE ) Then
		StdinWrite ( $G_HSTDINBRIDGE , "exit" & @CRLF )
		Sleep ( 100 )
		ProcessClose ( $G_PIDBRIDGE )
	EndIf
	$G_PIDBRIDGE = 0
	$G_HBRIDGE = 0
EndFunc
Func _GETHWNDBYPROCESS ( $SPROC )
	Local $PID = ProcessExists ( $SPROC )
	If $PID = 0 Then Return 0
	Local $ALIST = WinList ( )
	For $I = 1 To $ALIST [ 0 ] [ 0 ]
		If $ALIST [ $I ] [ 0 ] <> "" Then
			If WinGetProcess ( $ALIST [ $I ] [ 1 ] ) = $PID Then
				Return $ALIST [ $I ] [ 1 ]
			EndIf
		EndIf
	Next
	Return 0
EndFunc
Func GETPIXELCOLORCNT ( $R , $G , $B )
	If $ROSBOTPROCESSNAME = "" Then Return 0
	Local $HWND = _GETHWNDBYPROCESS ( $ROSBOTPROCESSNAME )
	If @error Or $HWND = 0 Then
		Return 0
	EndIf
	Local $ASIZE = WinGetClientSize ( $HWND )
	If @error Or Not IsArray ( $ASIZE ) Or UBound ( $ASIZE ) < 2 Then
		Return 0
	EndIf
	Local $IWIDTH = $ASIZE [ 0 ] , $IHEIGHT = $ASIZE [ 1 ]
	Local $HDC = _WINAPI_GETDC ( $HWND )
	Local $HMEMDC = _WINAPI_CREATECOMPATIBLEDC ( $HDC )
	Local $HBMP = _WINAPI_CREATECOMPATIBLEBITMAP ( $HDC , $IWIDTH , $IHEIGHT )
	Local $HOLD = _WINAPI_SELECTOBJECT ( $HMEMDC , $HBMP )
	_WINAPI_BITBLT ( $HMEMDC , 0 , 0 , $IWIDTH , $IHEIGHT , $HDC , 0 , 0 , 13369376 )
	Local $HBITMAP = _GDIPLUS_BITMAPCREATEFROMHBITMAP ( $HBMP )
	_WINAPI_SELECTOBJECT ( $HMEMDC , $HOLD )
	_WINAPI_DELETEDC ( $HMEMDC )
	_WINAPI_RELEASEDC ( $HWND , $HDC )
	_WINAPI_DELETEOBJECT ( $HBMP )
	Local $CROP_W = Int ( $IWIDTH / 13.33 )
	Local $CROP_H = Int ( $IHEIGHT / 5.33 )
	Local $X1 = Int ( ( $IWIDTH - $CROP_W ) / 2 )
	Local $Y1 = Int ( ( $IHEIGHT - $CROP_H ) / 2 )
	Local $Y2_H = Int ( $CROP_H * 0.75 )
	Local $HCROP = _GDIPLUS_BITMAPCLONEAREA ( $HBITMAP , $X1 , $Y1 , $CROP_W , $Y2_H , $GDIP_PXF32ARGB )
	Local $TDATA = _GDIPLUS_BITMAPLOCKBITS ( $HCROP , 0 , 0 , $CROP_W , $Y2_H , $GDIP_ILMREAD , $GDIP_PXF32ARGB )
	Local $ISCAN0 = DllStructGetData ( $TDATA , "Scan0" )
	Local $TPIXEL = DllStructCreate ( "int[" & $CROP_W * $Y2_H & "];" , $ISCAN0 )
	Local $COUNT = 0 , $IROWOFFSET , $IPIXEL , $RR , $GG , $BB
	For $Y = 0 To $Y2_H + 4294967295
		$IROWOFFSET = $Y * $CROP_W
		For $X = 0 To $CROP_W + 4294967295
			$IPIXEL = DllStructGetData ( $TPIXEL , 1 , $IROWOFFSET + $X + 1 )
			$RR = BitAND ( BitShift ( $IPIXEL , 16 ) , 255 )
			$GG = BitAND ( BitShift ( $IPIXEL , 8 ) , 255 )
			$BB = BitAND ( $IPIXEL , 255 )
			If $RR = $R And $GG = $G And Abs ( $BB - $B ) <= 2 Then $COUNT += 1
		Next
	Next
	_GDIPLUS_BITMAPUNLOCKBITS ( $HCROP , $TDATA )
	_GDIPLUS_BITMAPDISPOSE ( $HCROP )
	_GDIPLUS_BITMAPDISPOSE ( $HBITMAP )
	Return $COUNT
EndFunc
Func GETTPPIXEL ( )
	Local $HWND = WinGetHandle ( "[CLASS:D3 Main Window Class]" )
	If @error Or $HWND = 0 Then
		Return + 4294967295
	EndIf
	Local $ASIZE = WinGetClientSize ( $HWND )
	If @error Or Not IsArray ( $ASIZE ) Or UBound ( $ASIZE ) < 2 Then
		Return + 4294967295
	EndIf
	Local $IWIDTH = $ASIZE [ 0 ] , $IHEIGHT = $ASIZE [ 1 ]
	Local $HDC = _WINAPI_GETDC ( $HWND )
	Local $HMEMDC = _WINAPI_CREATECOMPATIBLEDC ( $HDC )
	Local $HBMP = _WINAPI_CREATECOMPATIBLEBITMAP ( $HDC , $IWIDTH , $IHEIGHT )
	Local $HOLD = _WINAPI_SELECTOBJECT ( $HMEMDC , $HBMP )
	_WINAPI_BITBLT ( $HMEMDC , 0 , 0 , $IWIDTH , $IHEIGHT , $HDC , 0 , 0 , 13369376 )
	Local $HBITMAP = _GDIPLUS_BITMAPCREATEFROMHBITMAP ( $HBMP )
	_WINAPI_SELECTOBJECT ( $HMEMDC , $HOLD )
	_WINAPI_DELETEDC ( $HMEMDC )
	_WINAPI_RELEASEDC ( $HWND , $HDC )
	_WINAPI_DELETEOBJECT ( $HBMP )
	Local $CROP_W = Int ( $IWIDTH / 40 )
	Local $CROP_H = Int ( $IHEIGHT / 33 )
	Local $X1 = Int ( $IWIDTH / 60 )
	Local $Y1 = Int ( $IHEIGHT / 12.5 )
	Local $Y2 = $Y1 + $CROP_H + 4294967295
	Local $HCROP = _GDIPLUS_BITMAPCLONEAREA ( $HBITMAP , $X1 , $Y1 , $CROP_W , $CROP_H , $GDIP_PXF32ARGB )
	Local $TDATA = _GDIPLUS_BITMAPLOCKBITS ( $HCROP , 0 , 0 , $CROP_W , $CROP_H , BitOR ( $GDIP_ILMWRITE , $GDIP_ILMREAD ) , $GDIP_PXF32ARGB )
	Local $ISCAN0 = DllStructGetData ( $TDATA , "Scan0" )
	Local $TPIXEL = DllStructCreate ( "int[" & $CROP_W * $CROP_H & "];" , $ISCAN0 )
	Local $COUNT = 0 , $IROWOFFSET , $IPIXEL , $RR , $GG , $BB
	For $Y = 0 To $Y2 + 4294967295
		$IROWOFFSET = $Y * $CROP_W
		For $X = 0 To $CROP_W + 4294967295
			$IPIXEL = DllStructGetData ( $TPIXEL , 1 , $IROWOFFSET + $X )
			$RR = BitAND ( BitShift ( $IPIXEL , 16 ) , 255 )
			$GG = BitAND ( BitShift ( $IPIXEL , 8 ) , 255 )
			$BB = BitAND ( $IPIXEL , 255 )
			If $RR >= 41 And $RR <= 105 And $GG >= 69 And $GG <= 187 And $BB >= 214 And $BB <= 249 Then
				$COUNT += 1
			EndIf
		Next
	Next
	_GDIPLUS_BITMAPUNLOCKBITS ( $HCROP , $TDATA )
	_GDIPLUS_BITMAPDISPOSE ( $HCROP )
	_GDIPLUS_BITMAPDISPOSE ( $HBITMAP )
	Return $COUNT
EndFunc
Func FINISH_ILLUSION ( )
	Local $HWND = WinGetHandle ( "[CLASS:D3 Main Window Class]" )
	If @error Or $HWND = 0 Then
		Return + 4294967295
	EndIf
	Local $ASIZE = WinGetClientSize ( $HWND )
	If @error Or Not IsArray ( $ASIZE ) Or UBound ( $ASIZE ) < 2 Then
		Return + 4294967295
	EndIf
	Local $IWIDTH = $ASIZE [ 0 ] , $IHEIGHT = $ASIZE [ 1 ]
	Local $HDC = _WINAPI_GETDC ( $HWND )
	Local $HMEMDC = _WINAPI_CREATECOMPATIBLEDC ( $HDC )
	Local $HBMP = _WINAPI_CREATECOMPATIBLEBITMAP ( $HDC , $IWIDTH , $IHEIGHT )
	Local $HOLD = _WINAPI_SELECTOBJECT ( $HMEMDC , $HBMP )
	_WINAPI_BITBLT ( $HMEMDC , 0 , 0 , $IWIDTH , $IHEIGHT , $HDC , 0 , 0 , 13369376 )
	Local $HBITMAP = _GDIPLUS_BITMAPCREATEFROMHBITMAP ( $HBMP )
	_WINAPI_SELECTOBJECT ( $HMEMDC , $HOLD )
	_WINAPI_DELETEDC ( $HMEMDC )
	_WINAPI_RELEASEDC ( $HWND , $HDC )
	_WINAPI_DELETEOBJECT ( $HBMP )
	Local $CROP_W = Int ( $IWIDTH / 11 )
	Local $CROP_H = Int ( $IHEIGHT / 11 )
	Local $X1 = Int ( $IWIDTH / 2.2 )
	Local $Y1 = Int ( $IHEIGHT / 8 )
	Local $Y2 = $Y1 + $CROP_H + 4294967295
	Local $HCROP = _GDIPLUS_BITMAPCLONEAREA ( $HBITMAP , $X1 , $Y1 , $CROP_W , $CROP_H , $GDIP_PXF32ARGB )
	Local $TDATA = _GDIPLUS_BITMAPLOCKBITS ( $HCROP , 0 , 0 , $CROP_W , $CROP_H , BitOR ( $GDIP_ILMWRITE , $GDIP_ILMREAD ) , $GDIP_PXF32ARGB )
	Local $ISCAN0 = DllStructGetData ( $TDATA , "Scan0" )
	Local $TPIXEL = DllStructCreate ( "int[" & $CROP_W * $CROP_H & "];" , $ISCAN0 )
	Local $COUNT = 0 , $IROWOFFSET , $IPIXEL , $RR , $GG , $BB
	Local $ICOUNTWHITE = 0
	For $Y = 0 To $Y2 + 4294967295
		$IROWOFFSET = $Y * $CROP_W
		For $X = 0 To $CROP_W + 4294967295
			$IPIXEL = DllStructGetData ( $TPIXEL , 1 , $IROWOFFSET + $X )
			Local $PXR = BitAND ( BitShift ( $IPIXEL , 16 ) , 255 )
			Local $PXG = BitAND ( BitShift ( $IPIXEL , 8 ) , 255 )
			Local $PXB = BitAND ( $IPIXEL , 255 )
			If $PXR >= 120 And $PXR <= 204 And $PXG >= 96 And $PXG <= 156 And $PXB >= 64 And $PXB <= 81 Then
				$COUNT += 1
			EndIf
			If $PXR >= 210 And $PXG >= 210 And $PXB >= 210 Then
				$ICOUNTWHITE += 1
			EndIf
		Next
	Next
	_GDIPLUS_BITMAPUNLOCKBITS ( $HCROP , $TDATA )
	_GDIPLUS_BITMAPDISPOSE ( $HCROP )
	_GDIPLUS_BITMAPDISPOSE ( $HBITMAP )
	If $COUNT > $FIN_ILLTHRESHOLD [ 1 ] And $ICOUNTWHITE > $FIN_ILLTHRESHOLD [ 2 ] Then
		Return True
	Else
		Return False
	EndIf
EndFunc
Func FIND_ILLUSION ( )
	Local $HWND = WinGetHandle ( "[CLASS:D3 Main Window Class]" )
	If @error Or $HWND = 0 Then
		Return + 4294967295
	EndIf
	Local $ASIZE = WinGetClientSize ( $HWND )
	If @error Or Not IsArray ( $ASIZE ) Or UBound ( $ASIZE ) < 2 Then
		Return + 4294967295
	EndIf
	Local $IWIDTH = $ASIZE [ 0 ] , $IHEIGHT = $ASIZE [ 1 ]
	Local $HDC = _WINAPI_GETDC ( $HWND )
	Local $HMEMDC = _WINAPI_CREATECOMPATIBLEDC ( $HDC )
	Local $HBMP = _WINAPI_CREATECOMPATIBLEBITMAP ( $HDC , $IWIDTH , $IHEIGHT )
	Local $HOLD = _WINAPI_SELECTOBJECT ( $HMEMDC , $HBMP )
	_WINAPI_BITBLT ( $HMEMDC , 0 , 0 , $IWIDTH , $IHEIGHT , $HDC , 0 , 0 , 13369376 )
	Local $HBITMAP = _GDIPLUS_BITMAPCREATEFROMHBITMAP ( $HBMP )
	_WINAPI_SELECTOBJECT ( $HMEMDC , $HOLD )
	_WINAPI_DELETEDC ( $HMEMDC )
	_WINAPI_RELEASEDC ( $HWND , $HDC )
	_WINAPI_DELETEOBJECT ( $HBMP )
	Local $CROP_W = Int ( $IWIDTH / 7.2 )
	Local $CROP_H = Int ( $IHEIGHT / 35 )
	Local $X1 = Int ( $IWIDTH / 2.34 )
	Local $Y1 = Int ( $IHEIGHT / 4.9 )
	Local $X2 = $X1 + $CROP_W + 4294967295
	Local $Y2 = $Y1 + $CROP_H + 4294967295
	Local $HCROP = _GDIPLUS_BITMAPCLONEAREA ( $HBITMAP , $X1 , $Y1 , $CROP_W , $CROP_H , $GDIP_PXF32ARGB )
	Local $TDATA = _GDIPLUS_BITMAPLOCKBITS ( $HCROP , 0 , 0 , $CROP_W , $CROP_H , BitOR ( $GDIP_ILMWRITE , $GDIP_ILMREAD ) , $GDIP_PXF32ARGB )
	Local $ISCAN0 = DllStructGetData ( $TDATA , "Scan0" )
	Local $TPIXEL = DllStructCreate ( "int[" & $CROP_W * $CROP_H & "];" , $ISCAN0 )
	Local $ICOUNTLEFT = 0 , $ICOUNTRIGHT = 0
	Local $ICOUNTWHITE = 0
	Local $IROWOFFSET , $IPIXEL
	Local $SEGMENTS = 11
	Local $SEGWIDTH = Int ( $CROP_W / $SEGMENTS )
	Local $ASEGCOUNTS [ $SEGMENTS ]
	For $Y = 0 To $CROP_H + 4294967295
		$IROWOFFSET = $Y * $CROP_W
		For $X = 0 To $CROP_W + 4294967295
			$IPIXEL = DllStructGetData ( $TPIXEL , 1 , $IROWOFFSET + $X )
			Local $PXR = BitAND ( BitShift ( $IPIXEL , 16 ) , 255 )
			Local $PXG = BitAND ( BitShift ( $IPIXEL , 8 ) , 255 )
			Local $PXB = BitAND ( $IPIXEL , 255 )
			If $PXR >= 210 And $PXG >= 210 And $PXB >= 210 Then
				$ICOUNTWHITE += 1
				Local $SEGINDEX = Int ( $X / $SEGWIDTH )
				If $SEGINDEX >= $SEGMENTS Then $SEGINDEX = $SEGMENTS + 4294967295
				$ASEGCOUNTS [ $SEGINDEX ] += 1
			EndIf
			If $ICOUNTWHITE > $FIND_ILLTHRESHOLD [ 1 ] Then
				Local $POSSIBLE = True
				For $I = 0 To $SEGMENTS + 4294967295
					Local $REMAININGPIXELS = $SEGWIDTH * ( $CROP_H - $Y ) + ( $CROP_W - ( $X + 1 ) )
					If $I = 0 Then
						If $ASEGCOUNTS [ $I ] + $REMAININGPIXELS < $FIND_ILLTHRESHOLD [ 2 ] Then $POSSIBLE = False
					Else
						If $ASEGCOUNTS [ $I ] + $REMAININGPIXELS <= $FIND_ILLTHRESHOLD [ 3 ] Then $POSSIBLE = False
					EndIf
				Next
				If $POSSIBLE Then ExitLoop 2
			EndIf
		Next
	Next
	_GDIPLUS_BITMAPUNLOCKBITS ( $HCROP , $TDATA )
	_GDIPLUS_BITMAPDISPOSE ( $HCROP )
	_GDIPLUS_BITMAPDISPOSE ( $HBITMAP )
	If $ICOUNTWHITE > $FIND_ILLTHRESHOLD [ 1 ] Then
		Local $ALLSEGOK = True
		For $I = 0 To $SEGMENTS + 4294967295
			If $I = 0 Then
				If $ASEGCOUNTS [ $I ] < $FIND_ILLTHRESHOLD [ 2 ] Then
					$ALLSEGOK = False
					ExitLoop
				EndIf
			Else
				If $ASEGCOUNTS [ $I ] <= $FIND_ILLTHRESHOLD [ 3 ] Then
					$ALLSEGOK = False
					ExitLoop
				EndIf
			EndIf
		Next
		If $ALLSEGOK Then
			Return True
		EndIf
	EndIf
	Return False
EndFunc
Func FIND_URSHI ( )
	Local $HWND = WinGetHandle ( "[CLASS:D3 Main Window Class]" )
	If @error Or $HWND = 0 Then
		Return + 4294967295
	EndIf
	Local $ASIZE = WinGetClientSize ( $HWND )
	If @error Or Not IsArray ( $ASIZE ) Or UBound ( $ASIZE ) < 2 Then
		Return + 4294967295
	EndIf
	Local $IWIDTH = $ASIZE [ 0 ] , $IHEIGHT = $ASIZE [ 1 ]
	Local $HDC = _WINAPI_GETDC ( $HWND )
	Local $HMEMDC = _WINAPI_CREATECOMPATIBLEDC ( $HDC )
	Local $HBMP = _WINAPI_CREATECOMPATIBLEBITMAP ( $HDC , $IWIDTH , $IHEIGHT )
	Local $HOLD = _WINAPI_SELECTOBJECT ( $HMEMDC , $HBMP )
	_WINAPI_BITBLT ( $HMEMDC , 0 , 0 , $IWIDTH , $IHEIGHT , $HDC , 0 , 0 , 13369376 )
	Local $HBITMAP = _GDIPLUS_BITMAPCREATEFROMHBITMAP ( $HBMP )
	_WINAPI_SELECTOBJECT ( $HMEMDC , $HOLD )
	_WINAPI_DELETEDC ( $HMEMDC )
	_WINAPI_RELEASEDC ( $HWND , $HDC )
	_WINAPI_DELETEOBJECT ( $HBMP )
	Local $CROP_W = Int ( $IWIDTH / 16 )
	Local $CROP_H = Int ( $IHEIGHT / 9.5 )
	Local $X1 = Int ( $IWIDTH / 9.3 )
	Local $Y1 = Int ( $IHEIGHT / 28 )
	Local $X2 = $X1 + $CROP_W + 4294967295
	Local $Y2 = $Y1 + $CROP_H + 4294967295
	Local $HCROP = _GDIPLUS_BITMAPCLONEAREA ( $HBITMAP , $X1 , $Y1 , $CROP_W , $CROP_H , $GDIP_PXF32ARGB )
	Local $TDATA = _GDIPLUS_BITMAPLOCKBITS ( $HCROP , 0 , 0 , $CROP_W , $CROP_H , BitOR ( $GDIP_ILMWRITE , $GDIP_ILMREAD ) , $GDIP_PXF32ARGB )
	Local $ISCAN0 = DllStructGetData ( $TDATA , "Scan0" )
	Local $TPIXEL = DllStructCreate ( "int[" & $CROP_W * $CROP_H & "];" , $ISCAN0 )
	Local $ICOUNTGOLD = 0
	Local $ICOUNTBLUE = 0
	Local $ICOUNTWHITE = 0
	Local $ICOUNTGOLDSUB = 0
	Local $IROWOFFSET , $IPIXEL
	Local $SUB_H = Int ( $CROP_H / 4 )
	Local $SUB_Y_START = $CROP_H - $SUB_H
	For $Y = 0 To $CROP_H + 4294967295
		$IROWOFFSET = $Y * $CROP_W
		For $X = 0 To $CROP_W + 4294967295
			$IPIXEL = DllStructGetData ( $TPIXEL , 1 , $IROWOFFSET + $X )
			Local $PXR = BitAND ( BitShift ( $IPIXEL , 16 ) , 255 )
			Local $PXG = BitAND ( BitShift ( $IPIXEL , 8 ) , 255 )
			Local $PXB = BitAND ( $IPIXEL , 255 )
			If $PXR >= 141 And $PXR <= 250 And $PXG >= 86 And $PXG <= 191 And $PXB >= 0 And $PXB <= 88 Then
				$ICOUNTGOLD += 1
				If $Y >= $SUB_Y_START Then $ICOUNTGOLDSUB += 1
			EndIf
			If $PXR >= 187 And $PXR <= 252 And $PXG >= 184 And $PXG <= 244 And $PXB >= 137 And $PXB <= 204 Then
				If $Y <= Int ( $CROP_H * 0.375 ) And $X > Int ( $CROP_W / 2.5 ) And $X < Int ( $CROP_W / 1.67 ) Then
					$ICOUNTWHITE += 1
				EndIf
			EndIf
			If $PXR >= 13 And $PXR <= 115 And $PXG >= 55 And $PXG <= 170 And $PXB >= 112 And $PXB <= 255 Then
				If $Y <= $SUB_Y_START Then
					$ICOUNTBLUE += 1
				EndIf
			EndIf
		Next
	Next
	_GDIPLUS_BITMAPUNLOCKBITS ( $HCROP , $TDATA )
	_GDIPLUS_BITMAPDISPOSE ( $HCROP )
	_GDIPLUS_BITMAPDISPOSE ( $HBITMAP )
	If $ICOUNTGOLDSUB > $URSHITHRESHOLD [ 1 ] And $ICOUNTGOLD >= $URSHITHRESHOLD [ 1 ] * 2 And $ICOUNTWHITE > $URSHITHRESHOLD [ 2 ] And $ICOUNTBLUE > $URSHITHRESHOLD [ 3 ] Then
		Return True
	Else
		Return False
	EndIf
EndFunc
Func DRAGCIRCLE ( $X , $Y , $RADIUS = 100 , $DIRECTION = "ccw" , $POINTS = 12 )
	Local $ANGLESTEP = 360 / $POINTS
	MouseMove ( $X , $Y , 0 )
	Sleep ( 50 )
	MouseDown ( "left" )
	Sleep ( 50 )
	For $I = 0 To $POINTS
		Local $ANGLE = ( $DIRECTION = "ccw" ) ? ( 360 - $I * $ANGLESTEP ) : ( $I * $ANGLESTEP )
		Local $RAD = $ANGLE * ( 3.14159 / 180 )
		Local $DX = Cos ( $RAD ) * $RADIUS
		Local $DY = Sin ( $RAD ) * $RADIUS
		MouseMove ( $X + $DX , $Y + $DY , 2 )
		Sleep ( 15 )
	Next
	MouseUp ( "left" )
	Sleep ( 50 )
EndFunc
Func SENDTPTOD3 ( $IDELAYMS = 0 )
	If Not $G_TPPENDING Then
		$G_TPSTART = TimerInit ( )
		$G_TPDELAY = $IDELAYMS
		$G_TPPENDING = True
	EndIf
EndFunc
Func CHECKTPTOD3 ( )
	If $G_TPPENDING And TimerDiff ( $G_TPSTART ) >= $G_TPDELAY Then
		Local $HWND = WinGetHandle ( "[CLASS:D3 Main Window Class]" )
		POSTTP ( $HWND )
		$G_TPPENDING = False
	EndIf
EndFunc
Func POSTTP ( $WND )
	Sleep ( 20 )
	DllCall ( "user32.dll" , "lresult" , "PostMessage" , "hwnd" , $WND , "uint" , 256 , "wparam" , 84 , "lparam" , 1966081 )
	DllCall ( "user32.dll" , "lresult" , "PostMessage" , "hwnd" , $WND , "uint" , 257 , "wparam" , 84 , "lparam" , 3223191553 )
	Return True
EndFunc
Func SAFE_GDIPLUS_STARTUP ( )
	If Not $GDIPLUS_INITIALIZED Then
		_GDIPLUS_STARTUP ( )
		$GDIPLUS_INITIALIZED = True
	EndIf
EndFunc
Func SAFE_GDIPLUS_SHUTDOWN ( )
	If $GDIPLUS_INITIALIZED Then
		_GDIPLUS_SHUTDOWN ( )
		$GDIPLUS_INITIALIZED = False
	EndIf
EndFunc
Func QUICKQUIT ( $QDELAY = "" )
	Local $SEXE1 = @ScriptDir & "\D3_tcprst0.4.1.exe"
	Local $SEXE2 = @ScriptDir & "\D3_tcprst.exe"
	Local $STARGET = ""
	If Not FileExists ( @ScriptDir & "\WinDivert.dll" ) Or Not FileExists ( @ScriptDir & "\WinDivert64.sys" ) Then
		WRITELOG ( "错误 缺少文件WinDivert.dll或WinDivert64.sys" , 1 )
		Return
	EndIf
	If FileExists ( $SEXE1 ) Then
		$STARGET = $SEXE1
	ElseIf FileExists ( $SEXE2 ) Then
		$STARGET = $SEXE2
	Else
		WRITELOG ( "错误 未找到D3_tcprst可执行文件" , 1 )
		Return
	EndIf
	Local $SPARAMS = ""
	If $QDELAY <> "" Then
		$SPARAMS = "-d " & $QDELAY
	EndIf
	ShellExecute ( $STARGET , $SPARAMS )
EndFunc
Func PRESSKEYANDCLICKWINDOWPOS ( $WINDOWTITLE , $KEY , $COOLDOWNMS )
	If $PORTALACTIONCOOLDOWN <> 0 And TimerDiff ( $PORTALACTIONCOOLDOWN ) < $COOLDOWNMS Then Return
	WRITELOG ( "执行位移解卡" , 1 )
	If Not WinActivate ( $WINDOWTITLE ) Then
		Return
	EndIf
	WinWaitActive ( $WINDOWTITLE , "" , 2 )
	Local $POS = WinGetPos ( $WINDOWTITLE )
	If @error Then
		Return
	EndIf
	Local $X = $POS [ 0 ]
	Local $Y = $POS [ 1 ]
	Local $W = $POS [ 2 ]
	Local $H = $POS [ 3 ]
	Local $POINTS [ 4 ] [ 2 ]
	$POINTS [ 0 ] [ 0 ] = $X + Int ( $W / 4 )
	$POINTS [ 0 ] [ 1 ] = $Y + Int ( $H / 2 )
	$POINTS [ 1 ] [ 0 ] = $X + Int ( $W / 2 )
	$POINTS [ 1 ] [ 1 ] = $Y + Int ( $H * 3 / 4 )
	$POINTS [ 2 ] [ 0 ] = $X + Int ( $W / 2 )
	$POINTS [ 2 ] [ 1 ] = $Y + Int ( $H / 4 )
	$POINTS [ 3 ] [ 0 ] = $X + Int ( $W * 3 / 4 )
	$POINTS [ 3 ] [ 1 ] = $Y + Int ( $H / 2 )
	Local $IDX = Int ( Random ( 0 , 4 ) )
	Local $CLICKX = $POINTS [ $IDX ] [ 0 ]
	Local $CLICKY = $POINTS [ $IDX ] [ 1 ]
	Send ( "{F6}" )
	Sleep ( 50 )
	MouseMove ( $CLICKX , $CLICKY , 0 )
	Sleep ( 50 )
	Send ( $KEY )
	Sleep ( 100 )
	Local $CENTERX = $POS [ 0 ] + Int ( $POS [ 2 ] / 2 )
	Local $CENTERY = $POS [ 1 ] + Int ( $POS [ 3 ] / 2 )
	Local $RADIUS = Int ( $POS [ 3 ] / 2 ) + 4294967256
	DRAGCIRCLE ( $CENTERX , $CENTERY , $RADIUS , "ccw" , 12 )
	DRAGCIRCLE ( $CENTERX , $CENTERY , $RADIUS , "cw" , 12 )
	Send ( "{F6}" )
	$PORTALACTIONCOOLDOWN = TimerInit ( )
EndFunc
Func READSETTING ( $SECTION , $KEY , $DEFAULT = 0 )
	Local $VALUE = IniRead ( $SETTINGSINI , $SECTION , $KEY , $DEFAULT )
	If $KEY = "comboServer" And $VALUE = "" Then
		$VALUE = $DEFAULT
	EndIf
	Return $VALUE
EndFunc
Func SAVESETTING ( $SECTION , $KEY , $DATA )
	IniWrite ( $SETTINGSINI , $SECTION , $KEY , $DATA )
EndFunc
Func SAVESETTINGS ( )
	LOGICCHECK ( )
	SAVESETTING ( "General" , "startWithWindows" , GUICtrlRead ( $CHECKBOXSTARTWITHWINDOWS ) )
	SAVESETTING ( "General" , "startMonitoring" , GUICtrlRead ( $CHECKBOXSTARTMONITORING ) )
	SAVESETTING ( "General" , "startBotting" , GUICtrlRead ( $CHECKBOXSTARTBOTTING ) )
	SAVESETTING ( "General" , "botPath" , GUICtrlRead ( $INPUTBOTEXECUTABLEPATH ) )
	SAVESETTING ( "General" , "btlntPath" , GUICtrlRead ( $INPUTBTLNTPATH ) )
	SAVESETTING ( "General" , "comboServer" , GUICtrlRead ( $COMBOSERVER ) )
	SAVESETTING ( "General" , "checkboxAutoStartBotting" , GUICtrlRead ( $CHECKBOXAUTOSTARTBOTTING ) )
	SAVESETTING ( "General" , "checkboxminD3" , GUICtrlRead ( $CHECKBOXMIND3 ) )
	SAVESETTING ( "General" , "mind3h" , GUICtrlRead ( $INPUTD3HIGH ) )
	SAVESETTING ( "General" , "mind3w" , GUICtrlRead ( $INPUTD3WIDTH ) )
	SAVESETTING ( "General" , "minimizeToTray" , GUICtrlRead ( $CHECKBOXMINIMIZETOTRAY ) )
	SAVESETTING ( "General" , "collapseSettings" , $COLLAPSESETTINGS )
	Local $P = WinGetPos ( $GUIMAIN )
	If $P [ 0 ] <> + 4294935296 Then
		SAVESETTING ( "General" , "winX" , $P [ 0 ] )
		SAVESETTING ( "General" , "winY" , $P [ 1 ] )
	EndIf
	SAVESETTING ( "Advanced" , "showAdvanced" , GUICtrlRead ( $CHECKBOXADVANCED ) )
	SAVESETTING ( "Advanced" , "D3processPriority" , GUICtrlRead ( $COMBOD3PROCESSPRIORITY ) )
	SAVESETTING ( "Advanced" , "RBprocessPriority" , GUICtrlRead ( $COMBORBPROCESSPRIORITY ) )
	For $I = 0 To UBound ( $CPULISTD3 ) + 4294967295
		Local $R = _GUICTRLTREEVIEW_GETCHECKED ( $TREEVIEWD3PROCESSAFFINITY , $CPULISTD3 [ $I ] )
		Switch $R
		Case True
			SAVESETTING ( "Advanced" , "D3CPU" & $I , 1 )
		Case False
			SAVESETTING ( "Advanced" , "D3CPU" & $I , 0 )
		EndSwitch
	Next
	For $I = 0 To UBound ( $CPULISTRB ) + 4294967295
		$R = _GUICTRLTREEVIEW_GETCHECKED ( $TREEVIEWRBPROCESSAFFINITY , $CPULISTRB [ $I ] )
		Switch $R
		Case True
			SAVESETTING ( "Advanced" , "RBCPU" & $I , 1 )
		Case False
			SAVESETTING ( "Advanced" , "RBCPU" & $I , 0 )
		EndSwitch
	Next
	SAVESETTING ( "CrashRecovery" , "restartOnError" , GUICtrlRead ( $CHECKBOXRESTARTONERROR ) )
	SAVESETTING ( "CrashRecovery" , "restartOnlogs" , GUICtrlRead ( $CHECKBOXRESTARTONLOGS ) )
	SAVESETTING ( "CrashRecovery" , "restartOnlogsTime" , GUICtrlRead ( $INPUTRESTARTONLOGSTIME ) )
	SAVESETTING ( "CrashRecovery" , "StrictMode" , GUICtrlRead ( $CHECKBOXSTRICTMODE ) )
	SAVESETTING ( "CrashRecovery" , "startD3battle" , GUICtrlRead ( $CHECKBOXBATTLENET ) )
	SAVESETTING ( "CrashRecovery" , "restartd3ros" , GUICtrlRead ( $RESTARTD3ROS ) )
	SAVESETTING ( "CrashRecovery" , "restartbt" , GUICtrlRead ( $CHECKBOXRESTARTBT ) )
	SAVESETTING ( "CrashRecovery" , "d3Memory" , GUICtrlRead ( $CHECKBOXD3MEMORY ) )
	SAVESETTING ( "CrashRecovery" , "d3MemoryAmt" , GUICtrlRead ( $INPUTD3MEMORY ) )
	SAVESETTING ( "CrashRecovery" , "pushplus" , GUICtrlRead ( $CHECKBOXPUSHPLUS ) )
	SAVESETTING ( "CrashRecovery" , "pptoken" , GUICtrlRead ( $PUSHPLUSTOKEN ) )
	SAVESETTING ( "Screenshots" , "screenshotDeath" , GUICtrlRead ( $CHECKBOXSCREENSHOTDEATH ) )
	SAVESETTING ( "Screenshots" , "screenshotDeathKeep" , GUICtrlRead ( $INPUTSCREENSHOTDEATHKEEP ) )
	SAVESETTING ( "Screenshots" , "screenshotDeathPath" , GUICtrlRead ( $INPUTSCREENSHOTDEATHPATH ) )
	SAVESETTING ( "Screenshots" , "screenshotPeriodic" , GUICtrlRead ( $CHECKBOXSCREENSHOTPERIODIC ) )
	SAVESETTING ( "Screenshots" , "screenshotPeriodicKeep" , GUICtrlRead ( $INPUTSCREENSHOTPERIODICKEEP ) )
	SAVESETTING ( "Screenshots" , "screenshotPeriodicTime" , GUICtrlRead ( $INPUTSCREENSHOTPERIODICTIME ) )
	SAVESETTING ( "Screenshots" , "screenshotPeriodicPath" , GUICtrlRead ( $INPUTSCREENSHOTPERIODICPATH ) )
	SAVESETTING ( "Screenshots" , "screenshotCropCoords" , GUICtrlRead ( $INPUTSCREENSHOTCROP ) )
	SAVESETTING ( "Screenshots" , "screenshotCrop" , GUICtrlRead ( $RADIOSCREENSHOTFULL ) )
	SAVESETTING ( "Screenshots" , "screenshotFail" , GUICtrlRead ( $CHECKBOXSCREENSHOTFAIL ) )
	SAVESETTING ( "Screenshots" , "screenshotFailKeep" , GUICtrlRead ( $INPUTSCREENSHOTFAILKEEP ) )
	SAVESETTING ( "Screenshots" , "screenshotFailPath" , GUICtrlRead ( $INPUTSCREENSHOTFAILPATH ) )
	SAVESETTING ( "Screenshots" , "screenshotError" , GUICtrlRead ( $CHECKBOXSCREENSHOTERROR ) )
	SAVESETTING ( "Screenshots" , "screenshotErrorKeep" , GUICtrlRead ( $INPUTSCREENSHOTERRORKEEP ) )
	SAVESETTING ( "Screenshots" , "screenshotErrorPath" , GUICtrlRead ( $INPUTSCREENSHOTERRORPATH ) )
	SAVETRIGGERS ( )
EndFunc
Func LOADSETTINGS ( )
	IniDelete ( $SETTINGSINI , "Screenshots" , "screenshotPath" )
	IniDelete ( $SETTINGSINI , "Advanced" , "processPriority" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu0" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu1" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu2" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu3" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu4" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu5" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu6" )
	IniDelete ( $SETTINGSINI , "Advanced" , "cpu7" )
	IniDelete ( $SETTINGSINI , "TriggersTEMP" )
	IniDelete ( $SETTINGSINI , "General" , "diabloTitle" )
	GUICtrlSetState ( $CHECKBOXSTARTWITHWINDOWS , READSETTING ( "General" , "startWithWindows" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXSTARTMONITORING , READSETTING ( "General" , "startMonitoring" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXSTARTBOTTING , READSETTING ( "General" , "startBotting" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTBOTEXECUTABLEPATH , READSETTING ( "General" , "botPath" , "" ) )
	GUICtrlSetData ( $INPUTBTLNTPATH , READSETTING ( "General" , "btlntPath" , "" ) )
	GUICtrlSetData ( $COMBOSERVER , READSETTING ( "General" , "comboServer" , "国服" ) )
	GUICtrlSetState ( $CHECKBOXAUTOSTARTBOTTING , READSETTING ( "General" , "checkboxAutoStartBotting" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXMIND3 , READSETTING ( "General" , "checkboxminD3" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTD3HIGH , READSETTING ( "General" , "mind3h" , "603" ) )
	GUICtrlSetData ( $INPUTD3WIDTH , READSETTING ( "General" , "mind3w" , "1072" ) )
	GUICtrlSetState ( $CHECKBOXMINIMIZETOTRAY , READSETTING ( "General" , "minimizeToTray" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXADVANCED , READSETTING ( "Advanced" , "showAdvanced" , $GUI_UNCHECKED ) )
	If GUICtrlRead ( $CHECKBOXADVANCED ) = $GUI_UNCHECKED Then HIDEADVANCED ( )
	GUICtrlSetData ( $COMBOD3PROCESSPRIORITY , READSETTING ( "Advanced" , "D3processPriority" , LOADLANGUAGE ( "gui_process_normal" ) ) )
	GUICtrlSetData ( $COMBORBPROCESSPRIORITY , READSETTING ( "Advanced" , "RBprocessPriority" , LOADLANGUAGE ( "gui_process_normal" ) ) )
	For $I = 0 To UBound ( $CPULISTD3 ) + 4294967295
		Local $R = READSETTING ( "Advanced" , "D3CPU" & $I , 1 )
		Switch $R
		Case 1
			_GUICTRLTREEVIEW_SETCHECKED ( $TREEVIEWD3PROCESSAFFINITY , $CPULISTD3 [ $I ] , True )
		Case 0
			_GUICTRLTREEVIEW_SETCHECKED ( $TREEVIEWD3PROCESSAFFINITY , $CPULISTD3 [ $I ] , False )
		EndSwitch
	Next
	For $I = 0 To UBound ( $CPULISTRB ) + 4294967295
		$R = READSETTING ( "Advanced" , "RBCPU" & $I , 1 )
		Switch $R
		Case 1
			_GUICTRLTREEVIEW_SETCHECKED ( $TREEVIEWRBPROCESSAFFINITY , $CPULISTRB [ $I ] , True )
		Case 0
			_GUICTRLTREEVIEW_SETCHECKED ( $TREEVIEWRBPROCESSAFFINITY , $CPULISTRB [ $I ] , False )
		EndSwitch
	Next
	GUICtrlSetState ( $CHECKBOXRESTARTONERROR , READSETTING ( "CrashRecovery" , "restartOnError" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXRESTARTONLOGS , READSETTING ( "CrashRecovery" , "restartOnlogs" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTRESTARTONLOGSTIME , READSETTING ( "CrashRecovery" , "restartOnlogsTime" , 30 ) )
	GUICtrlSetState ( $CHECKBOXSTRICTMODE , READSETTING ( "CrashRecovery" , "StrictMode" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXBATTLENET , READSETTING ( "CrashRecovery" , "startD3battle" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $RESTARTD3ROS , READSETTING ( "CrashRecovery" , "restartd3ros" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXRESTARTBT , READSETTING ( "CrashRecovery" , "restartbt" , $GUI_UNCHECKED ) )
	GUICtrlSetState ( $CHECKBOXD3MEMORY , READSETTING ( "CrashRecovery" , "d3Memory" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTD3MEMORY , READSETTING ( "CrashRecovery" , "d3MemoryAmt" , 8192 ) )
	GUICtrlSetState ( $CHECKBOXPUSHPLUS , READSETTING ( "CrashRecovery" , "pushplus" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $PUSHPLUSTOKEN , READSETTING ( "CrashRecovery" , "pptoken" , "" ) )
	GUICtrlSetState ( $CHECKBOXSCREENSHOTDEATH , READSETTING ( "Screenshots" , "screenshotDeath" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTSCREENSHOTDEATHKEEP , READSETTING ( "Screenshots" , "screenshotDeathKeep" , 0 ) )
	GUICtrlSetData ( $INPUTSCREENSHOTDEATHPATH , READSETTING ( "Screenshots" , "screenshotDeathPath" , "" ) )
	GUICtrlSetState ( $CHECKBOXSCREENSHOTPERIODIC , READSETTING ( "Screenshots" , "screenshotPeriodic" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTSCREENSHOTPERIODICKEEP , READSETTING ( "Screenshots" , "screenshotPeriodicKeep" , 0 ) )
	GUICtrlSetData ( $INPUTSCREENSHOTPERIODICTIME , READSETTING ( "Screenshots" , "screenshotPeriodicTime" , 1 ) )
	GUICtrlSetData ( $INPUTSCREENSHOTPERIODICPATH , READSETTING ( "Screenshots" , "screenshotPeriodicPath" , "" ) )
	GUICtrlSetData ( $INPUTSCREENSHOTCROP , READSETTING ( "Screenshots" , "screenshotCropCoords" , "0,0,0,0" ) )
	If READSETTING ( "Screenshots" , "screenshotCrop" , $GUI_CHECKED ) = $GUI_CHECKED Then
		GUICtrlSetState ( $RADIOSCREENSHOTFULL , $GUI_CHECKED )
		GUICtrlSetState ( $INPUTSCREENSHOTCROP , $GUI_DISABLE )
	Else
		GUICtrlSetState ( $RADIOSCREENSHOTCUSTOM , $GUI_CHECKED )
		GUICtrlSetState ( $INPUTSCREENSHOTCROP , $GUI_ENABLE )
	EndIf
	GUICtrlSetState ( $CHECKBOXSCREENSHOTFAIL , READSETTING ( "Screenshots" , "screenshotFail" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTSCREENSHOTFAILKEEP , READSETTING ( "Screenshots" , "screenshotFailKeep" , 0 ) )
	GUICtrlSetData ( $INPUTSCREENSHOTFAILPATH , READSETTING ( "Screenshots" , "screenshotFailPath" , "" ) )
	GUICtrlSetState ( $CHECKBOXSCREENSHOTERROR , READSETTING ( "Screenshots" , "screenshotError" , $GUI_UNCHECKED ) )
	GUICtrlSetData ( $INPUTSCREENSHOTERRORKEEP , READSETTING ( "Screenshots" , "screenshotErrorKeep" , 0 ) )
	GUICtrlSetData ( $INPUTSCREENSHOTERRORPATH , READSETTING ( "Screenshots" , "screenshotErrorPath" , "" ) )
	Local $X = READSETTING ( "General" , "winX" , "null" )
	Local $Y = READSETTING ( "General" , "winY" , "null" )
	If $X <> "null" And $Y <> "null" And $X <> + 4294935296 And $Y <> + 4294935296 Then
		WinMove ( $GUIMAIN , "" , $X , $Y )
	EndIf
	Local $C = READSETTING ( "General" , "collapseSettings" , 0 )
	If $C = 1 Then
		WinMove ( $GUIMAIN , "" , $X , $Y , 325 )
		GUICtrlSetData ( $BUTTONTOGGLECONFIG , LOADLANGUAGE ( "gui_main_button_config" ) & " >>>" )
		$COLLAPSESETTINGS = 1
	Else
		$COLLAPSESETTINGS = 0
	EndIf
	LOADTRIGGERS ( )
EndFunc
Func LOGICCHECK ( )
	Local $CHECKPASSED = 1
	If Not FileExists ( GUICtrlRead ( $INPUTBOTEXECUTABLEPATH ) ) And GUICtrlRead ( $INPUTBOTEXECUTABLEPATH ) <> "" Then
		GUICtrlSetData ( $INPUTBOTEXECUTABLEPATH , "" )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_rbpath" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $INPUTRESTARTONLOGSTIME ) < 1 Then
		GUICtrlSetData ( $INPUTRESTARTONLOGSTIME , 10 )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_inactivity" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $RADIOSCREENSHOTCUSTOM ) = $GUI_CHECKED Then
		Local $A = StringSplit ( GUICtrlRead ( $INPUTSCREENSHOTCROP ) , "," )
		If $A [ 0 ] <> 4 Then
			GUICtrlSetData ( $INPUTSCREENSHOTCROP , "0,0,0,0" )
			MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_customcrop" ) , 60 , $GUIMAIN )
			$CHECKPASSED = 0
		EndIf
	EndIf
	If GUICtrlRead ( $INPUTSCREENSHOTPERIODICTIME ) < 1 Then
		GUICtrlSetData ( $INPUTSCREENSHOTPERIODICTIME , 1 )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_screenshottimer" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $INPUTSCREENSHOTDEATHKEEP ) < 0 Then
		GUICtrlSetData ( $INPUTSCREENSHOTDEATHKEEP , 0 )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_keepdeath" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $INPUTSCREENSHOTPERIODICKEEP ) < 0 Then
		GUICtrlSetData ( $INPUTSCREENSHOTPERIODICKEEP , 0 )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_keepperiodic" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $INPUTSCREENSHOTFAILKEEP ) < 0 Then
		GUICtrlSetData ( $INPUTSCREENSHOTFAILKEEP , 0 )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_keepfail" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $CHECKBOXSCREENSHOTPERIODIC ) = $GUI_CHECKED And Not FileExists ( GUICtrlRead ( $INPUTSCREENSHOTPERIODICPATH ) ) Then
		GUICtrlSetData ( $INPUTSCREENSHOTPERIODICPATH , "" )
		GUICtrlSetState ( $CHECKBOXSCREENSHOTPERIODIC , $GUI_UNCHECKED )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_periodicpath" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $CHECKBOXSCREENSHOTDEATH ) = $GUI_CHECKED And Not FileExists ( GUICtrlRead ( $INPUTSCREENSHOTDEATHPATH ) ) Then
		GUICtrlSetData ( $INPUTSCREENSHOTDEATHPATH , "" )
		GUICtrlSetState ( $CHECKBOXSCREENSHOTDEATH , $GUI_UNCHECKED )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_deathpath" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $CHECKBOXSCREENSHOTFAIL ) = $GUI_CHECKED And Not FileExists ( GUICtrlRead ( $INPUTSCREENSHOTFAILPATH ) ) Then
		GUICtrlSetData ( $INPUTSCREENSHOTFAILPATH , "" )
		GUICtrlSetState ( $CHECKBOXSCREENSHOTFAIL , $GUI_UNCHECKED )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_failpath" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	If GUICtrlRead ( $CHECKBOXSCREENSHOTERROR ) = $GUI_CHECKED And Not FileExists ( GUICtrlRead ( $INPUTSCREENSHOTERRORPATH ) ) Then
		GUICtrlSetData ( $INPUTSCREENSHOTERRORPATH , "" )
		GUICtrlSetState ( $CHECKBOXSCREENSHOTERROR , $GUI_UNCHECKED )
		MsgBox ( 48 , LOADLANGUAGE ( "string_invalidvalue" ) , LOADLANGUAGE ( "error_logic_errorpath" ) , 60 , $GUIMAIN )
		$CHECKPASSED = 0
	EndIf
	Return $CHECKPASSED
EndFunc
Func _STRINGSIZE ( $STEXT , $ISIZE = Default , $IWEIGHT = Default , $IATTRIB = Default , $SNAME = Default , $IWIDTH = 0 )
	Local $HWND , $HFONT , $HDC , $OFONT , $TSIZE , $HGUI , $HTEXT_LABEL , $STEST_LINE
	Local $ILINE_COUNT , $ILINE_WIDTH , $IWRAP_COUNT , $ILAST_WORD
	Local $ASLINES [ 1 ] , $AVSIZE_INFO [ 4 ] , $AIPOS [ 4 ]
	If Not IsString ( $STEXT ) Then Return SetError ( 1 , 1 , 0 )
	If Not IsNumber ( $ISIZE ) And $ISIZE <> Default Then Return SetError ( 1 , 2 , 0 )
	If Not IsInt ( $IWEIGHT ) And $IWEIGHT <> Default Then Return SetError ( 1 , 3 , 0 )
	If Not IsInt ( $IATTRIB ) And $IATTRIB <> Default Then Return SetError ( 1 , 4 , 0 )
	If Not IsString ( $SNAME ) And $SNAME <> Default Then Return SetError ( 1 , 5 , 0 )
	If Not IsNumber ( $IWIDTH ) Then Return SetError ( 1 , 6 , 0 )
	$HGUI = GUICreate ( "" , 1200 , 500 , 10 , 10 )
	If $HGUI = 0 Then Return SetError ( 2 , 0 , 0 )
	GUISetFont ( $ISIZE , $IWEIGHT , $IATTRIB , $SNAME )
	$AVSIZE_INFO [ 0 ] = $STEXT
	If StringInStr ( $STEXT , @CRLF ) = 0 Then StringRegExpReplace ( $STEXT , "[x0a|x0d]" , @CRLF )
	$ASLINES = StringSplit ( $STEXT , @CRLF , 1 )
	$HTEXT_LABEL = GUICtrlCreateLabel ( $STEXT , 10 , 10 )
	$AIPOS = ControlGetPos ( $HGUI , "" , $HTEXT_LABEL )
	If @error Then
		MsgBox ( 0 , "StringSize Error" , $STEXT )
		Return 0
	EndIf
	GUICtrlDelete ( $HTEXT_LABEL )
	$AVSIZE_INFO [ 1 ] = ( $AIPOS [ 3 ] + 4294967288 ) / $ASLINES [ 0 ]
	$AVSIZE_INFO [ 2 ] = $AIPOS [ 2 ]
	$AVSIZE_INFO [ 3 ] = $AIPOS [ 3 ] + 4294967292
	If $AIPOS [ 2 ] > $IWIDTH And $IWIDTH > 0 Then
		$AVSIZE_INFO [ 0 ] = ""
		$AVSIZE_INFO [ 2 ] = $IWIDTH
		$ILINE_COUNT = 0
		For $J = 1 To $ASLINES [ 0 ]
			$HTEXT_LABEL = GUICtrlCreateLabel ( $ASLINES [ $J ] , 10 , 10 )
			$AIPOS = ControlGetPos ( $HGUI , "" , $HTEXT_LABEL )
			GUICtrlDelete ( $HTEXT_LABEL )
			If $AIPOS [ 2 ] < $IWIDTH Then
				$ILINE_COUNT += 1
				$AVSIZE_INFO [ 0 ] &= $ASLINES [ $J ] & @CRLF
			Else
				$HTEXT_LABEL = GUICtrlCreateLabel ( "" , 0 , 0 )
				$HWND = ControlGetHandle ( $HGUI , "" , $HTEXT_LABEL )
				$HFONT = _SENDMESSAGE ( $HWND , $WM_GETFONT )
				$HDC = _WINAPI_GETDC ( $HWND )
				$OFONT = _WINAPI_SELECTOBJECT ( $HDC , $HFONT )
				If $OFONT = 0 Then Return SetError ( 3 , 0 , 0 )
				$IWRAP_COUNT = 0
				While 1
					$ILINE_WIDTH = 0
					$ILAST_WORD = 0
					For $I = 1 To StringLen ( $ASLINES [ $J ] )
						If StringMid ( $ASLINES [ $J ] , $I , 1 ) = " " Then $ILAST_WORD = $I + 4294967295
						$STEST_LINE = StringMid ( $ASLINES [ $J ] , 1 , $I )
						GUICtrlSetData ( $HTEXT_LABEL , $STEST_LINE )
						$TSIZE = _WINAPI_GETTEXTEXTENTPOINT32 ( $HDC , $STEST_LINE )
						$ILINE_WIDTH = DllStructGetData ( $TSIZE , "X" )
						If $ILINE_WIDTH >= $IWIDTH - Int ( $ISIZE / 2 ) Then ExitLoop
					Next
					If $I > StringLen ( $ASLINES [ $J ] ) Then
						$IWRAP_COUNT += 1
						$AVSIZE_INFO [ 0 ] &= $STEST_LINE & @CRLF
						ExitLoop
					Else
						$IWRAP_COUNT += 1
						If $ILAST_WORD = 0 Then
							GUIDelete ( $HGUI )
							Return SetError ( 4 , 0 , 0 )
						EndIf
						$AVSIZE_INFO [ 0 ] &= StringLeft ( $STEST_LINE , $ILAST_WORD ) & @CRLF
						$ASLINES [ $J ] = StringTrimLeft ( $ASLINES [ $J ] , $ILAST_WORD )
						$ASLINES [ $J ] = StringStripWS ( $ASLINES [ $J ] , 1 )
					EndIf
				WEnd
				$ILINE_COUNT += $IWRAP_COUNT
				_WINAPI_RELEASEDC ( $HWND , $HDC )
				GUICtrlDelete ( $HTEXT_LABEL )
			EndIf
		Next
		$AVSIZE_INFO [ 3 ] = ( $ILINE_COUNT * $AVSIZE_INFO [ 1 ] ) + 4
	EndIf
	GUIDelete ( $HGUI )
	GUISwitch ( $GUIMAIN )
	Return $AVSIZE_INFO [ 2 ]
EndFunc
Func _STRINGSIZET ( $STEXT , $ISIZE = Default , $IWEIGHT = Default , $IATTRIB = Default , $SNAME = Default , $IWIDTH = 0 )
	Local $HWND , $HFONT , $HDC , $OFONT , $TSIZE , $HGUI , $HTEXT_LABEL , $STEST_LINE
	Local $ILINE_COUNT , $ILINE_WIDTH , $IWRAP_COUNT , $ILAST_WORD
	Local $ASLINES [ 1 ] , $AVSIZE_INFO [ 4 ] , $AIPOS [ 4 ]
	If Not IsString ( $STEXT ) Then Return SetError ( 1 , 1 , 0 )
	If Not IsNumber ( $ISIZE ) And $ISIZE <> Default Then Return SetError ( 1 , 2 , 0 )
	If Not IsInt ( $IWEIGHT ) And $IWEIGHT <> Default Then Return SetError ( 1 , 3 , 0 )
	If Not IsInt ( $IATTRIB ) And $IATTRIB <> Default Then Return SetError ( 1 , 4 , 0 )
	If Not IsString ( $SNAME ) And $SNAME <> Default Then Return SetError ( 1 , 5 , 0 )
	If Not IsNumber ( $IWIDTH ) Then Return SetError ( 1 , 6 , 0 )
	$HGUI = GUICreate ( "" , 1200 , 500 , 10 , 10 )
	If $HGUI = 0 Then Return SetError ( 2 , 0 , 0 )
	GUISetFont ( $ISIZE , $IWEIGHT , $IATTRIB , $SNAME )
	$AVSIZE_INFO [ 0 ] = $STEXT
	If StringInStr ( $STEXT , @CRLF ) = 0 Then StringRegExpReplace ( $STEXT , "[x0a|x0d]" , @CRLF )
	$ASLINES = StringSplit ( $STEXT , @CRLF , 1 )
	$HTEXT_LABEL = GUICtrlCreateLabel ( $STEXT , 10 , 10 )
	$AIPOS = ControlGetPos ( $HGUI , "" , $HTEXT_LABEL )
	GUICtrlDelete ( $HTEXT_LABEL )
	$AVSIZE_INFO [ 1 ] = ( $AIPOS [ 3 ] + 4294967288 ) / $ASLINES [ 0 ]
	$AVSIZE_INFO [ 2 ] = $AIPOS [ 2 ]
	$AVSIZE_INFO [ 3 ] = $AIPOS [ 3 ] + 4294967292
	If $AIPOS [ 2 ] > $IWIDTH And $IWIDTH > 0 Then
		$AVSIZE_INFO [ 0 ] = ""
		$AVSIZE_INFO [ 2 ] = $IWIDTH
		$ILINE_COUNT = 0
		For $J = 1 To $ASLINES [ 0 ]
			$HTEXT_LABEL = GUICtrlCreateLabel ( $ASLINES [ $J ] , 10 , 10 )
			$AIPOS = ControlGetPos ( $HGUI , "" , $HTEXT_LABEL )
			GUICtrlDelete ( $HTEXT_LABEL )
			If $AIPOS [ 2 ] < $IWIDTH Then
				$ILINE_COUNT += 1
				$AVSIZE_INFO [ 0 ] &= $ASLINES [ $J ] & @CRLF
			Else
				$HTEXT_LABEL = GUICtrlCreateLabel ( "" , 0 , 0 )
				$HWND = ControlGetHandle ( $HGUI , "" , $HTEXT_LABEL )
				$HFONT = _SENDMESSAGE ( $HWND , $WM_GETFONT )
				$HDC = _WINAPI_GETDC ( $HWND )
				$OFONT = _WINAPI_SELECTOBJECT ( $HDC , $HFONT )
				If $OFONT = 0 Then Return SetError ( 3 , 0 , 0 )
				$IWRAP_COUNT = 0
				While 1
					$ILINE_WIDTH = 0
					$ILAST_WORD = 0
					For $I = 1 To StringLen ( $ASLINES [ $J ] )
						If StringMid ( $ASLINES [ $J ] , $I , 1 ) = " " Then $ILAST_WORD = $I + 4294967295
						$STEST_LINE = StringMid ( $ASLINES [ $J ] , 1 , $I )
						GUICtrlSetData ( $HTEXT_LABEL , $STEST_LINE )
						$TSIZE = _WINAPI_GETTEXTEXTENTPOINT32 ( $HDC , $STEST_LINE )
						$ILINE_WIDTH = DllStructGetData ( $TSIZE , "X" )
						If $ILINE_WIDTH >= $IWIDTH - Int ( $ISIZE / 2 ) Then ExitLoop
					Next
					If $I > StringLen ( $ASLINES [ $J ] ) Then
						$IWRAP_COUNT += 1
						$AVSIZE_INFO [ 0 ] &= $STEST_LINE & @CRLF
						ExitLoop
					Else
						$IWRAP_COUNT += 1
						If $ILAST_WORD = 0 Then
							GUIDelete ( $HGUI )
							Return SetError ( 4 , 0 , 0 )
						EndIf
						$AVSIZE_INFO [ 0 ] &= StringLeft ( $STEST_LINE , $ILAST_WORD ) & @CRLF
						$ASLINES [ $J ] = StringTrimLeft ( $ASLINES [ $J ] , $ILAST_WORD )
						$ASLINES [ $J ] = StringStripWS ( $ASLINES [ $J ] , 1 )
					EndIf
				WEnd
				$ILINE_COUNT += $IWRAP_COUNT
				_WINAPI_RELEASEDC ( $HWND , $HDC )
				GUICtrlDelete ( $HTEXT_LABEL )
			EndIf
		Next
		$AVSIZE_INFO [ 3 ] = ( $ILINE_COUNT * $AVSIZE_INFO [ 1 ] ) + 4
	EndIf
	GUIDelete ( $HGUI )
	GUISwitch ( $GUITRIGGERS )
	Return $AVSIZE_INFO [ 2 ]
EndFunc
Func _FILESEARCH ( $SZMASK , $NOPTION = 0 )
	Local $SZROOT = ""
	Local $HFILE = 0
	Local $SZBUFFER = ""
	Local $SZRETURN = ""
	Local $SZPATHLIST = "*"
	Dim $ANULL [ 1 ]
	If Not StringInStr ( $SZMASK , "\" ) Then
		$SZROOT = @ScriptDir & "\"
	Else
		While StringInStr ( $SZMASK , "\" )
			$SZROOT = $SZROOT & StringLeft ( $SZMASK , StringInStr ( $SZMASK , "\" ) )
			$SZMASK = StringTrimLeft ( $SZMASK , StringInStr ( $SZMASK , "\" ) )
		WEnd
	EndIf
	If $NOPTION = 0 Then
		_FILESEARCHUTIL ( $SZROOT , $SZMASK , $SZRETURN )
	Else
		While 1
			$HFILE = FileFindFirstFile ( $SZROOT & "*.*" )
			If $HFILE >= 0 Then
				$SZBUFFER = FileFindNextFile ( $HFILE )
				While Not @error
					If $SZBUFFER <> "." And $SZBUFFER <> ".." And StringInStr ( FileGetAttrib ( $SZROOT & $SZBUFFER ) , "D" ) Then $SZPATHLIST = $SZPATHLIST & $SZROOT & $SZBUFFER & "*"
					$SZBUFFER = FileFindNextFile ( $HFILE )
				WEnd
				FileClose ( $HFILE )
			EndIf
			_FILESEARCHUTIL ( $SZROOT , $SZMASK , $SZRETURN )
			If $SZPATHLIST == "*" Then ExitLoop
			$SZPATHLIST = StringTrimLeft ( $SZPATHLIST , 1 )
			$SZROOT = StringLeft ( $SZPATHLIST , StringInStr ( $SZPATHLIST , "*" ) + 4294967295 ) & "\"
			$SZPATHLIST = StringTrimLeft ( $SZPATHLIST , StringInStr ( $SZPATHLIST , "*" ) + 4294967295 )
		WEnd
	EndIf
	If $SZRETURN = "" Then
		$ANULL [ 0 ] = 0
		Return $ANULL
	Else
		Return StringSplit ( StringTrimRight ( $SZRETURN , 1 ) , "*" )
	EndIf
EndFunc
Func _FILESEARCHUTIL ( ByRef $ROOT , ByRef $MASK , ByRef $RETURN )
	Local $HFILE = FileFindFirstFile ( $ROOT & $MASK )
	If $HFILE >= 0 Then
		Local $SZBUFFER = FileFindNextFile ( $HFILE )
		While Not @error
			If $SZBUFFER <> "." And $SZBUFFER <> ".." Then $RETURN = $RETURN & $ROOT & $SZBUFFER & "*"
			$SZBUFFER = FileFindNextFile ( $HFILE )
		WEnd
		FileClose ( $HFILE )
	EndIf
EndFunc

