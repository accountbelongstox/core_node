	Local $ACALL = DllCall ( "shlwapi.dll" , "bool" , "PathAddExtensionW" , "struct*" , $TPATH , "wstr" , $SEXT )
	If @error Then Return SetError ( @error , @extended , "" )
	Return SetExtended ( $ACALL [ 0 ] , DllStructGetData ( $TPATH , 1 ) )
EndFunc
