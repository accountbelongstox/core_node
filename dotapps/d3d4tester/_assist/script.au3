#EndRegion Includes
#Region Initial Setup
_SINGLETON ( "RBAssist" )
If _ISPRESSED ( 10 ) Then
	$SKIPSTARTUP = True
Else
	$SKIPSTARTUP = False
EndIf
FileInstall ( "lang_cn.ini" , "lang_cn.ini" , 1 )
Global Const $SETTINGSINI = "RBAssistSettings.ini"
If FileGetEncoding ( $SETTINGSINI ) <> 32 Then
	$OLDF = FileRead ( $SETTINGSINI )
	FileDelete ( $SETTINGSINI )
	$NEWF = FileOpen ( $SETTINGSINI , 2 + 32 )
	FileWrite ( $NEWF , $OLDF )
	FileClose ( $NEWF )
EndIf
Global $CURLANG = READSETTING ( "General" , "language" , "cn" )
$LANGFILENAME = "lang_" & $CURLANG & ".ini"
If Not FileExists ( $LANGFILENAME ) Then
	$FILE = FileOpen ( $LANGFILENAME , 2 + 32 )
	If $FILE = + 4294967295 Then
		MsgBox ( 16 , "Error" , "无法创建汉化文件 " & $LANGFILENAME )
		Exit
	EndIf
	FileWrite ( $FILE , "[lang]" & @CRLF )
	FileWrite ( $FILE , "day_all=每日" & @CRLF )
	FileWrite ( $FILE , "day_Friday=星期五" & @CRLF )
	FileWrite ( $FILE , "day_Monday=星期一" & @CRLF )
	FileWrite ( $FILE , "day_Saturday=星期六" & @CRLF )
	FileWrite ( $FILE , "day_Sunday=星期天" & @CRLF )
	FileWrite ( $FILE , "day_Thursday=星期四" & @CRLF )
	FileWrite ( $FILE , "day_Tuesday=星期二" & @CRLF )
	FileWrite ( $FILE , "day_Wednesday=星期三" & @CRLF )
	FileWrite ( $FILE , "error_elevate=因为UAC设置无法以管理员模式运行." & @CRLF )
	FileWrite ( $FILE , "error_logic_customcrop=您必须为自定义裁剪的4个坐标，以逗号分隔。该值已重置为默认值0,0,0,0，" & @CRLF )
	FileWrite ( $FILE , "error_logic_deathpath=死亡截图路径不再存在。该值已清除。" & @CRLF )
	FileWrite ( $FILE , "error_logic_errorpath=错误截图路径不再存在。该值已清除。" & @CRLF )
	FileWrite ( $FILE , "error_logic_failpath=失败的屏幕截图路径不再存在。该值已清除。" & @CRLF )
	FileWrite ( $FILE , "error_logic_inactivity=X分钟内无日志活动后重新启动的最小设置为1分钟。已将其重置为默认的10分钟。" & @CRLF )
	FileWrite ( $FILE , "error_logic_keepdeath=保持X死亡截图不能为负数。该值已重置为默认值0。" & @CRLF )
	FileWrite ( $FILE , "error_logic_keepfail=保持X失败的屏幕截图不能为负。该值已重置为默认值0。" & @CRLF )
	FileWrite ( $FILE , "error_logic_keepperiodic=保持X个定期屏幕截图不能为负。该值已重置为默认值0。" & @CRLF )
