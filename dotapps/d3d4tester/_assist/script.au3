Func __GUICTRLLISTVIEW_REVERSECOLORORDER ( $ICOLOR )
	Local $SH = Hex ( String ( $ICOLOR ) , 6 )
	Return "0x" & StringMid ( $SH , 5 , 2 ) & StringMid ( $SH , 3 , 2 ) & StringMid ( $SH , 1 , 2 )
EndFunc
