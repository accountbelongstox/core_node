	If $IFLAG = $WINHTTP_FLAG_ASYNC Then _WINHTTPSETOPTION ( $ACALL [ 0 ] , $WINHTTP_OPTION_CONTEXT_VALUE , $WINHTTP_FLAG_ASYNC )
	Return $ACALL [ 0 ]
