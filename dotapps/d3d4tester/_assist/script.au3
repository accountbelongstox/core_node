	If Not __DLL ( "credui.dll" ) Then Return SetError ( 103 , 0 , 0 )
	Local $TINFO = DllStructCreate ( "dword;hwnd;ptr;ptr;ptr;wchar[" & ( StringLen ( $SMESSAGE ) + 1 ) & "];wchar[" & ( StringLen ( $SCAPTION ) + 1 ) & "]" )
