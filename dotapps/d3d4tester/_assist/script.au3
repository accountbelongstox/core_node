	$SDISPLAYCHAR = StringLeft ( $SDISPLAYCHAR , 1 )
	If Asc ( $SDISPLAYCHAR ) = 48 Then
		_SENDMESSAGE ( $HWND , $EM_SETPASSWORDCHAR )
	Else
		_SENDMESSAGE ( $HWND , $EM_SETPASSWORDCHAR , Asc ( $SDISPLAYCHAR ) )
