		DllStructSetData ( $TBUFFER , "Text" , $STEXT )
	Else
		$PBUFFER = + 4294967295
		$IBUFFER = 0
	EndIf
	Local $TITEM = $__G_TLISTVIEWITEM
	Local $IMASK = $LVIF_TEXT
	If $IIMAGE <> + 4294967295 Then $IMASK = BitOR ( $IMASK , $LVIF_IMAGE )
