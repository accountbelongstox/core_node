	If Not IsHWnd ( $HWND ) Then $HWND = GUICtrlGetHandle ( $HWND )
	Local $TRECT = DllStructCreate ( $TAGRECT )
	_SENDMESSAGE ( $HWND , $CB_GETDROPPEDCONTROLRECT , 0 , $TRECT , 0 , "wparam" , "struct*" )
