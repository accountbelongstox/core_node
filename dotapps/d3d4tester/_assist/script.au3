Func _GUICTRLLISTVIEW_SIMPLESORT ( $HWND , ByRef $VSORTSENSE , $ICOL , $BTOGGLESENSE = True )
	Local $IITEMCOUNT = _GUICTRLLISTVIEW_GETITEMCOUNT ( $HWND )
	If $IITEMCOUNT Then
		Local $IDESCENDING = 0
