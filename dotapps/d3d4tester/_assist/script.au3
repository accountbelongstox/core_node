Global $APORTALKEYS [ 2 ] = [ "x1_Heaven_PandemoniumPortal" , "g_Portal_Square_Blue" ]
Global $SEXTRA = READSETTING ( "General" , "portal_id" , "" )
If $SEXTRA <> "" Then
	Local $AEXTRA = StringSplit ( $SEXTRA , "," , $STR_NOCOUNT )
	Local $IBASECOUNT = UBound ( $APORTALKEYS )
	Local $IVALIDCOUNT = 0
	For $I = 0 To UBound ( $AEXTRA ) + 4294967295
		If StringStripWS ( $AEXTRA [ $I ] , $STR_STRIPALL ) <> "" Then
			$IVALIDCOUNT += 1
		EndIf
	Next
	ReDim $APORTALKEYS [ $IBASECOUNT + $IVALIDCOUNT ]
	Local $J = 0
	For $I = 0 To UBound ( $AEXTRA ) + 4294967295
		Local $SVAL = StringStripWS ( $AEXTRA [ $I ] , $STR_STRIPALL )
		If $SVAL <> "" Then
			$APORTALKEYS [ $IBASECOUNT + $J ] = $SVAL
			$J += 1
		EndIf
	Next
EndIf
Global $URSHI = READSETTING ( "General" , "urshi" , "" )
Global $URSHITHRESHOLD
If $URSHI <> "" Then
	$URSHITHRESHOLD = StringSplit ( $URSHI , "," , 1 )
	If UBound ( $URSHITHRESHOLD ) <> 4 Then Global $URSHITHRESHOLD = [ 3 , 100 , 6 , 140 ]
Else
	Global $URSHITHRESHOLD = [ 3 , 100 , 6 , 140 ]
EndIf
Global $FIN_ILL = READSETTING ( "General" , "finishill" , "" )
Global $FIN_ILLTHRESHOLD
If $FIN_ILL <> "" Then
	$FIN_ILLTHRESHOLD = StringSplit ( $FIN_ILL , "," , 1 )
	If UBound ( $FIN_ILLTHRESHOLD ) <> 3 Then Global $FIN_ILLTHRESHOLD = [ 2 , 100 , 25 ]
Else
	Global $FIN_ILLTHRESHOLD = [ 2 , 100 , 25 ]
EndIf
Global $FIND_ILL = READSETTING ( "General" , "findill" , "" )
Global $FIND_ILLTHRESHOLD
If $FIND_ILL <> "" Then
	$FIND_ILLTHRESHOLD = StringSplit ( $FIND_ILL , "," , 1 )
	If UBound ( $FIND_ILLTHRESHOLD ) <> 4 Then Global $FIND_ILLTHRESHOLD = [ 3 , 60 , 1 , 2 ]
Else
	Global $FIND_ILLTHRESHOLD = [ 3 , 60 , 1 , 2 ]
EndIf
Global $FIGHTNUM = READSETTING ( "General" , "fight" , "" )
Global $FIGHTTHRESHOLD
If $FIGHTNUM = "" Then
	$FIGHTTHRESHOLD = 280
ElseIf StringIsDigit ( $FIGHTNUM ) Then
	$FIGHTTHRESHOLD = Number ( $FIGHTNUM )
Else
	$FIGHTTHRESHOLD = 280
EndIf
Global $TPNUM = READSETTING ( "General" , "tp" , "" )
Global $TPCNTTHRESHOLD
If $TPNUM = "" Then
	$TPCNTTHRESHOLD = 10
