		$IBUFFER = _SENDMESSAGE ( $HWND , $IMSG ) + 1
	Else
		$IBUFFER = GUICtrlSendMsg ( $HWND , $IMSG , 0 , 0 ) + 1
	EndIf
	If $IBUFFER = 1 Then Return ""
