Func __GUICTRLLISTVIEW_SORT ( $NITEM1 , $NITEM2 , $HWND )
	Local $IINDEX , $SVAL1 , $SVAL2 , $NRESULT
	Local $TBUFFER , $IMSG
	If $__G_ALISTVIEWSORTINFO [ $IINDEX ] [ 0 ] Then
		$TBUFFER = $__G_TLISTVIEWBUFFER
