	DllStructSetData ( $TFR , "Size" , DllStructGetSize ( $TFR ) )
	DllStructSetData ( $TFR , "hOwner" , $HOWNER )
	DllStructSetData ( $TFR , "hInstance" , 0 )
	DllStructSetData ( $TFR , "Flags" , $IFLAGS )
	DllStructSetData ( $TFR , "FindWhat" , $__G_PFRBUFFER )
