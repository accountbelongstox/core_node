	DllStructSetData ( $TGROUP , "Mask" , $IMASK )
	DllStructSetData ( $TGROUP , "GroupID" , $IGROUPID )
	DllStructSetData ( $TGROUP , "Align" , $AALIGN [ $IALIGN ] )
