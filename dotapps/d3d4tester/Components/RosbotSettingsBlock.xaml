<UserControl x:Class="DotApps.d3d4tester.Components.RosbotSettingsBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ROSBOT paths + bot settings (Python rosbot_extension_panel config rows) -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="300"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*" MinWidth="300"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <TextBlock x:Name="LblPathSettings" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="90"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblRosbotPath" Grid.Row="0" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtRosDirectory" Grid.Row="0" Grid.Column="1" Margin="0,0,6,4"/>
        <Button x:Name="BtnBrowseRosbot" Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Margin="0,0,0,4" Click="BtnBrowseRosbot_Click"/>
        <TextBlock x:Name="LblBattlenetPath" Grid.Row="1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,4" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtBattlenetPath" Grid.Row="1" Grid.Column="1" Margin="0,0,6,4"/>
        <Button x:Name="BtnBrowseBattlenet" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Margin="0,0,0,4" Click="BtnBrowseBattlenet_Click"/>
        <TextBlock x:Name="LblD3Path" Grid.Row="2" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBox x:Name="TxtD3Path" Grid.Row="2" Grid.Column="1" Margin="0,0,6,0"/>
        <Button x:Name="BtnBrowseD3" Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Click="BtnBrowseD3_Click"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Column="2">
      <TextBlock x:Name="LblBotSettings" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
      <WrapPanel>
        <CheckBox x:Name="ChkAutoEnableLatestRos" Margin="0,0,12,6" VerticalAlignment="Center"/>
        <CheckBox x:Name="ChkBluePortalPriority" Margin="0,0,12,6" VerticalAlignment="Center"/>
        <CheckBox x:Name="ChkFirstbornBlueGateReuse" Margin="0,0,12,6" VerticalAlignment="Center"/>
        <CheckBox x:Name="ChkPickupBloodShards" Margin="0,0,12,6" VerticalAlignment="Center"/>
        <CheckBox x:Name="ChkPreventStuck" Margin="0,0,12,6" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
          <CheckBox x:Name="ChkSmartEcho" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="TxtSmartEchoWaitSeconds" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="LblSeconds" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
          <CheckBox x:Name="ChkTestMode" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="TxtTestTimeoutMinutes" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="LblMinutes" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
