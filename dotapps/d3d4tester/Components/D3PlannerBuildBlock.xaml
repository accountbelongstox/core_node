<UserControl x:Class="DotApps.d3d4tester.Components.D3PlannerBuildBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:DotCore.UITheme;assembly=DotCore.UITheme"
             xmlns:comp="clr-namespace:DotApps.d3d4tester.Components">
  <UserControl.Resources>
    <!-- Gear cells: library icon (D3ItemIcons, empty when none) + text -->
    <DataTemplate x:Key="ItemCellTemplate">
      <StackPanel Orientation="Horizontal">
        <Image Source="{Binding Icon}" Height="28" MaxWidth="28" Stretch="Uniform" Margin="0,0,4,0"/>
        <TextBlock Text="{Binding Item}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GemsCellTemplate">
      <StackPanel Orientation="Horizontal">
        <ItemsControl ItemsSource="{Binding GemIcons}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Image Source="{Binding}" Width="20" Height="20" Margin="0,0,2,0"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Gems}" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- maxroll d3planner build: URL + load, cache folder, gear set, notify switches, paper dolls (worn in game | planned), then gear / skills / follower -->
  <DockPanel Margin="4">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <Button x:Name="BtnLoad" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" Click="BtnLoad_Click"/>
      <TextBox x:Name="TxtUrl" VerticalAlignment="Center" theme:ControlAssist.Placeholder="https://maxroll.gg/d3/d3planner/..." KeyDown="TxtUrl_KeyDown"/>
    </DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <TextBlock x:Name="LblBuild" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CmbBuild" MinWidth="140" Margin="0,0,4,4" SelectionChanged="CmbBuild_SelectionChanged"/>
      <Button x:Name="BtnRemove" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,10,4" Click="BtnRemove_Click"/>
      <TextBlock x:Name="LblProfile" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CmbProfile" MinWidth="180" Margin="0,0,10,4" SelectionChanged="CmbProfile_SelectionChanged"/>
      <CheckBox x:Name="ChkNotify" VerticalAlignment="Center" Margin="0,0,10,4"/>
      <CheckBox x:Name="ChkNotifyPush" VerticalAlignment="Center" Margin="0,0,10,4"/>
      <CheckBox x:Name="ChkEquipInTown" VerticalAlignment="Center" Margin="0,0,10,4"/>
      <CheckBox x:Name="ChkGambleUnaligned" VerticalAlignment="Center" Margin="0,0,10,4"/>
      <Button x:Name="BtnKanaiUpgrade" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4" Click="BtnKanaiUpgrade_Click"/>
    </WrapPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <Button x:Name="BtnOpenCache" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE838;" Margin="6,0,0,0" Click="BtnOpenCache_Click"/>
      <TextBlock x:Name="TxtCacheDir" Style="{StaticResource CaptionTextStyle}" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="TxtStatus" DockPanel.Dock="Top" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBlock x:Name="TxtAlignment" DockPanel.Dock="Top" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="LblDollGame" Style="{StaticResource FieldLabelTextStyle}" Margin="2,0,0,2"/>
      <TextBlock x:Name="LblDollPlan" Grid.Column="2" Style="{StaticResource FieldLabelTextStyle}" Margin="2,0,0,2"/>
      <comp:D3PaperDoll x:Name="DollGame" Grid.Row="1"/>
      <comp:D3PaperDoll x:Name="DollPlan" Grid.Row="1" Grid.Column="2"/>
    </Grid>
    <TabControl x:Name="TabsBuild" MinHeight="80">
      <!-- Hero gear (incl. Kanai's Cube) with the best copy in game -->
      <TabItem x:Name="TabGear">
        <ListView x:Name="LstItems" MinHeight="60">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
              <Setter Property="ToolTip" Value="{Binding Detail}"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn x:Name="ColSlot" Width="70" DisplayMemberBinding="{Binding Slot}"/>
              <GridViewColumn x:Name="ColItem" Width="170" CellTemplate="{StaticResource ItemCellTemplate}"/>
              <GridViewColumn x:Name="ColHave" Width="120" DisplayMemberBinding="{Binding Have}"/>
              <GridViewColumn x:Name="ColGems" Width="150" CellTemplate="{StaticResource GemsCellTemplate}"/>
              <GridViewColumn x:Name="ColAffixes" Width="260" DisplayMemberBinding="{Binding Affixes}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>
      <!-- Skill bar with runes, passives, Kanai's Cube powers, paragon level -->
      <TabItem x:Name="TabSkills">
        <DockPanel Margin="2,4,2,2">
          <!-- One-click switch (method chosen in a dialog) and its last result -->
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="BtnSwitchSkills" DockPanel.Dock="Left" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="BtnSwitchSkills_Click"/>
            <TextBlock x:Name="TxtSwitchStatus" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="TxtKanai" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock x:Name="TxtParagon" DockPanel.Dock="Bottom" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
          <!-- Passives: icon + name -->
          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock x:Name="LblPassives" DockPanel.Dock="Left" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ItemsControl x:Name="LstPassives">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
          <ListView x:Name="LstSkills">
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="ColSkillSlot" Width="80" DisplayMemberBinding="{Binding Slot}"/>
                <GridViewColumn x:Name="ColSkillIcon" Width="44">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Image Source="{Binding Icon}" Width="32" Height="32"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="ColSkillName" Width="160" DisplayMemberBinding="{Binding Skill}"/>
                <GridViewColumn x:Name="ColSkillRune" Width="180" DisplayMemberBinding="{Binding Rune}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <!-- Follower: type, skills, gear -->
      <TabItem x:Name="TabFollower">
        <DockPanel Margin="2,4,2,2">
          <TextBlock x:Name="TxtFollower" DockPanel.Dock="Top" Style="{StaticResource BodyStrongTextStyle}" Margin="0,0,0,2"/>
          <TextBlock x:Name="TxtFollowerSkills" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <ListView x:Name="LstFollowerItems">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                <Setter Property="ToolTip" Value="{Binding Detail}"/>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="ColFollowerSlot" Width="70" DisplayMemberBinding="{Binding Slot}"/>
                <GridViewColumn x:Name="ColFollowerItem" Width="190" CellTemplate="{StaticResource ItemCellTemplate}"/>
                <GridViewColumn x:Name="ColFollowerGems" Width="150" CellTemplate="{StaticResource GemsCellTemplate}"/>
                <GridViewColumn x:Name="ColFollowerAffixes" Width="260" DisplayMemberBinding="{Binding Affixes}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
