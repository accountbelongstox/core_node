<UserControl x:Class="DotApps.d3d4tester.Components.RosbotBridgePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:DotApps.d3d4tester.Components">
  <!-- CoreNodeBridge ROSBOT plugin. Top strip, visible on every sub-tab: pause ROSBOT while operating the game, the shared combat assist,
       one-click return to town and stand by, or end the control (Resume monitoring gives it back), the town portal key, and one shared
       control state for every plugin mode (control, standby, follow, running command, fight).
       Below, two columns: left = install state, auto-install switch, live game state (current map) from state.json, map history,
       command result; right = the data sub-tabs (ground, NPCs, follow, carried, pickups, build, advanced) over the full height -->
  <DockPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,6">
    <WrapPanel>
      <CheckBox x:Name="ChkTakeControl" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <CheckBox x:Name="ChkAssist" VerticalAlignment="Center" Margin="0,0,12,0" Click="ChkAssist_Click"/>
      <CheckBox x:Name="ChkPluginCast" VerticalAlignment="Center" Margin="0,0,12,0" Click="ChkPluginCast_Click"/>
      <Button x:Name="BtnStandby" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0" Click="BtnStandby_Click"/>
      <TextBlock x:Name="LblTownPortalKey" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox x:Name="TxtTownPortalKey" Width="40" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock x:Name="TxtStandbyState" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </WrapPanel>
  </Border>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="240"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="3*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="TxtInstallInfo" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <CheckBox x:Name="ChkAutoInstall" Grid.Row="1" Margin="0,0,0,4"/>
      <WrapPanel Grid.Row="2" Margin="0,0,0,4">
        <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4" Click="BtnInstall_Click"/>
        <Button x:Name="BtnOpenDir" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,6,4" Click="BtnOpenDir_Click"/>
      </WrapPanel>
      <TextBlock x:Name="TxtLiveStatus" Grid.Row="3" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" Margin="0,0,0,2"/>
      <Grid x:Name="GridLive" Grid.Row="4" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="80"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
      </Grid>
      <Grid Grid.Row="5" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="TxtAreaName" Margin="0,0,6,0"/>
        <Button x:Name="BtnSaveAreaName" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSaveAreaName_Click"/>
      </Grid>
      <TextBlock x:Name="LblHistory" Grid.Row="6" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
      <ListBox x:Name="LstHistory" Grid.Row="7" MinHeight="40" Margin="0,0,0,4"/>
      <TextBlock x:Name="TxtCommandResult" Grid.Row="8" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
    </Grid>
    <Grid Grid.Column="2">
    <TabControl x:Name="TabsData">
      <TabItem x:Name="TabGround">
        <DockPanel Margin="4">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="BtnGroundMoveTo" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnGroundMoveTo_Click"/>
            <Button x:Name="BtnGroundPickup" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4" Click="BtnGroundPickup_Click"/>
            <Button x:Name="BtnPickupMatching" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4" Click="BtnPickupMatching_Click"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock x:Name="LblFilter" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
            <TextBox x:Name="TxtFilter" Height="44" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
            <WrapPanel>
              <CheckBox x:Name="ChkFilterAuto" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button x:Name="BtnSaveFilter" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSaveFilter_Click"/>
            </WrapPanel>
          </StackPanel>
          <ListBox x:Name="LstGround" MinHeight="60"/>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="TabNpc">
        <DockPanel Margin="4">
          <WrapPanel x:Name="PanelTownNpcs" DockPanel.Dock="Top" Margin="0,0,0,4"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBox x:Name="TxtNpcTarget" Width="140" Margin="0,0,6,4" VerticalAlignment="Center"/>
            <Button x:Name="BtnNpcFind" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnNpcFind_Click"/>
            <Button x:Name="BtnNpcOpen" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4" Click="BtnNpcOpen_Click"/>
            <CheckBox x:Name="ChkInteractMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <CheckBox x:Name="ChkInteractClick" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,4"/>
          </WrapPanel>
          <ListBox x:Name="LstNpcs" MinHeight="60"/>
        </DockPanel>
      </TabItem>
      <!-- Monsters the plugin sees: ROSBOT's attack-target mark, elite / boss, hit points, distance; ROSBOT's target settings above -->
      <TabItem x:Name="TabMonsters">
        <DockPanel Margin="4">
          <TextBlock x:Name="TxtMonsterInfo" DockPanel.Dock="Top" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="TxtSkills" DockPanel.Dock="Top" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <ListBox x:Name="LstMonsters" MinHeight="60"/>
        </DockPanel>
      </TabItem>
      <!-- Follow a party member: target, banner slot, pickup / revive (lost outside town: the strip's town portal key), players -->
      <TabItem x:Name="TabFollow">
        <DockPanel Margin="4">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="BtnFollow" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnFollow_Click"/>
            <ComboBox x:Name="CmbFollowTarget" MinWidth="110" Margin="0,0,8,4"/>
            <TextBlock x:Name="LblFollowBanner" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,4,4"/>
            <ComboBox x:Name="CmbFollowBanner" MinWidth="70" Margin="0,0,8,4"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <CheckBox x:Name="ChkFollowPickup" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <CheckBox x:Name="ChkFollowRevive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,4"/>
          </WrapPanel>
          <TextBlock x:Name="TxtFollowState" DockPanel.Dock="Top" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
          <ListBox x:Name="LstPlayers" MinHeight="60"/>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="TabCarried">
        <DockPanel Margin="4">
          <ListBox x:Name="LstCarried" MinHeight="60"/>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="TabPickups">
        <ListBox x:Name="LstPickups" Margin="4" MinHeight="60"/>
      </TabItem>
      <TabItem x:Name="TabBuild">
        <comp:D3PlannerBuildBlock x:Name="BuildBlock"/>
      </TabItem>
      <TabItem x:Name="TabAdvanced">
        <StackPanel Margin="4">
          <CheckBox x:Name="ChkDebugFull" Margin="0,0,0,6" Click="ChkDebugFull_Click"/>
          <WrapPanel Margin="0,0,0,6">
            <TextBox x:Name="TxtUiId" Width="200" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnClickUi" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnClickUi_Click"/>
            <Button x:Name="BtnScriptScope" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,6,0" Click="BtnScriptScope_Click"/>
            <Button x:Name="BtnPowerApi" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,6,0" Click="BtnPowerApi_Click"/>
            <Button x:Name="BtnAttackTest" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,6,0" Click="BtnAttackTest_Click"/>
            <Button x:Name="BtnCastTest" Style="{StaticResource SubtleButtonStyle}" Click="BtnCastTest_Click"/>
          </WrapPanel>
          <TextBlock x:Name="LblTests" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
          <WrapPanel Margin="0,0,0,6">
            <Button x:Name="BtnSalvageNormal" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnSalvageNormal_Click"/>
            <Button x:Name="BtnSalvageMagic" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnSalvageMagic_Click"/>
            <Button x:Name="BtnSalvageRare" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4" Click="BtnSalvageRare_Click"/>
            <Button x:Name="BtnSalvageKeepAncient" Style="{StaticResource WarningButtonStyle}" Margin="0,0,6,4" Click="BtnSalvageKeepAncient_Click"/>
            <Button x:Name="BtnSalvageKeepPrimal" Style="{StaticResource WarningButtonStyle}" Margin="0,0,6,4" Click="BtnSalvageKeepPrimal_Click"/>
            <Button x:Name="BtnSalvageRule" Style="{StaticResource WarningButtonStyle}" Margin="0,0,6,4" Click="BtnSalvageRule_Click"/>
            <Button x:Name="BtnDropRule" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,4" Click="BtnDropRule_Click"/>
          </WrapPanel>
          <TextBlock x:Name="TxtCapabilities" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    </Grid>
  </Grid>
  </DockPanel>
</UserControl>
