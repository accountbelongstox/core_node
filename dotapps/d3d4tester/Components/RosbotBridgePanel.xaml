<UserControl x:Class="DotApps.d3d4tester.Components.RosbotBridgePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CoreNodeBridge ROSBOT plugin: install state, auto-install switch, live game state (current map) from state.json -->
  <StackPanel>
    <TextBlock x:Name="LblTitle" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,4"/>
    <TextBlock x:Name="TxtDesc" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock x:Name="TxtInstallInfo" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <CheckBox x:Name="ChkAutoInstall" Margin="0,0,0,6"/>
    <WrapPanel Margin="0,0,0,6">
      <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4" Click="BtnInstall_Click"/>
      <Button x:Name="BtnOpenDir" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,0,4" Click="BtnOpenDir_Click"/>
    </WrapPanel>
    <TextBlock x:Name="TxtLiveStatus" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <Grid x:Name="GridLive" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="96"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
    </Grid>
    <Grid Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="TxtAreaName" Margin="0,0,6,0"/>
      <Button x:Name="BtnSaveAreaName" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSaveAreaName_Click"/>
    </Grid>
    <TextBlock x:Name="LblHistory" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
    <ListBox x:Name="LstHistory" Height="110"/>
  </StackPanel>
</UserControl>
