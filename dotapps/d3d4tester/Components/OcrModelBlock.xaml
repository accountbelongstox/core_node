<UserControl x:Class="DotApps.d3d4tester.Components.OcrModelBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Global CPU OCR model (shared by every dot app): choose, download from the official source, load -->
  <StackPanel Margin="4,8,4,4">
    <DockPanel Margin="0,0,0,6">
      <TextBlock x:Name="LblModel" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="CmbModel" MinWidth="200" HorizontalAlignment="Left" SelectionChanged="CmbModel_SelectionChanged"/>
    </DockPanel>
    <TextBlock x:Name="TxtState" Margin="0,0,0,6" TextWrapping="Wrap"/>
    <ProgressBar x:Name="PrgDownload" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,6" Visibility="Collapsed"/>
    <WrapPanel Margin="0,0,0,6">
      <Button x:Name="BtnDownload" Margin="0,0,6,0" Click="BtnDownload_Click"/>
      <Button x:Name="BtnLoad" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Click="BtnLoad_Click"/>
      <Button x:Name="BtnOpenDir" Style="{StaticResource IconButtonStyle}" Content="&#xE838;" Click="BtnOpenDir_Click"/>
    </WrapPanel>
    <TextBlock x:Name="TxtDir" Style="{StaticResource CaptionTextStyle}" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
    <TextBlock x:Name="TxtHint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
