<UserControl x:Class="DotApps.d3check.Components.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="TitleBarBorder" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4"
          MouseLeftButtonDown="TitleBarBorder_MouseLeftButtonDown">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TxtTitle" Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
      <ComboBox x:Name="CboLanguage" Grid.Column="1" MinWidth="90" Height="26" Margin="8,0" VerticalAlignment="Center"
          FontSize="13" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource InputTextBrush}"
          BorderBrush="{StaticResource BorderSubtleBrush}" Padding="4,2"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="BtnRestoreSize" Style="{StaticResource IconButtonStyle}" Width="28" Height="24" Margin="2,0" ToolTip="Restore preset size" Click="BtnRestoreSize_Click">
          <TextBlock Text="&#x29C9;" FontFamily="Segoe UI Symbol" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="BtnRestart" Style="{StaticResource IconButtonStyle}" Width="28" Height="24" Margin="2,0" ToolTip="Restart app" Click="BtnRestart_Click">
          <TextBlock Text="&#x21BB;" FontFamily="Segoe UI Symbol" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="BtnMinimize" Style="{StaticResource IconButtonStyle}" Width="28" Height="24" Margin="2,0" ToolTip="Minimize" Click="BtnMinimize_Click">
          <TextBlock Text="&#x2212;" FontFamily="Segoe UI Symbol" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="BtnMaximize" Style="{StaticResource IconButtonStyle}" Width="28" Height="24" Margin="2,0" ToolTip="Maximize / Restore" Click="BtnMaximize_Click">
          <TextBlock Text="&#x25A1;" FontFamily="Segoe UI Symbol" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="BtnClose" Style="{StaticResource IconButtonStyle}" Width="28" Height="24" Margin="2,0" ToolTip="Close" Click="BtnClose_Click">
          <TextBlock Text="&#x2715;" FontFamily="Segoe UI Symbol" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
