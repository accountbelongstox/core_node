<UserControl x:Class="DotApps.d3check.Pages.D4.D4Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: sub-tab navigation (1:1 Python _create_subtab_navigation) -->
    <Border Grid.Column="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
      <StackPanel>
        <TextBlock x:Name="LblD4Title" Text="D4" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
        <Button x:Name="BtnExpFarmingNav" Content="EXP Farming" Width="120" Height="28" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="8,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Right: EXP Farming content (1:1 Python _create_exp_farming_content) -->
    <Border Grid.Column="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentExpFarming">
          <TextBlock x:Name="LblExpFarmingTitle" Text="EXP Farming" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnExpFarmingStartStop" Content="Start" Width="120" Height="28" Margin="0,0,8,0" Click="BtnExpFarmingStartStop_Click" Background="{StaticResource ButtonSuccessBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelBorderBrush}"/>
          </StackPanel>

          <!-- Game status (Python _create_game_status_area: 3 rows x 5 cols) -->
          <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock x:Name="LblGameStatusTitle" Text="Game status" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,2">
                  <TextBlock Text="Current Map" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtCurrentMap" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                  <TextBlock x:Name="LblGameState" Text="Game State" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtGameState" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,2">
                  <TextBlock x:Name="LblTeamCount" Text="Team Count" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtTeamCount" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,2">
                  <TextBlock x:Name="LblDungeonProgress" Text="Dungeon Progress" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtDungeonProgress" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,2">
                  <TextBlock x:Name="LblD4RunningStatus" Text="D4 Status" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtD4RunningStatus" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <!-- Row 1 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,2">
                  <TextBlock x:Name="LblScreenCoordinates" Text="Screen Coords" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtScreenCoordinates" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                  <TextBlock x:Name="LblScreenSize" Text="Screen Size" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtScreenSize" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,2">
                  <TextBlock x:Name="LblMapSwitchCount" Text="Map Switches" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtMapSwitchCount" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,2">
                  <TextBlock x:Name="LblMapSwitchState" Text="Map State" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtMapSwitchState" Text="--" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,2">
                  <TextBlock x:Name="LblReserved4" Text="Reserved" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtReserved4" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <!-- Row 2 reserved 5-9 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,2">
                  <TextBlock Text="Reserved" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtReserved5" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                  <TextBlock Text="Reserved" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtReserved6" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,2">
                  <TextBlock Text="Reserved" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtReserved7" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,2">
                  <TextBlock Text="Reserved" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtReserved8" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,2">
                  <TextBlock Text="Reserved" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="TxtReserved9" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnExpFarmingDebug" Content="Debug" Width="80" Height="24" Margin="0,0,8,0" Click="BtnExpFarmingDebug_Click"/>
          </StackPanel>
          <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LblLogTitle" Grid.Row="0" Text="Log" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="80">
                <TextBox x:Name="TxtExpFarmingLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="{StaticResource BackgroundDarkBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Padding="4"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
