<UserControl x:Class="DotApps.d3check.Pages.Rosbot.RosbotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <!-- Layout 1:1 Python: row0 = left (config + bot settings) | right (control panel), row1 = log full width -->
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="160"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="280"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <!-- Left column: config (paths + bot settings) - same as Python config_frame -->
    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,8,0" Margin="0,0,8,0">
      <StackPanel>
        <!-- Paths (Python path_section; same labels as Python) -->
        <TextBlock x:Name="LblPathSettings" Text="Path Settings" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="LblRosbotPath" Grid.Row="0" Grid.Column="0" Text="ROSBOT Path" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" Width="100"/>
          <TextBox x:Name="TxtRosDirectory" Grid.Row="0" Grid.Column="1" Margin="4,2" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
          <TextBlock x:Name="LblBattlenetPath" Grid.Row="1" Grid.Column="0" Text="Battle.net Path" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
          <TextBox x:Name="TxtBattlenetPath" Grid.Row="1" Grid.Column="1" Margin="4,2" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
          <TextBlock x:Name="LblD3Path" Grid.Row="2" Grid.Column="0" Text="D3 Path" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
          <TextBox x:Name="TxtD3Path" Grid.Row="2" Grid.Column="1" Margin="4,2" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
        </Grid>
        <!-- Bot settings: 3x3 grid - Python _create_bot_settings order -->
        <TextBlock x:Name="LblBotSettings" Text="Bot Settings" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Row 0: auto latest ROS | blue portal priority | firstborn blue gate reuse -->
          <CheckBox x:Name="ChkAutoEnableLatestRos" Grid.Row="0" Grid.Column="0" Content="Auto Enable Latest ROS" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,8,2"/>
          <CheckBox x:Name="ChkBluePortalPriority" Grid.Row="0" Grid.Column="1" Content="Blue Portal Priority Material Pickup" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,8,2"/>
          <CheckBox x:Name="ChkFirstbornBlueGateReuse" Grid.Row="0" Grid.Column="2" Content="Firstborn Blue Gate Reuse" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,2"/>
          <!-- Row 1: pickup blood shards | smart echo + s | test mode + min -->
          <CheckBox x:Name="ChkPickupBloodShards" Grid.Row="1" Grid.Column="0" Content="Enable Blood Shard Pickup" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,8,2"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,2">
            <CheckBox x:Name="ChkSmartEcho" Content="Smart Echo" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSmartEchoWaitSeconds" Width="32" Height="22" Margin="0,0,4,0" VerticalContentAlignment="Center" Padding="2,0"/>
            <TextBlock x:Name="LblSeconds" Text="s" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,2,0,2">
            <CheckBox x:Name="ChkTestMode" Content="Test Mode" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTestTimeoutMinutes" Width="36" Height="22" Margin="0,0,4,0" VerticalContentAlignment="Center" Padding="2,0"/>
            <TextBlock x:Name="LblMinutes1" Text="min" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- Row 2: prevent stuck | startup | timeout restart + min -->
          <CheckBox x:Name="ChkPreventStuck" Grid.Row="2" Grid.Column="0" Content="Enable Anti-Stuck" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,8,2"/>
          <CheckBox x:Name="ChkStartup" Grid.Row="2" Grid.Column="1" Content="Startup on Boot" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,8,2"/>
          <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,2,0,2">
            <CheckBox x:Name="ChkTimeoutRestart" Content="Auto restart ROSBOT/Diablo after X minutes timeout" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTimeoutMinutes" Width="36" Height="22" Margin="0,0,4,0" VerticalContentAlignment="Center" Padding="2,0"/>
            <TextBlock x:Name="LblMinutes2" Text="min" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Right column: control panel - Python control_frame column 1 -->
    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,0" Padding="0,0,0,0">
      <StackPanel>
        <TextBlock x:Name="LblControlPanel" Text="Control Panel" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Button x:Name="BtnStartRosbot" Content="Start ROSBOT" Width="140" Height="28" Margin="0,0,0,4" Click="BtnStartRosbot_Click"/>
        <Button x:Name="BtnEnsureBattlenet" Content="Ensure Battle.net" Width="140" Height="28" Margin="0,0,0,4" Click="BtnEnsureBattlenet_Click"/>
        <Button x:Name="BtnUpdateRosbot" Content="Update ROSBOT" Width="140" Height="28" Margin="0,0,0,4" Click="BtnUpdateRosbot_Click"/>
        <Button x:Name="BtnOpenTampermonkey" Content="Open Tampermonkey script" Width="140" Height="28" Margin="0,0,0,4" Click="BtnOpenTampermonkey_Click"/>
        <Button x:Name="BtnSetAccountPassword" Content="Set account/password" Width="140" Height="28" Margin="0,0,0,4" Click="BtnSetAccountPassword_Click"/>
      </StackPanel>
    </Border>

    <!-- Log: row 1, full width - Python _create_log_display_row -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="LblRosbotLog" Text="ROSBOT Log" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <TextBox x:Name="TxtRosbotLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="4" MinHeight="120"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
