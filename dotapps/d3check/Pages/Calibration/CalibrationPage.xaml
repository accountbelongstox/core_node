<UserControl x:Class="DotApps.d3check.Pages.Calibration.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252525">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Client mode + client type radios + Capture -->
    <Border Grid.Row="0" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Client mode" Foreground="#ddd" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <RadioButton x:Name="RadioBattlenet" Content="Battle.net" Foreground="#ddd" Margin="0,0,16,0" GroupName="ClientType"/>
          <RadioButton x:Name="RadioD3Game" Content="D3 Game" Foreground="#ddd" Margin="0,0,16,0" GroupName="ClientType"/>
          <RadioButton x:Name="RadioD4Game" Content="D4 Game" Foreground="#ddd" Margin="0,0,16,0" GroupName="ClientType"/>
        </StackPanel>
        <Button x:Name="BtnCapture" Content="Capture screenshot" Width="140" Height="28"/>
      </StackPanel>
    </Border>

    <!-- YOLO section -->
    <Border Grid.Row="1" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="YOLO data" Foreground="#ddd" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel Margin="0,0,0,6">
          <Button x:Name="BtnYoloConfig" Content="Config" Width="70" Height="24" Margin="0,0,8,4"/>
          <Button x:Name="BtnYoloRecordStart" Content="Record Start" Width="90" Height="24" Margin="0,0,8,4"/>
          <Button x:Name="BtnYoloRecordStop" Content="Record Stop" Width="90" Height="24" Margin="0,0,8,4"/>
          <TextBlock Text="Open / Import patch" VerticalAlignment="Center" Foreground="#888" Margin="8,0,8,4"/>
          <Button x:Name="BtnYoloImportPatch" Content="Import patch" Width="90" Height="24" Margin="0,0,8,4"/>
        </WrapPanel>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Project:" VerticalAlignment="Center" Foreground="#ddd" Margin="0,0,8,0"/>
          <ComboBox x:Name="CboYoloProject" Grid.Column="1" MinWidth="150" Margin="0,0,8,0" Background="#333" Foreground="#ddd" DisplayMemberPath="Display" SelectedValuePath="Path"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="BtnYoloCreateProject" Content="Create project" Width="100" Height="24" Margin="0,0,4,0"/>
            <Button x:Name="BtnYoloOpenProjectDir" Content="Open project dir" Width="100" Height="24"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Workflow: Step 1 Record; Step 2 Export; Step 3 Label" Foreground="#888" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- YOLO segment table + toolbar -->
    <Border Grid.Row="2" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
      <StackPanel>
        <WrapPanel Margin="0,0,0,6">
          <Button x:Name="BtnYoloRefresh" Content="Refresh" Width="70" Height="24" Margin="0,0,4,4"/>
          <Button x:Name="BtnYoloExportSelected" Content="Export selected" Width="100" Height="24" Margin="0,0,4,4"/>
          <Button x:Name="BtnYoloOpenLabel" Content="Open label" Width="80" Height="24" Margin="0,0,4,4" Click="BtnYoloOpenLabel_Click"/>
          <Button x:Name="BtnYoloMerge" Content="Merge" Width="60" Height="24" Margin="0,0,4,4"/>
          <Button x:Name="BtnYoloDelete" Content="Delete" Width="60" Height="24" Margin="0,0,4,4"/>
          <Button x:Name="BtnYoloImportPatchToolbar" Content="Import patch" Width="90" Height="24" Margin="0,0,4,4"/>
        </WrapPanel>
        <DataGrid x:Name="DgYoloSegments" Height="120" Background="#1a1a1a" Foreground="#ddd" BorderBrush="#444" BorderThickness="1"
                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="120"/>
            <DataGridTextColumn Header="Frames" Binding="{Binding Frames}" Width="60"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>

    <!-- Record log panel -->
    <Border Grid.Row="3" BorderBrush="#444" BorderThickness="1" CornerRadius="2" Padding="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Record log" Foreground="#888" Margin="0,0,0,4"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="80">
          <TextBox x:Name="TxtRecordLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#1a1a1a" Foreground="#aaa" BorderThickness="0" Padding="4"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
