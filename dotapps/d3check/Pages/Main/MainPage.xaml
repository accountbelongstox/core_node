<UserControl x:Class="DotApps.d3check.Pages.Main.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotApps.d3check.ViewModels"
             Background="{StaticResource PanelBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="280"/>
        <ColumnDefinition Width="2*" MinWidth="200"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="CboConfig" MinWidth="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="LblCurrentConfig" Text="Current config: " Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtCurrentConfig" Text="config1" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </Grid>
        <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72"/>
              <ColumnDefinition Width="52"/>
              <ColumnDefinition Width="88"/>
              <ColumnDefinition Width="42"/>
              <ColumnDefinition Width="42"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSkill" Grid.Row="0" Grid.Column="0" Text="Skill" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="LblKey" Grid.Row="0" Grid.Column="1" Text="Key" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="LblStrategy" Grid.Row="0" Grid.Column="2" Text="Strategy" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="LblInterval" Grid.Row="0" Grid.Column="3" Text="Interval" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="LblDelay" Grid.Row="0" Grid.Column="4" Text="Delay" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="LblRandom" Grid.Row="0" Grid.Column="5" Text="Random" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
            <ItemsControl x:Name="SkillRowsItemsControl" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" ItemsSource="{Binding SkillRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SkillRowViewModel}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72"/>
                      <ColumnDefinition Width="52"/>
                      <ColumnDefinition Width="88"/>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsKeyEditable}" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource InputTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
                    <ComboBox Grid.Column="2" SelectedIndex="{Binding StrategyIndex, Mode=TwoWay}" ItemsSource="{Binding Source={x:Static vm:SkillRowViewModel.StrategyDisplayNames}}" MinHeight="22" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource InputTextBrush}"/>
                    <TextBox Grid.Column="3" Text="{Binding Interval, UpdateSourceTrigger=LostFocus}" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource InputTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
                    <TextBox Grid.Column="4" Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource InputTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
                    <TextBox Grid.Column="5" Text="{Binding RandomDelay, UpdateSourceTrigger=LostFocus}" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource InputTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </StackPanel>

      <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
        <StackPanel>
          <TextBlock x:Name="LblBagOffset" Text="Bag offset (top, left, bottom, right):" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtBagOffset" Padding="4,2" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Margin="0,0,0,8"/>
          <TextBlock x:Name="LblAutomationOptions" Text="Automation options:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
              <CheckBox x:Name="ChkBloodShard" Content="Blood shard" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
              <CheckBox x:Name="ChkQuickPickup" Content="Quick pickup" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
              <CheckBox x:Name="ChkBlacksmith" Content="Blacksmith" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
              <CheckBox x:Name="ChkKanaiReforge" Content="Kanai reforge" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
              <CheckBox x:Name="ChkKanaiUpgrade" Content="Kanai upgrade" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
              <CheckBox x:Name="ChkKanaiConvert" Content="Kanai convert" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
              <CheckBox x:Name="ChkAutoSalvage" Content="Auto salvage" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
              <CheckBox x:Name="ChkDropEquipment" Content="Drop equipment" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource BackgroundDarkBrush}" Padding="6,8" Margin="0,8,0,0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LblMacroStartHotkey" Grid.Row="0" Grid.Column="0" Text="Macro start hotkey:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,4"/>
          <TextBox x:Name="TxtMacroStartHotkey" Grid.Row="0" Grid.Column="1" Padding="4,2" Margin="0,0,12,4" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
          <TextBlock x:Name="LblAssistantHotkey" Grid.Row="1" Grid.Column="0" Text="Assistant hotkey:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,4"/>
          <TextBox x:Name="TxtAssistantHotkey" Grid.Row="1" Grid.Column="1" Padding="4,2" Margin="0,0,12,4" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
          <TextBlock x:Name="LblQuickSwitch" Grid.Row="2" Grid.Column="0" Text="Quick switch:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,4"/>
          <TextBox x:Name="TxtQuickSwitch" Grid.Row="2" Grid.Column="1" Padding="4,2" Margin="0,0,12,4" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"/>
          <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="LblAnimation" Text="Animation:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0"/>
            <ComboBox x:Name="CboAnimationSpeed" MinWidth="80" VerticalAlignment="Center" Margin="0,0,12,0" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="LblLanguage" Text="Language:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,4,0"/>
            <ComboBox x:Name="CboGameLanguage" MinWidth="100" VerticalAlignment="Center" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>
          </StackPanel>
          <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,6,0,0">
            <Button x:Name="BtnCombatMacroToggle" Content="战斗宏 启/停" Padding="8,4" Margin="0,2,16,2" Command="{Binding CombatMacroToggleCommand}"/>
            <CheckBox x:Name="ChkPlaySoundOnSwitch" Content="Play sound on switch" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,16,2"/>
            <CheckBox x:Name="ChkSmartPauseBar" Content="Smart pause" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,16,2"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
              <CheckBox x:Name="ChkCustomStand" Content="Custom stand key:" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,4,2" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtCustomStandKey" Width="60" Padding="4,2" Margin="0,0,0,0" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
