<Window x:Class="DotApps.d3check.Windows.AnnotatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VOC Annotator"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ToolBar Grid.Row="0" Margin="2">
      <Button x:Name="BtnOpenDir" Content="Open images dir" Click="BtnOpenDir_Click"/>
      <Separator/>
      <Button x:Name="BtnSetSaveDir" Content="Set save dir" Click="BtnSetSaveDir_Click"/>
      <TextBlock x:Name="TxtSaveDir" VerticalAlignment="Center" Margin="8,0" Text="" Foreground="Gray"/>
      <Separator/>
      <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click" IsEnabled="False"/>
    </ToolBar>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="180"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="4">
        <StackPanel>
          <TextBlock Text="Images" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ListBox x:Name="LstImages" Height="300" SelectionChanged="LstImages_SelectionChanged"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" BorderBrush="#ccc" BorderThickness="0,0,1,0" Padding="4">
        <ScrollViewer x:Name="ScrollCanvas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas x:Name="CanvasImage" Background="#222" ClipToBounds="True">
            <Image x:Name="ImgDisplay"
                   MouseDown="CanvasImage_MouseDown"
                   MouseMove="CanvasImage_MouseMove"
                   MouseUp="CanvasImage_MouseUp"/>
          </Canvas>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Padding="4">
        <StackPanel>
          <TextBlock Text="Classes" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ListBox x:Name="LstClasses" SelectionChanged="LstClasses_SelectionChanged"/>
          <TextBlock Text="Current class" Margin="0,12,0,2"/>
          <TextBox x:Name="TxtCurrentClass" Text="object" Margin="0,0,0,8"/>
          <Button x:Name="BtnAddRect" Content="Add rectangle (drag on image)" IsEnabled="False" Click="BtnAddRect_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
