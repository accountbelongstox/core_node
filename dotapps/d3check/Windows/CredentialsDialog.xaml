<Window x:Class="DotApps.d3check.Windows.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battle.net Account &amp; Password" Height="280" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="LblRegionType" Grid.Row="0" Text="Type (namespace):" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
    <ComboBox x:Name="ComboRegion" Grid.Row="1" Margin="0,0,0,10" MinWidth="120" HorizontalAlignment="Left" IsReadOnly="True"/>
    <TextBlock x:Name="LblAccount" Grid.Row="2" Text="Account (email/phone):" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
    <TextBox x:Name="TxtEmail" Grid.Row="3" Margin="0,0,0,10" MinWidth="280" Padding="6,4"/>
    <TextBlock x:Name="LblPassword" Grid.Row="4" Text="Password:" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
    <PasswordBox x:Name="TxtPassword" Grid.Row="5" Margin="0,0,0,12" MinWidth="280" Padding="6,4"/>
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnOk" Content="OK" Width="80" Height="28" Margin="0,0,8,0" Click="BtnOk_Click"/>
      <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="28" Click="BtnCancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
