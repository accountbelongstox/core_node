<Window x:Class="{{ROOT_NAMESPACE}}.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:{{ROOT_NAMESPACE}}.Panels"
        xmlns:components="clr-namespace:{{ROOT_NAMESPACE}}.Components"
        Title="{{APP_NAME}}"
        MinWidth="500" MinHeight="350"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">
  <Grid x:Name="RootGrid" Background="{StaticResource BackgroundPrimaryBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <components:TitleBarControl x:Name="TitleBar" Grid.Row="0" Title="{{APP_NAME}}"/>
    <TabControl x:Name="TabMain" Grid.Row="1" Background="{StaticResource BackgroundPrimaryBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0">
      <TabItem x:Name="TabHome" Header="Home">
        <panels:SamplePanel/>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="Status: Ready" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
    </Border>
  </Grid>
</Window>
