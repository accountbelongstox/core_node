<UserControl x:Class="{{ROOT_NAMESPACE}}.Panels.SamplePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{StaticResource PageMargin}">
    <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Padding="{StaticResource ThicknessXL}">
      <StackPanel>
        <TextBlock Text="Welcome to {{APP_NAME}}" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="This app was created from the DotApps WPF template. It uses the shared UI theme and a custom title bar."
                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
