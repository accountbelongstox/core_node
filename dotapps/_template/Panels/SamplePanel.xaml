<UserControl x:Class="{{ROOT_NAMESPACE}}.Panels.SamplePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <Grid Margin="16">
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Welcome to {{APP_NAME}}" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <TextBlock Text="This app was created from the DotApps WPF template. It uses the shared UI theme and a custom title bar." 
                 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
