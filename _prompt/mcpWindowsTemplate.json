{
    "mcpServers": {
        "promptx": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@promptx/mcp-server"
            ]
        },
        "AutoContext7MCP": {
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "D:/programing/core_node/ncore/mcp_server/auto-context7-mcp/auto_fix_context7.ps1"
            ],
            "env": {
                "MAX_RETRIES": "3",
                "RETRY_DELAY": "2",
                "FORCE_REINSTALL": "false"
            },
            "disabled": false,
            "autoApprove": [],
            "timeout": 120000
        },
        "McpAlchemy": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:/programing/core_node/ncore/mcp_server/mcp-alchemy/main.py"
            ],
            "env": {
                "EXECUTE_QUERY_MAX_CHARS": "4000"
            },
            "disabled": false,
            "autoApprove": [
                "get_namespace_guide",
                "start_namespace_negotiation",
                "confirm_namespace",
                "list_session_databases",
                "register_database",
                "all_table_names",
                "filter_table_names",
                "schema_definitions",
                "get_database_info",
                "batch_insert",
                "batch_update",
                "batch_delete",
                "batch_upsert",
                "batch_select",
                "analyze_table_performance",
                "create_optimized_index",
                "get_database_stats"
            ]
        },
        "FeedbackEnhanced": {
            "command": "cmd",
            "args": [
                "/c",
                "uvx",
                "mcp-feedback-enhanced@latest"
            ],
            "env": {
                "MCP_DEBUG": "false",
                "MCP_WEB_HOST": "127.0.0.1",
                "MCP_WEB_PORT": "8765",
                "MCP_LANGUAGE": "en"
            },
            "disabled": false,
            "autoApprove": []
        },
        "PlaceholderImageGenerator": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:/programing/core_node/ncore/mcp_server/placeholder_image_generator/main.py"
            ],
            "env": {
                "MCP_ALLOW_ALL_PATHS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "generate_placeholder",
                "list_placeholders",
                "check_path_access",
                "health_check"
            ]
        },
        "FileProcessor": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:/programing/core_node/ncore/mcp_server/file_processor/main.py"
            ],
            "env": {
                "MCP_ALLOW_ALL_PATHS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "parse_document",
                "convert_document",
                "write_document",
                "batch_convert",
                "list_supported_formats",
                "list_conversion_formats",
                "initialize_packages",
                "ocr_recognize",
                "configure_ocr",
                "list_ocr_engines",
                "smart_ocr_recognize",
                "get_ocr_task_status",
                "get_ocr_batch_status",
                "get_ocr_system_status",
                "analyze_image_pixels",
                "health_check"
            ]
        },
        "CodebaseScanner": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:/programing/core_node/ncore/mcp_server/codebase-scanner/main.py"
            ],
            "env": {
                "ENABLE_GLOBAL_ACCESS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "generate_directory_tree",
                "find_file_by_name",
                "search_content_in_files",
                "get_codebase_stats",
                "find_file_by_path",
                "scan_flutter_apps",
                "print_flutter_app_structure",
                "health_check"
            ]
        }
    }
}