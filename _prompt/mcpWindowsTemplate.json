{
    "mcpServers": {
        "promptx": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@promptx/mcp-server"
            ]
        },
        "AutoContext7MCP": {
            "type": "streamable-http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "YOUR_API_KEY",
                "Accept": "application/json, text/event-stream"
            }
        },
        "FeedbackEnhanced": {
            "command": "cmd",
            "args": [
                "/c",
                "uvx",
                "mcp-feedback-enhanced@latest"
            ],
            "env": {
                "MCP_DEBUG": "false",
                "MCP_WEB_HOST": "127.0.0.1",
                "MCP_WEB_PORT": "8765",
                "MCP_LANGUAGE": "en"
            },
            "disabled": false,
            "autoApprove": []
        },
        "AICollaboration": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:/programing/core_node/ncore/mcp_server/ai_collaboration/main.py"
            ],
            "env": {
                "MCP_ALLOW_ALL_PATHS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "register_role",
                "get_role_list",
                "write_log",
                "read_logs",
                "ask_question",
                "answer_question",
                "get_pending_questions",
                "health_check",
                "restart_service",
                "get_storage_stats",
                "get_log_summary",
                "get_qa_statistics",
                "get_question_history",
                "search_logs"
            ]
        },
        "MCPUnifiedServer": {
            "command": "python",
            "args": [
                "D:/programing/core_node/pymain.py",
                "app=mcp"
            ],
            "env": {
                "MCP_ALLOW_ALL_PATHS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "get_file_info_with_ocr_and_document_parsing_tool",
                "generate_placeholder_image_with_ocr_tool",
                "query_file_processing_history_tool",
                "clear_file_cache_tool",
                "database_namespace_negotiation_tool",
                "database_register_and_connect_tool",
                "database_execute_query_with_safety_tool",
                "database_batch_operations_tool",
                "database_schema_inspection_tool",
                "database_get_statistics_tool",
                "database_health_check_tool",
                "codebase_get_directory_tree_tool",
                "codebase_find_files_by_pattern_tool",
                "codebase_search_content_tool",
                "codebase_get_file_content_tool",
                "codebase_analyze_statistics_tool",
                "codebase_describe_directory_tool",
                "codebase_scan_framework_apps_tool",
                "codebase_health_check_tool"
            ],
            "timeout": 120000,
            "description": "Unified MCP Server v2.0: File Processing + Database Management + Codebase Analysis (19 tools total). Consolidates McpAlchemy, CodebaseScanner, and CodebaseContentHub."
        }
    }
}