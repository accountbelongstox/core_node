{
  "service_prefix": {
    "linux": "dd-",
    "windows": "DD-"
  },
  "service_template": {
    "linux": {
      "unit": "[Unit]\nDescription=DD/NCore {AppName} Service\nAfter=network.target\n\n[Service]\nType=simple\nUser=www-data\nWorkingDirectory={AppPath}\nExecStart={StartCommand}\nRestart=always\nRestartSec=10\n\n[Install]\nWantedBy=multi-user.target",
      "file_extension": ".service"
    },
    "windows": {
      "startup_template": "@echo off\ncd /d \"{AppPath}\"\n{StartCommand}",
      "file_extension": ".bat"
    }
  },
  "required_packages": {
    "ncore-app": {
      "windows": [],
      "linux": []
    },
    "python": {
      "windows": ["uv", "uvx", "PIL", "win32api", "auto"],
      "linux": ["uv", "uvx", "PIL"]
    },
    "php": {
      "windows": ["php-extensions"],
      "linux": ["php-extensions", "www-data-permissions"]
    },
    "java": {
      "windows": ["openjdk-17"],
      "linux": ["openjdk-17-jdk"]
    },
    "go": {
      "windows": ["go"],
      "linux": ["golang-go"]
    },
    "poly-flutter": {
      "windows": ["flutter", "openjdk-17"],
      "linux": ["flutter", "openjdk-17-jdk"]
    }
  }
}
