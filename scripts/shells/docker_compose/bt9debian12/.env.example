# Cloud Provider Configuration
# Available options: huawei (default), tencent, aliyun
# Priority: Environment Variable > .env > Default
CLOUD_PROVIDER=huawei

# System Configuration
# Locale setting: cn (default) for China, en for English
ENV_LOCAL=cn
# Web root directory path
WEB_ROOT=/www
# Backup file path
BACKUP_FILE=/backup/www_backup.tar.gz

# BT Panel Configuration
# Panel access port
BT_PORT=8888
# Panel admin username (≥3 characters)
BT_USERNAME=btadmin
# Panel admin password
BT_PASSWORD=btpass@2024

# Web Server Ports
# HTTP port
HTTP_PORT=80
# HTTPS port
HTTPS_PORT=443
# SSH port
SSH_PORT=22

# Database Ports
# MySQL default port
MYSQL_PORT=3306
# Redis default port
REDIS_PORT=6379
# PostgreSQL default port
POSTGRES_PORT=5432
# MongoDB default port
MONGODB_PORT=27017

# Additional Database Ports
# SQL Server port
SQLSERVER_PORT=1433
# MySQL secondary port
MYSQL_SECOND_PORT=3307
# Redis secondary port
REDIS_SECOND_PORT=6380
# PostgreSQL secondary port
POSTGRES_SECOND_PORT=5433
# MongoDB cluster ports
MONGODB_CLUSTER_PORTS=27018,27019

# Service Port Range
# Start of port range for additional services
RANGE_PORTS_START=18000
# End of port range for additional services
RANGE_PORTS_END=19000