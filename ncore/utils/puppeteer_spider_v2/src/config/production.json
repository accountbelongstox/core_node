{
  "browser": "edge",
  "headless": true,
  "timeout": 30000,
  "retries": 3,
  "delay": 1000,
  "browserOptions": {
    "slowMo": 0,
    "devtools": false
  },
  "sessionOptions": {
    "maxPages": 10,
    "maxConcurrentRequests": 5
  },
  "plugins": {
    "download": {
      "enabled": true,
      "path": "./downloads"
    },
    "content": {
      "enabled": true,
      "extractImages": true,
      "extractLinks": true
    },
    "automation": {
      "enabled": true,
      "waitTimeout": 5000,
      "retryAttempts": 3
    }
  }
}
