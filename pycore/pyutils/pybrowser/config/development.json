{
  "browser": "chrome",
  "headless": false,
  "timeout": 60000,
  "retries": 5,
  "delay": 2000,
  "browserOptions": {
    "slowMo": 100,
    "devtools": true
  },
  "sessionOptions": {
    "maxPages": 3,
    "maxConcurrentRequests": 2
  },
  "plugins": {
    "download": {
      "enabled": true,
      "path": "./dev_downloads"
    },
    "content": {
      "enabled": true,
      "extractImages": true,
      "extractLinks": true
    },
    "automation": {
      "enabled": true,
      "waitTimeout": 10000,
      "retryAttempts": 5
    }
  }
}
