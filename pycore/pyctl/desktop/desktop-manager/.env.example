# Desktop Manager UI (pycore edition) configuration.
# Gemini has been removed; the UI talks to the local pycore backend instead.
# pyservice.ps1 / pyservice.sh export these automatically when they launch the UI.

# Port the UI server (Vite dev server / static prod) listens on.
# PySide6 loads http://localhost:<PYCORE_UI_PORT>.
PYCORE_UI_PORT=15654

# Base URL of the pycore backend the UI bridges to:
#   /api/queue  -> mapped from <PYCORE_API_BASE>/voice-subtitle/queue
#   /pyapi/*    -> transparent reverse proxy to <PYCORE_API_BASE>/*
PYCORE_API_BASE=http://localhost:59000
