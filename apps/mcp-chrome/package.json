{
  "name": "mcp-chrome-bridge-monorepo",
  "version": "1.0.0",
  "private": true,
  "author": "hangye",
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*",
    "advanced-control-panel"
  ],
  "trustedDependencies": [
    "wxt"
  ],
  "scripts": {
    "build:shared": "bun run --filter chrome-mcp-shared build",
    "build:native": "bun run --filter mcp-chrome-bridge build",
    "build:extension": "bun run --filter chrome-mcp-server build",
    "build:wasm": "bun run --filter @chrome-mcp/wasm-simd build && bun run copy:wasm",
    "build": "bun run build:shared && bun run build:native && bun run build:extension",
    "build:all": "bun run build:shared && bun run build:native && bun run build:extension",
    "copy:wasm": "cp ./packages/wasm-simd/pkg/simd_math.js ./packages/wasm-simd/pkg/simd_math_bg.wasm ./app/chrome-extension/workers/",
    "dev:shared": "bun run --filter chrome-mcp-shared dev",
    "dev:native": "bun run --filter mcp-chrome-bridge dev",
    "dev:extension": "bun run --filter chrome-mcp-server dev",
    "dev": "bun run --filter chrome-mcp-shared build && (trap 'kill $(jobs -p) 2>/dev/null' EXIT INT TERM; bun run dev:shared & bun run dev:native & bun run dev:extension & wait)",
    "register:local": "node scripts/register-local-dev.cjs",
    "unregister:local": "node scripts/unregister-local-dev.cjs",
    "setup:local": "bun run build:all && bun run register:local",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "format": "bun run --filter '*' format",
    "clean:dist": "rm -rf app/*/dist packages/*/dist .turbo",
    "clean:modules": "rm -rf app/*/node_modules packages/*/node_modules node_modules",
    "clean": "bun run clean:dist && bun run clean:modules",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vue-eslint-parser": "^10.1.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,html,css}": [
      "prettier --write"
    ]
  }
}
