{
  "_comment": "Multi-Browser Configuration for Concurrent Testing",
  "_description": "Configure multiple browser instances to run concurrently",

  "browsers": [
    {
      "name": "browser_1",
      "type": "chrome",
      "enabled": true,
      "config": {
        "headless": false,
        "driver_mode": "local",
        "driver_path": "D:/drivers/chromedriver.exe",
        "args": [
          "--start-maximized"
        ],
        "window_size": [1920, 1080],
        "user_data_dir": null,
        "download_dir": null
      },
      "test_config": {
        "test_urls": [
          "https://www.baidu.com",
          "https://www.bing.com"
        ],
        "navigation_delay": 2,
        "enable_screenshots": true,
        "screenshot_prefix": "browser1"
      }
    },
    {
      "name": "browser_2",
      "type": "chrome",
      "enabled": true,
      "config": {
        "headless": false,
        "driver_mode": "local",
        "driver_path": "D:/drivers/chromedriver.exe",
        "args": [
          "--start-maximized"
        ],
        "window_size": [1280, 720],
        "user_data_dir": null,
        "download_dir": null
      },
      "test_config": {
        "test_urls": [
          "https://github.com",
          "https://stackoverflow.com"
        ],
        "navigation_delay": 2,
        "enable_screenshots": true,
        "screenshot_prefix": "browser2"
      }
    }
  ],

  "global_config": {
    "max_concurrent_browsers": 5,
    "browser_launch_timeout": 30,
    "test_duration": 30,
    "screenshot_dir": "screenshots",
    "enable_screenshots": true,
    "retry_on_failure": true,
    "max_retries": 3,
    "retry_delay": 5
  },

  "driver_paths": {
    "chrome": "D:/drivers/chromedriver.exe",
    "edge": "D:/drivers/msedgedriver.exe",
    "firefox": "D:/drivers/geckodriver.exe"
  },

  "_instructions": {
    "driver_mode": "local | auto_download | system_path",
    "driver_path": "Full path to driver executable (used when driver_mode=local)",
    "system_path": "Uses driver from system PATH (driver_mode=system_path)",
    "auto_download": "Downloads driver automatically (requires internet, driver_mode=auto_download)",
    "example_local": "D:/drivers/chromedriver.exe",
    "example_system": "chromedriver (must be in PATH)",
    "note": "For offline usage, use driver_mode=local and specify driver_path"
  }
}
