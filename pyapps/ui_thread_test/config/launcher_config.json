{
  "ui_service": {
    "app_name": "UI Thread Test Application",
    "window_size": [1000, 700],
    "min_window_size": [800, 600],
    "frameless": true,
    "show_on_start": true,
    "resizable": true,
    "ui_source": null,
    "theme": "dark",
    "debug": true,
    "enabled": true
  },
  "web_service": {
    "host": "localhost",
    "http_port": 8000,
    "ws_port": 8001,
    "enable_https": false,
    "workers": 1,
    "reload": false,
    "log_level": "info",
    "enable_cors": true,
    "cors_origins": ["*"],
    "enabled": false
  },
  "mcp_service": {
    "singleton_port": 19997,
    "rpc_port": 8767,
    "host": "localhost",
    "debug": true,
    "auto_load_services": true,
    "service_dirs": [],
    "enabled": false
  },
  "selenium_service": {
    "browser_type": "chrome",
    "headless": false,
    "disable_gpu": true,
    "no_sandbox": true,
    "max_sessions": 5,
    "session_timeout": 3600,
    "pool_size": 3,
    "pool_timeout": 30,
    "debug": false,
    "enabled": false
  },
  "auto_start_all": false,
  "startup_delay": 0.5,
  "graceful_shutdown_timeout": 10
}
