  "overview": {
    "description": "This stage defines the complete API specification for device management and video streaming based on the correct implementation in scrcpy_web_test. Backend AI should implement these endpoints exactly as specified.",
    "baseImplementation": "D:/programing/core_node/pyapps/scrcpy_web_test",
    "specificationDoc": "D:/programing/core_node/pyapps/matrix/ai_briage/bridge_with_nuxt_pyMatrix/FRONTEND_API_SPECIFICATION.md",
    "keyChanges": [
      "Device acquisition using ADB scanning (adb devices -l)",
      "Single WebSocket endpoint (/ws) with command-based operation",
      "Binary frame format: [serial_length][serial][pts][size][H.264 data]",
      "Screenshot push every 1 second",
      "Touch event injection with proper coordinate mapping"
    ]
  },

  "apiEndpoints": {
    "http": {
      "baseUrl": "http://localhost:8000",
      "endpoints": [
        {
          "id": "GET_DEVICES",
          "method": "GET",
          "path": "/api/devices",
          "description": "Scan and return all connected ADB devices",
          "reference": "scrcpy_web_test/server.py:589-595 (handle_devices)",
          "request": {
            "headers": {
              "X-App-Namespace": "pymatrix",
              "Content-Type": "application/json"
            }
          },
          "response": {
            "success": {
              "status": 200,
              "body": {
                "devices": [
                  {
                    "serial": "string (device serial number)",
                    "model": "string (device model from ro.product.model)",
                    "manufacturer": "string (from ro.product.manufacturer)",
                    "android_version": "string (from ro.build.version.release)",
                    "status": "string (device|offline|unauthorized)"
                  }
                ],
                "count": "number (total devices)"
              }
            }
          },
          "implementation": {
            "method": "DeviceScanner.scan_devices()",
            "adbCommand": "adb devices -l",
            "propertyFetch": "adb -s {serial} shell getprop {prop}"
          }
        },
        {
          "id": "GET_DEVICE_INFO",
          "method": "GET",
          "path": "/api/devices/{serial}/info",
          "description": "Get detailed information about a specific device",
          "parameters": {
            "path": {
              "serial": "string (device serial number)"
            }
          },
          "response": {
            "success": {
              "status": 200,
              "body": {
                "device": {
                  "serial": "string",
                  "model": "string",
                  "manufacturer": "string",
                  "android_version": "string",
                  "sdk_version": "number",
                  "resolution": {
                    "width": "number",
                    "height": "number"
                  },
                  "dpi": "number"
                }
              }
            }
          }
        }
      ]
    },
    "websocket": {
      "endpoint": "ws://localhost:8000/ws",
      "description": "Single WebSocket endpoint for all device operations",
      "reference": "scrcpy_web_test/server.py:598-707 (handle_websocket)",
      "connectionConfig": {
        "binaryType": "arraybuffer",
        "protocols": []
      },
      "commands": [
        {
          "id": "START_STREAM",
          "command": "start_stream",
          "description": "Start video streaming for a device",
          "reference": "scrcpy_web_test/server.py:609-634",
          "request": {
            "command": "start_stream",
            "serial": "string (device serial)",
            "enable_recording": "boolean (optional, default: false)"
          },
          "responses": [
            {
              "type": "stream_started",
              "description": "New stream started",
              "body": {
                "type": "stream_started",
                "serial": "string",
                "info": {
                  "serial": "string",
                  "model": "string",
                  "resolution": {
                    "width": "number (after max_size scaling)",
                    "height": "number"
                  },
                  "dpi": "number",
                  "android_version": "string",
                  "sdk_version": "number"
                }
              }
            },
            {
              "type": "stream_attached",
              "description": "Attached to existing stream",
              "body": {
                "type": "stream_attached",
                "serial": "string",
                "info": "same as stream_started"
              }
            },
            {
              "type": "stream_error",
              "description": "Failed to start stream",
              "body": {
                "type": "stream_error",
                "serial": "string",
                "message": "string (error description)"
              }
            }
          ],
          "implementation": {
            "method": "VideoStreamManager.start_stream()",
            "scrcpyParams": {
              "max_size": 720,
              "max_fps": 60,
              "bit_rate": 8000000,
              "control": true
            },
            "flow": [
              "1. Check if device already streaming",
              "2. Create ScrcpyDevice instance",
              "3. Ensure scrcpy-server.jar on device",
              "4. Start scrcpy server",
              "5. Start video frame reading task",
              "6. Optional: Start FFmpeg recording",
              "7. Return device info to client"
            ]
          }
        },
        {
          "id": "STOP_STREAM",
          "command": "stop_stream",
          "description": "Stop video streaming for a device",
          "reference": "scrcpy_web_test/server.py:636-658",
          "request": {
            "command": "stop_stream",
            "serial": "string"
          },
          "responses": [
            {
              "type": "stream_stopped",
              "description": "Stream fully stopped (no more watchers)",
              "body": {
                "type": "stream_stopped",
                "serial": "string"
              }
            },
            {
              "type": "stream_detached",
              "description": "Client detached but stream still active (other watchers exist)",
              "body": {
                "type": "stream_detached",
                "serial": "string"
              }
            },
            {
              "type": "error",
              "description": "No active stream",
              "body": {
                "type": "error",
                "serial": "string",
                "message": "No active stream for {serial}"
              }
            }
          ],
          "implementation": {
            "method": "VideoStreamManager.stop_stream()",
            "behavior": "Only stops stream when no watchers remain (reference counting)"
          }
        },
        {
          "id": "TOUCH_EVENT",
          "command": "touch_event",
          "description": "Inject touch event to device",
          "reference": "scrcpy_web_test/server.py:660-699",
          "request": {
            "command": "touch_event",
            "serial": "string",
            "action": "down|move|up|double_tap",
            "x": "number (device coordinate)",
            "y": "number (device coordinate)",
            "pressure": "number (0.0 - 1.0, default: 1.0)",
            "pointerId": "number (multi-touch ID, default: 0)"
          },
          "responses": [
            {
              "type": "success",
              "description": "Touch event injected (no response)"
            },
            {
              "type": "error",
              "description": "Touch event rejected",
              "body": {
                "type": "error",
                "serial": "string",
                "message": "Invalid touch payload | Device is not streaming | Client is not attached to this stream"
              }
            }
          ],
          "implementation": {
            "method": "VideoStreamManager.handle_touch_event()",
            "coordinateMapping": "Clamp to device resolution bounds (0 ~ width-1, 0 ~ height-1)",
            "doubleTapHandling": "Simulate two quick taps with 80ms delay"
          }
        }
      ],
      "serverPush": [
        {
          "id": "VIDEO_FRAME",
          "type": "binary",
          "description": "H.264 video frame data",
          "reference": "scrcpy_web_test/server.py:372-400 (_broadcast_frame)",
          "format": {
            "description": "Binary frame with header + H.264 data",
            "structure": [
              {
                "field": "serial_length",
                "type": "uint8",
                "bytes": 1,
                "description": "Length of serial string (max 255)"
              },
              {
                "field": "serial",
                "type": "string",
                "bytes": "N",
                "description": "Device serial number (UTF-8 encoded)"
              },
              {
                "field": "pts",
                "type": "uint64",
                "bytes": 8,
                "endian": "big",
                "description": "Presentation timestamp with flags in high bits"
              },
              {
                "field": "size",
                "type": "uint32",
                "bytes": 4,
                "endian": "big",
                "description": "Size of H.264 data in bytes"
              },
              {
                "field": "h264_data",
                "type": "bytes",
                "bytes": "N",
                "description": "Raw H.264 NAL units"
              }
            ],
            "ptsFlags": {
              "PTS_MASK": "0x3FFFFFFFFFFFFFFF (low 62 bits)",
              "FLAG_CONFIG_FRAME": "0x8000000000000000 (bit 63: SPS/PPS config frame)",
              "FLAG_KEY_FRAME": "0x4000000000000000 (bit 62: I-frame)"
            }
          },
          "parsing": {
            "example": "See FRONTEND_API_SPECIFICATION.md section 'Video Binary Protocol'"
          }
        },
        {
          "id": "SCREENSHOT",
          "type": "json",
          "description": "Screenshot push (every 1 second)",
          "reference": "scrcpy_web_test/server.py:435-472 (_capture_and_broadcast_screenshot)",
          "interval": "1000ms",
          "body": {
            "type": "screenshot",
            "serial": "string",
            "data": "string (PNG image as base64)"
          },
          "implementation": {
            "method": "adb -s {serial} exec-out screencap -p",
            "encoding": "base64"
          }
        },
        {
          "id": "ERROR",
          "type": "json",
          "description": "Error notification",
          "body": {
            "type": "error",
            "serial": "string (optional)",
            "message": "string (error description)"
          }
        }
      ]
    }
  },

