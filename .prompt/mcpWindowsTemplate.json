            "env": {
                "MCP_DEBUG": "false",
                "MCP_WEB_HOST": "127.0.0.1",
                "MCP_WEB_PORT": "8765",
                "MCP_LANGUAGE": "en"
            },
            "disabled": false,
            "autoApprove": []
        },
        "PlaceholderImageGenerator": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:\\programing\\core_node\\ncore\\mcp_server\\placeholder_image_generator\\main.py"
            ],
            "env": {
                "PYTHONPATH": "D:\\programing\\core_node\\ncore\\mcp_server\\placeholder_image_generator",
                "MCP_ALLOW_ALL_PATHS": "true"
