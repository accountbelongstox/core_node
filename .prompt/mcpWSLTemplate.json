{
    "mcpServers": {
        "github.com/upstash/context7-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "disabled": false,
            "autoApprove": [],
            "timeout": 60000
        },
        "McpAlchemy": {
            "command": "python3",
            "args": [
                "/mnt/d/programing/core_node/ncore/mcp_server/mcp-alchemy/main.py"
            ],
            "env": {
                "EXECUTE_QUERY_MAX_CHARS": "4000"
            },
            "disabled": false,
            "autoApprove": [
                "get_namespace_guide",
                "start_namespace_negotiation",
                "confirm_namespace",
                "list_session_databases",
                "register_database",
                "all_table_names",
                "filter_table_names",
                "schema_definitions",
                "get_database_info",
                "batch_insert",
                "batch_update",
                "batch_delete",
                "batch_upsert",
                "batch_select",
                "analyze_table_performance",
                "create_optimized_index",
                "get_database_stats"
            ]
        },
        "AlibabaDataworks": {
            "command": "node",
            "args": [
                "alibabacloud-dataworks-mcp-server"
            ],
            "env": {
                "REGION": "your_dataworks_open_api_region_id_here",
                "ALIBABA_CLOUD_ACCESS_KEY_ID": "your_alibaba_cloud_access_key_id",
                "ALIBABA_CLOUD_ACCESS_KEY_SECRET": "your_alibaba_cloud_access_key_secret",
                "TOOL_CATEGORIES": "optional_your_tool_categories_here_ex_UTILS",
                "TOOL_NAMES": "optional_your_tool_names_here_ex_ListProjects"
            },
            "disabled": true,
            "autoApprove": []
        },
        "FeedbackEnhanced": {
            "command": "uvx",
            "args": [
                "mcp-feedback-enhanced@latest"
            ],
            "env": {
                "MCP_DEBUG": "false",
                "MCP_WEB_HOST": "127.0.0.1",
                "MCP_WEB_PORT": "8765",
                "MCP_LANGUAGE": "en"
            },
            "disabled": false,
            "autoApprove": []
        },
        "PlaceholderImageGenerator": {
            "command": "python3",
            "args": [
                "/mnt/d/programing/core_node/ncore/mcp_server/placeholder_image_generator/main.py"
            ],
            "env": {
                "MCP_ALLOW_ALL_PATHS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "generate_placeholder",
                "list_placeholders",
                "check_path_access",
                "health_check"
            ]
        },
        "FileProcessor": {
            "command": "python3",
            "args": [
                "/mnt/d/programing/core_node/ncore/mcp_server/file_processor/main.py"
            ],
            "env": {
                "MCP_ALLOW_ALL_PATHS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "parse_document",
                "convert_document",
                "write_document",
                "batch_convert",
                "list_supported_formats",
                "list_conversion_formats",
                "initialize_packages",
                "ocr_recognize",
                "configure_ocr",
                "list_ocr_engines",
                "smart_ocr_recognize",
                "get_ocr_task_status",
                "get_ocr_batch_status",
                "get_ocr_system_status",
                "analyze_image_pixels",
                "health_check"
            ]
        },
        "CodebaseScanner": {
            "command": "python3",
            "args": [
                "/mnt/d/programing/core_node/ncore/mcp_server/codebase-scanner/main.py"
            ],
            "env": {
                "ENABLE_GLOBAL_ACCESS": "true"
            },
            "disabled": false,
            "autoApprove": [
                "generate_directory_tree",
                "find_file_by_name",
                "search_content_in_files",
                "get_codebase_stats",
                "find_file_by_path",
                "scan_flutter_apps",
                "print_flutter_app_structure",
                "health_check"
            ]
        }
    }
}