APP_NAME=LaravelMain
APP_ENV=local
APP_KEY=base64:oVL7quEZpvODR84woa2rcePXTXHbhNXC2OXcVdJ2Y+M=
APP_DEBUG=true
APP_URL=
FRONTEND_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_LEVEL=debug
LOG_CHANNEL=syslog
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Database configuration is intentionally NOT taken from .env.
# The app runs on PostgreSQL on ALL platforms; driver/host/port/user/database are
# fixed in config/database.php and the password is read from the global-var secret
# store via App\Support\CoreNodeSecrets (set by start.sh / start.ps1). Any DB_* or
# POLY_DB_DRIVER line here is ignored by the active database connections by design.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime is the Mercure hub on the frankenphp plane (App\Services\Relay);
# the broadcasting container stays on the log driver. Translation keeps
# its durable HTTP stream as an independent worker coordination path.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Client Token Authentication
CLIENT_TOKEN_DEFAULT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
DEBUG_TOKEN_DEFAULT="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY=" 

EXTERNAL_STORAGE_AUTO_CREATE=true

# ServerManagerV1 API Configuration
SERVER_MANAGER_API_KEY="sm-api-key-2025-secure-production-key"

OCTANE_SERVER=swoole
LARAVEL_OCTANE=1

# AppQyV1 TTS Configuration
APPQYV1_TTS_AUTO_GENERATION=true

# (Database/POLY_DB_DRIVER settings intentionally omitted -- see the note near the
# top of this file; config/database.php is the single source of truth.)
