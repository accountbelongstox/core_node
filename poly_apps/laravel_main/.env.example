APP_NAME=LaravelMain
APP_ENV=local
APP_KEY=base64:D3INqFjoHEhRxZ1beVuJpoQlAB6AhMm/W0RXaPXfsRs=
APP_DEBUG=true
APP_URL=
FRONTEND_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_LEVEL=debug
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Database configuration is intentionally NOT taken from .env.
# The app runs on PostgreSQL on ALL platforms; driver/host/port/user/database are
# fixed in config/database.php and the password is read from the global-var secret
# store via App\Support\CoreNodeSecrets (set by start.sh / start.ps1). Any DB_* or
# POLY_DB_DRIVER line here is ignored by the active database connections by design.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time broadcasting driver. Use "reverb" to run the Reverb WebSocket layer
# that powers the translation pipeline (pycore subscribes to `translation-queue`).
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Client Token Authentication
CLIENT_TOKEN_DEFAULT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
DEBUG_TOKEN_DEFAULT="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY=" 

EXTERNAL_STORAGE_AUTO_CREATE=true

# --- Laravel Reverb (real-time broadcast layer for the translation pipeline) ---
# Reverb speaks the Pusher protocol on a public `translation-queue` channel that
# pycore workers subscribe to. Run it as its own process: `php artisan reverb:start`.
REVERB_APP_ID=task-system
REVERB_APP_KEY=reverb-key-local
REVERB_APP_SECRET=reverb-secret-local
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}" 
