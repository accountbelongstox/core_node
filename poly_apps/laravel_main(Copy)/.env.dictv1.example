# DictV1 App Configuration Example
# Copy this to your .env file and adjust paths as needed

# External Data Storage Path (absolute path)
# This directory will store databases, audio, and image files
DICT_EXTERNAL_DATA_PATH="D:\programing\core_node\external_dict_data"

# Database Configuration for DictV1
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# DictV1 Specific Settings
DICT_V1_ENABLE_INITIALIZATION=true
DICT_V1_AUTO_CREATE_DIRECTORIES=true
DICT_V1_MAX_AUDIO_SIZE=10240
DICT_V1_MAX_IMAGE_SIZE=5120
DICT_V1_SUPPORTED_AUDIO_FORMATS="mp3,wav,ogg"
DICT_V1_SUPPORTED_IMAGE_FORMATS="jpg,jpeg,png,gif,webp"

# Google Drive URLs for legacy data (update these with actual URLs)
DICT_V1_LEGACY_DB_DOWNLOAD_URL="https://drive.google.com/file/d/YOUR_DB_FILE_ID/view"
DICT_V1_LEGACY_AUDIO_DOWNLOAD_URL="https://drive.google.com/file/d/YOUR_AUDIO_FILE_ID/view"
DICT_V1_LEGACY_IMAGES_DOWNLOAD_URL="https://drive.google.com/file/d/YOUR_IMAGES_FILE_ID/view"