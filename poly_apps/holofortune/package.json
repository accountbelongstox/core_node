{
  "name": "holofortune-ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "prestart": "node -e \"require('react-native') || process.exit(1)\" || echo 'React Native not found, please run: pnpm install'",
    "start:script": "node scripts/start.js",
    "start:win": "scripts\\start.bat",
    "start:ps1": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "start:unix": "bash scripts/start.sh",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:ios": "cd ios && xcodebuild -workspace holofortune.xcworkspace -scheme holofortune -configuration Release archive",
    "clean": "rm -rf node_modules && rm -rf ios/Pods && rm -rf ios/build && rm -rf android/build && rm -rf android/app/build",
    "clean:install": "npm run clean && npm install && cd ios && pod install && cd ..",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "^20.0.2",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.8.8",
    "@react-navigation/native": "^7.1.22",
    "@react-navigation/native-stack": "^7.8.2",
    "clsx": "2.1.0",
    "react": "18.3.1",
    "react-native": "0.82.1",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-maps": "^1.18.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/runtime": "^7.25.6",
    "@react-native/babel-preset": "^0.82.1",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/metro-config": "^0.82.1",
    "@react-native/typescript-config": "^0.82.1",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
