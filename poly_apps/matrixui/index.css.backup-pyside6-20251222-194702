@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  /* Palette */
  --bg-void: #030305;
  --bg-panel: rgba(10, 12, 16, 0.85);
  --cyan: #00f2ff;
  --cyan-dim: rgba(0, 242, 255, 0.15);
  --purple: #bd00ff;
  --purple-dim: rgba(189, 0, 255, 0.15);
  --alert: #ff2a6d;
  --success: #05ffa1;
  --text-main: #ffffff;
  --text-muted: rgba(255, 255, 255, 0.55);

  /* Glass */
  --glass-border: 1px solid rgba(255, 255, 255, 0.08);
  --backdrop: blur(20px);
}

body {
  background-color: var(--bg-void);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
  color: var(--text-main);
  overflow: hidden;
  /* Fix: Prevent gradient animation flickering */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Custom Scrollbar */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.3); }

/* Utility Classes */
.glass-panel {
  background: var(--bg-panel);
  backdrop-filter: var(--backdrop);
  -webkit-backdrop-filter: var(--backdrop);
  border: var(--glass-border);
}

/* Animations */
@keyframes float {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  100% { transform: translate3d(30px, -30px, 0) scale(1.1); }
}

@keyframes move-background {
  0% { background-position: 0 0; }
  100% { background-position: 100px 100px; }
}

@keyframes scan {
  0% { top: -10%; opacity: 0; }
  50% { opacity: 1; }
  100% { top: 110%; opacity: 0; }
}

@keyframes gradient-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.3;
  animation: float 25s infinite ease-in-out alternate;
  z-index: 0;
  /* Fix: Hardware acceleration for smooth animation */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  will-change: transform;
}
.blob-1 { width: 60vw; height: 60vw; background: var(--cyan); top: -20%; left: -10%; }
.blob-2 { width: 50vw; height: 50vw; background: var(--purple); bottom: -10%; right: -10%; animation-delay: -5s; }

.scanlines {
  background: linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
  background-size: 100% 4px;
  pointer-events: none;
  animation: move-background 60s linear infinite;
  /* Fix: Hardware acceleration for smooth scanline animation */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.noise-bg {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='1'/%3E%3C/svg%3E");
  opacity: 0.04;
}

.dynamic-bg {
  background: linear-gradient(-45deg, #030305, #0f1219, #14081f, #051419);
  background-size: 400% 400%;
  animation: gradient-flow 15s ease infinite;
  /* Fix: Hardware acceleration for smooth gradient animation */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  will-change: background-position;
}

/* Form Elements for Settings */
.form-radio:checked {
  background-color: var(--cyan);
  border-color: var(--cyan);
}
.form-checkbox:checked {
  background-color: var(--cyan);
  border-color: var(--cyan);
}

