<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider roots: every place the app stores files (DeviceStorage.openFile / shareFile). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="app_files" path="." />
    <cache-path name="app_cache" path="." />
    <external-files-path name="external_app_files" path="." />
    <external-cache-path name="external_app_cache" path="." />
    <external-path name="shared_storage" path="." />
    <!-- Removable volumes (SD cards) are outside the external-path root. -->
    <root-path name="volumes" path="/storage" />
</paths>
