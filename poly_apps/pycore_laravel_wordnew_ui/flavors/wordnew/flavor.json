{
  "id": "wordnew",
  "name": "WordNew",
  "shortName": "WordNew",
  "appId": "com.corenode.wordnew",
  "version": "1.0.0",
  "rootRoute": "/wordnew",
  "entry": "apps/wordnew/WfNewApp.tsx",
  "platforms": [
    "web",
    "android"
  ],
  "standalone": {
    "switcher": {
      "enabled": true,
      "visible": false
    }
  },
  "themeColor": "#4f46e5",
  "backgroundColor": "#0f172a",
  "description": "WordNew — AI vocabulary learning client (study, libraries, walkman, social).",
  "names": {
    "en": "WordNew",
    "zh": "千语单词",
    "zh-Hant": "千語單詞"
  },
  "brand": {
    "icon": "apps/wordnew/assets/wordnew-logo-source.png"
  },
  "launch": {
    "native": {
      "background": "#0f172a",
      "backgroundDark": "#020617",
      "iconScale": 0.44,
      "logoScale": 0.28
    },
    "web": {
      "mode": "logo",
      "show": "always",
      "durationMs": 1400,
      "skippable": true,
      "tagline": {
        "en": "Every word, every language",
        "zh": "千种语言，一词一得"
      },
      "slides": []
    }
  }
}
