{
  "id": "wordnew",
  "name": "WordNew",
  "shortName": "WordNew",
  "appId": "com.corenode.wordnew",
  "version": "1.0.0",
  "rootRoute": "/wordnew",
  "entry": "apps/wordnew/WfNewApp.tsx",
  "platforms": [
    "web",
    "android",
    "desktop"
  ],
  "standalone": {
    "switcher": {
      "enabled": true,
      "visible": false
    }
  },
  "themeColor": "#4f46e5",
  "backgroundColor": "#0f172a",
  "description": "WordNew — AI vocabulary learning client (study, libraries, walkman, social).",
  "names": {
    "en": "WordNew",
    "zh": "千语单词",
    "zh-Hant": "千語單詞"
  },
  "brand": {
    "icon": "apps/wordnew/assets/wordnew-logo-source.png"
  },
  "launch": {
    "native": {
      "background": "#0f172a",
      "backgroundDark": "#020617",
      "iconScale": 0.44,
      "logoScale": 0.28
    },
    "web": {
      "mode": "slides",
      "show": "daily",
      "durationMs": 1400,
      "skippable": true,
      "tagline": {
        "en": "Every word, every language",
        "zh": "千种语言，一词一得"
      },
      "slides": [
        {
          "image": "apps/wordnew/assets/launch/wordnew-launch-1.webp",
          "focus": "50% 32%",
          "caption": {
            "en": "Discover every word",
            "zh": "发现每一个单词"
          }
        },
        {
          "image": "apps/wordnew/assets/launch/wordnew-launch-2.webp",
          "focus": "50% 30%",
          "caption": {
            "en": "Listen and learn anywhere",
            "zh": "随时随地，边听边学"
          }
        },
        {
          "image": "apps/wordnew/assets/launch/wordnew-launch-3.webp",
          "focus": "50% 30%",
          "caption": {
            "en": "Every language, one app",
            "zh": "千种语言，一个应用"
          }
        },
        {
          "image": "apps/wordnew/assets/launch/wordnew-launch-4.webp",
          "focus": "50% 28%",
          "caption": {
            "en": "Grow a little every day",
            "zh": "每天进步一点点"
          }
        }
      ],
      "slideMs": 2200
    }
  }
}
