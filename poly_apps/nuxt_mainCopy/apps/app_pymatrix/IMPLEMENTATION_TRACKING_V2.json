    },
    "apiCentralization": {
      "status": "implemented",
      "services": [
        "services/api/pymatrix/pymatrix-config-api.ts",
        "composables/useWSRPC.ts",
        "composables/useDeviceControl.ts",
        "composables/useVideoStream.ts"
