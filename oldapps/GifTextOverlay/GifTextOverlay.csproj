<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GifTextOverlay</RootNamespace>
    <AssemblyName>GifTextOverlay</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.3" />
    <PackageReference Include="SixLabors.Fonts" Version="2.0.3" />
  </ItemGroup>
  <ItemGroup>
    <TtfsFonts Include="$(MSBuildThisFileDirectory)ttfs\**\*.ttf" />
    <TtfsFonts Include="$(MSBuildThisFileDirectory)ttfs\**\*.otf" />
    <TtfsFonts Include="$(MSBuildThisFileDirectory)ttfs\**\*.ttc" />
  </ItemGroup>
  <Target Name="CopyTtfsFonts" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)ttfs" Condition="!Exists('$(TargetDir)ttfs')" />
    <Copy SourceFiles="@(TtfsFonts)" DestinationFolder="$(TargetDir)ttfs\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
