<Window x:Class="GifTextOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GifTextOverlay"
        Title="GIF 文字叠加"
        Width="1000" Height="820"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:PathToImageConverter x:Key="PathToImage"/>
    <local:PathToFileNameConverter x:Key="PathToFileName"/>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="300"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="420" MinWidth="320" MaxWidth="700"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧：设置 -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <GroupBox Header="源目录（扫描此目录下所有 GIF）" Margin="0,0,0,8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TbSourceDir" Grid.Column="0" Margin="4" VerticalContentAlignment="Center"
                       Text="D:\programing\core_node\.temp_gifs" TextChanged="TbSourceDir_TextChanged"/>
              <Button Grid.Column="1" Content="浏览..." Margin="4" Padding="12,4" Click="BrowseSource_OnClick"/>
            </Grid>
            <CheckBox x:Name="CbScanRecursive" Content="包含子目录" Margin="4,2" IsChecked="False"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="文字背景" Margin="0,0,0,8">
          <StackPanel>
            <RadioButton x:Name="RbGifFrame" Content="使用 GIF 帧复制" IsChecked="True" Margin="4,2"/>
            <RadioButton x:Name="RbRandomFolder" Content="从文件夹随机（背景图目录）" Margin="4,2"/>
            <RadioButton x:Name="RbSpecified" Content="指定图片" Margin="4,2"/>
            <Grid Margin="4,4,4,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TbBgPath" Grid.Column="0" IsEnabled="False" VerticalContentAlignment="Center"/>
              <Button x:Name="BtnBrowseBg" Grid.Column="1" Content="..." Margin="4,0,0,0" Padding="8,2" Click="BrowseBg_OnClick"/>
            </Grid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="文字区域" Margin="0,0,0,8">
          <StackPanel>
            <ListBox x:Name="LbTextAreas" Height="80" Margin="4" SelectionChanged="LbTextAreas_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="4,2">
              <Button Content="+ 添加文字区域" Padding="8,4" Click="AddTextArea_OnClick"/>
              <Button x:Name="BtnRemoveTextArea" Content="删除选中" Padding="8,4" Margin="8,0,0,0" Click="RemoveTextArea_OnClick" IsEnabled="False"/>
            </StackPanel>
            <Expander x:Name="ExpanderTextAreaDetail" Header="选中区域设置" IsExpanded="True" Margin="4,4,4,0">
              <StackPanel x:Name="PanelTextAreaDetail" IsEnabled="False">
                <TextBlock Text="文字内容:" Margin="4,2"/>
                <TextBox x:Name="TbText" Margin="4,2" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="TbText_TextChanged"/>
                <TextBlock Text="效果:" Margin="4,8,4,2"/>
                <ComboBox x:Name="CbEffect" Margin="4,2" SelectionChanged="CbEffect_SelectionChanged"/>
                <StackPanel x:Name="PanelCustomEffect" Visibility="Collapsed" Margin="4,4">
                  <TextBlock Text="自定义填充色（多色用逗号分隔，如 white,#FF0000）:"/>
                  <TextBox x:Name="TbCustomFill" Margin="0,2" Text="white" TextChanged="CustomEffect_Changed"/>
                  <TextBlock Text="阴影 颜色/Dx/Dy/半径:" Margin="0,4,0,2"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TbCustomShadowColor" Width="70" Margin="0,0,4,0" Text="black" TextChanged="CustomEffect_Changed"/>
                    <TextBox x:Name="TbCustomShadowDx" Width="40" Margin="0,0,4,0" Text="6" TextChanged="CustomEffect_Changed"/>
                    <TextBox x:Name="TbCustomShadowDy" Width="40" Margin="0,0,4,0" Text="6" TextChanged="CustomEffect_Changed"/>
                    <TextBox x:Name="TbCustomShadowRadius" Width="40" Text="2" TextChanged="CustomEffect_Changed"/>
                  </StackPanel>
                  <TextBlock Text="描边 颜色/宽度:" Margin="0,4,0,2"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TbCustomOutlineColor" Width="70" Margin="0,0,4,0" Text="black" TextChanged="CustomEffect_Changed"/>
                    <TextBox x:Name="TbCustomOutlineWidth" Width="40" Text="3" TextChanged="CustomEffect_Changed"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="位置 Left/Top/Right/Bottom %:" Margin="4,8,4,2"/>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                  <TextBox x:Name="TbPosLeft" Width="45" Margin="0,0,4,0" Text="5" TextChanged="Position_Changed"/>
                  <TextBox x:Name="TbPosTop" Width="45" Margin="0,0,4,0" Text="5" TextChanged="Position_Changed"/>
                  <TextBox x:Name="TbPosRight" Width="45" Margin="0,0,4,0" Text="5" TextChanged="Position_Changed"/>
                  <TextBox x:Name="TbPosBottom" Width="45" Margin="0,0,4,0" Text="5" TextChanged="Position_Changed"/>
                </StackPanel>
                <TextBlock Text="对齐 水平/垂直:" Margin="4,4,4,2"/>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                  <ComboBox x:Name="CbHAlign" Width="70" Margin="0,0,8,0" SelectionChanged="Alignment_Changed">
                    <ComboBoxItem Content="左" Tag="0"/>
                    <ComboBoxItem Content="居中" Tag="1"/>
                    <ComboBoxItem Content="右" Tag="2"/>
                  </ComboBox>
                  <ComboBox x:Name="CbVAlign" Width="70" SelectionChanged="Alignment_Changed">
                    <ComboBoxItem Content="上" Tag="0"/>
                    <ComboBoxItem Content="居中" Tag="1"/>
                    <ComboBoxItem Content="下" Tag="2"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock Text="字体间距/拉伸:" Margin="4,8,4,2"/>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                  <TextBlock Text="间距:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBox x:Name="TbLetterSpacing" Width="50" Margin="0,0,12,0" Text="0" VerticalContentAlignment="Center" ToolTip="像素，正=拉开负=靠近" TextChanged="Typography_Changed"/>
                  <TextBlock Text="拉伸:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBox x:Name="TbFontStretch" Width="50" Text="1" VerticalContentAlignment="Center" ToolTip="1=正常，1.2=120%宽" TextChanged="Typography_Changed"/>
                </StackPanel>
                <TextBlock Text="字体:" Margin="4,8,4,2"/>
                <ComboBox x:Name="CbFont" Margin="4,2" SelectionChanged="CbFont_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" Margin="4,4">
                  <CheckBox x:Name="CbAutoFont" Content="自动字号" IsChecked="True" VerticalAlignment="Center" Checked="CbAutoFont_Changed" Unchecked="CbAutoFont_Changed"/>
                  <TextBlock Text="手动:" VerticalAlignment="Center" Margin="16,0,4,0"/>
                  <TextBox x:Name="TbFontSize" Width="50" IsEnabled="False" Text="48" VerticalContentAlignment="Center" TextChanged="TbFontSize_TextChanged"/>
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="文字帧持续时间（秒）" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Margin="4">
            <TextBox x:Name="TbTextFrameSec" Width="60" Text="2" VerticalContentAlignment="Center"/>
            <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="生成效果（勾选则对该效果各生成一份）" Margin="0,0,0,8">
          <WrapPanel x:Name="WrapEffectCheckboxes" Margin="4"/>
        </GroupBox>

        <GroupBox Header="生成目录" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TbOutputDir" Grid.Column="0" Margin="4" VerticalContentAlignment="Center" Text="D:\programing\core_node\.temp_gifs"/>
            <Button Grid.Column="1" Content="浏览..." Margin="4" Padding="12,4" Click="BrowseOutput_OnClick"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="日志" Margin="0,0,0,8">
          <TextBox x:Name="TbLog" Margin="4" Height="80" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </GroupBox>

        <Button x:Name="BtnGenerate" Content="生成" Height="36" FontSize="14" Click="Generate_OnClick"/>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E0E0E0"/>

    <!-- 右侧：预览 + Giphy + GIF 列表 -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <GroupBox Grid.Row="0" Header="插入帧预览（文字+效果+位置）" Margin="0,0,0,8">
        <Border BorderBrush="#888" BorderThickness="1" Margin="4" Background="#333">
          <Image x:Name="ImgPreview" Stretch="Uniform" MaxHeight="200" MinHeight="120"/>
        </Border>
      </GroupBox>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Giphy 在线下载" Margin="0,0,0,8">
          <StackPanel>
            <TextBox x:Name="TbGiphyApiKey" Margin="4,2" VerticalContentAlignment="Center" ToolTip="在 giphy.com 注册获取"/>
            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="4,2">
              <WrapPanel x:Name="WrapGiphyKeywords"/>
            </ScrollViewer>
            <TextBox x:Name="TbGiphyCustom" Margin="4,2" VerticalContentAlignment="Center" ToolTip="自定义关键词 空格分隔"/>
            <Button x:Name="BtnGiphyDownload" Content="下载到源目录" Margin="4,4" Padding="8,4" Click="GiphyDownload_OnClick"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="源 GIF 列表（可滚动，右键删除/重命名）" Margin="0,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4">
            <ListBox x:Name="LbGifs" SelectionMode="Extended" BorderThickness="0" SelectionChanged="LbGifs_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#CCC" BorderThickness="1" Margin="4" Padding="4" CornerRadius="4" MouseRightButtonDown="GifItem_RightClick">
                    <StackPanel Width="100">
                      <Image Source="{Binding Converter={StaticResource PathToImage}}" Width="96" Height="72" Stretch="UniformToFill"/>
                      <TextBlock Text="{Binding Converter={StaticResource PathToFileName}}" TextTrimming="CharacterEllipsis" MaxWidth="100" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="删除" Click="DeleteGif_OnClick"/>
                        <MenuItem Header="重命名" Click="RenameGif_OnClick"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </GroupBox>
      </Grid>
    </Grid>
  </Grid>
</Window>
