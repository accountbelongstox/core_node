<Window x:Class="DotCore.VocAnnotatorUI.AnnotatorInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
  <StackPanel Margin="20,4,20,20">
    <TextBlock x:Name="LblPrompt" Style="{StaticResource FieldLabelTextStyle}"/>
    <TextBox x:Name="TxtValue" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnCancel" MinWidth="88" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="BtnOk" MinWidth="88" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnOk_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
