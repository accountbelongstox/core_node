<Window x:Class="DotCore.VocAnnotatorUI.AnnotatorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DotCore.UITheme;assembly=DotCore.UITheme"
        Width="560" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}">
  <Window.Resources>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="96"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Margin" Value="{StaticResource FieldMargin}"/>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="{StaticResource FieldMargin}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelTextStyle}">
      <Setter Property="Margin" Value="0,0,12,8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20,4,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="LblEditing" Style="{StaticResource SectionHeaderTextStyle}"/>
            <CheckBox x:Name="ChkAutoSave" Style="{StaticResource Check}"/>
            <CheckBox x:Name="ChkCopyPrevious" Style="{StaticResource Check}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblMinBox" Style="{StaticResource Label}"/>
              <TextBox x:Name="TxtMinBox" Grid.Column="1" Style="{StaticResource NumberBox}"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="LblDisplay" Style="{StaticResource SectionHeaderTextStyle}"/>
            <CheckBox x:Name="ChkShowLabels" Style="{StaticResource Check}"/>
            <CheckBox x:Name="ChkCrosshair" Style="{StaticResource Check}"/>
            <CheckBox x:Name="ChkFitOnOpen" Style="{StaticResource Check}">
              <CheckBox.ContentTemplate>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
              </CheckBox.ContentTemplate>
            </CheckBox>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LblOpacity" Style="{StaticResource Label}"/>
              <TextBox x:Name="TxtOpacity" Grid.Column="1" Style="{StaticResource NumberBox}"/>
              <TextBlock x:Name="LblLineWidth" Grid.Row="1" Style="{StaticResource Label}"/>
              <TextBox x:Name="TxtLineWidth" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"/>
              <TextBlock x:Name="LblSort" Grid.Row="2" Style="{StaticResource Label}"/>
              <ComboBox x:Name="CboSort" Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="{StaticResource FieldMargin}"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="LblFiles" Style="{StaticResource SectionHeaderTextStyle}"/>
            <CheckBox x:Name="ChkWriteVoc" Style="{StaticResource Check}"/>
            <CheckBox x:Name="ChkWriteYolo" Style="{StaticResource Check}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0">
          <StackPanel>
            <TextBlock x:Name="LblAi" Style="{StaticResource SectionHeaderTextStyle}"/>
            <TextBlock x:Name="LblModel" Style="{StaticResource FieldLabelTextStyle}"/>
            <DockPanel Margin="{StaticResource FieldMargin}">
              <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
              <TextBox x:Name="TxtModel"/>
            </DockPanel>
            <TextBlock x:Name="TxtModelHint" Style="{StaticResource CaptionTextStyle}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LblConfidence" Style="{StaticResource Label}"/>
              <TextBox x:Name="TxtConfidence" Grid.Column="1" Style="{StaticResource NumberBox}"/>
              <TextBlock x:Name="LblIou" Grid.Row="1" Style="{StaticResource Label}"/>
              <TextBox x:Name="TxtIou" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"/>
              <TextBlock x:Name="LblMode" Grid.Row="2" Style="{StaticResource Label}"/>
              <ComboBox x:Name="CboMode" Grid.Row="2" Grid.Column="1" Margin="{StaticResource FieldMargin}"/>
            </Grid>
            <CheckBox x:Name="ChkAddClasses" Style="{StaticResource Check}"/>
            <CheckBox x:Name="ChkAutoLabelOnOpen" Style="{StaticResource Check}" Margin="0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnCancel" MinWidth="96" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="BtnOk" MinWidth="96" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnOk_Click"/>
    </StackPanel>
  </Grid>
</Window>
