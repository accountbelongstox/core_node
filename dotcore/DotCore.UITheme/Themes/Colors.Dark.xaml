<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Fluent 2 dark palette. Same key set as Colors.Light.xaml; swapped at runtime by ThemeManager. Reference brushes with DynamicResource. -->
  <sys:String x:Key="ThemeVariantName">dark</sys:String>
  <Color x:Key="AccentColor">#60CDFF</Color>
  <Color x:Key="ShadowColor">#000000</Color>
  <!-- Surfaces (layered) -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
  <SolidColorBrush x:Key="LayerFillBrush" Color="#282828"/>
  <SolidColorBrush x:Key="LayerStrokeBrush" Color="#1C1C1C"/>
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2F2F2F"/>
  <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="CardStrokeBrush" Color="#1D1D1D"/>
  <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#3D3D3D"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="SmokeFillBrush" Color="#4D000000"/>
  <!-- Controls -->
  <SolidColorBrush x:Key="ControlFillBrush" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#404040"/>
  <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#353535"/>
  <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#333333"/>
  <SolidColorBrush x:Key="ControlStrokeBrush" Color="#474747"/>
  <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#9A9A9A"/>
  <SolidColorBrush x:Key="ControlStrokeDisabledBrush" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#10FFFFFF"/>
  <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="FocusStrokeInnerBrush" Color="#000000"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#C5C5C5"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A"/>
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#707070"/>
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000"/>
  <SolidColorBrush x:Key="TextOnAccentDisabledBrush" Color="#A7A7A7"/>
  <SolidColorBrush x:Key="TextOnSemanticBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#99EBFF"/>
  <!-- Accent -->
  <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#5BBDEA"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#52A9D2"/>
  <SolidColorBrush x:Key="AccentDisabledBrush" Color="#434343"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F3447"/>
  <!-- Semantic -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
  <SolidColorBrush x:Key="SuccessHoverBrush" Color="#138A13"/>
  <SolidColorBrush x:Key="SuccessPressedBrush" Color="#0B6A0B"/>
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#393D1B"/>
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="WarningHoverBrush" Color="#AD6800"/>
  <SolidColorBrush x:Key="WarningPressedBrush" Color="#8A5100"/>
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="#433519"/>
  <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="DangerHoverBrush" Color="#D13A2B"/>
  <SolidColorBrush x:Key="DangerPressedBrush" Color="#AE2416"/>
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#442726"/>
  <SolidColorBrush x:Key="DangerTextBrush" Color="#FF99A4"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#0063B1"/>
  <SolidColorBrush x:Key="InfoHoverBrush" Color="#0A6FC2"/>
  <SolidColorBrush x:Key="InfoPressedBrush" Color="#005A9E"/>
  <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1F3447"/>
  <SolidColorBrush x:Key="InfoTextBrush" Color="#60CDFF"/>
  <!-- Legacy keys (d3check palette names; kept for existing pages) -->
  <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#282828"/>
  <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#2F2F2F"/>
  <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#353535"/>
  <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="BackgroundLightBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="BackgroundHoverBrush" Color="#383838"/>
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2F2F2F"/>
  <SolidColorBrush x:Key="PanelHeaderBrush" Color="#353535"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99EBFF"/>
  <SolidColorBrush x:Key="TextDarkBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="TextAccentBrush" Color="#99EBFF"/>
  <SolidColorBrush x:Key="TextSuccessBrush" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="TextWarningBrush" Color="#FCE100"/>
  <SolidColorBrush x:Key="TextErrorBrush" Color="#FF99A4"/>
  <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#60CDFF"/>
  <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#5BBDEA"/>
  <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="ButtonSuccessBrush" Color="#107C10"/>
  <SolidColorBrush x:Key="ButtonDangerBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="ButtonAccentBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="ButtonInfoBrush" Color="#0063B1"/>
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#353535"/>
  <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#474747"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#60CDFF"/>
  <SolidColorBrush x:Key="BorderPrimaryBrush" Color="#60CDFF"/>
  <SolidColorBrush x:Key="BorderSecondaryBrush" Color="#FF99A4"/>
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#454545"/>
  <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#3D3D3D"/>
  <SolidColorBrush x:Key="TabUnselectedBackgroundBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="TabUnselectedForegroundBrush" Color="#C5C5C5"/>
  <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#10FFFFFF"/>
  <SolidColorBrush x:Key="AccentDefaultBrush" Color="#60CDFF"/>
  <SolidColorBrush x:Key="AccentBlueBrush" Color="#4CC2FF"/>
  <SolidColorBrush x:Key="AccentCyanBrush" Color="#5DD9E8"/>
  <SolidColorBrush x:Key="AccentRedBrush" Color="#FF99A4"/>
  <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FFB066"/>
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#6CCB5F"/>
  <!-- Elevation shadows (apply to a background-only element behind content to keep ClearType text) -->
  <DropShadowEffect x:Key="FlyoutShadowEffect" Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.38"/>
  <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.30"/>
</ResourceDictionary>
