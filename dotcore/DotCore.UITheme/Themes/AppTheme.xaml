<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared WPF theme entry: Fluent 2 tokens + default (dark) palette. Merge before AppStyles.xaml. ThemeManager swaps the palette at runtime. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/DotCore.UITheme;component/Themes/Tokens.xaml"/>
    <ResourceDictionary Source="/DotCore.UITheme;component/Themes/Colors.Dark.xaml"/>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
