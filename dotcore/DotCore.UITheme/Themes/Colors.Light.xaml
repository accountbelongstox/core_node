<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Fluent 2 light palette. Same key set as Colors.Dark.xaml; swapped at runtime by ThemeManager. Reference brushes with DynamicResource. -->
  <sys:String x:Key="ThemeVariantName">light</sys:String>
  <Color x:Key="AccentColor">#005FB8</Color>
  <Color x:Key="ShadowColor">#000000</Color>
  <!-- Surfaces (layered) -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="LayerFillBrush" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="LayerStrokeBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#F6F6F6"/>
  <SolidColorBrush x:Key="CardStrokeBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FCFCFC"/>
  <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="SmokeFillBrush" Color="#33000000"/>
  <!-- Controls -->
  <SolidColorBrush x:Key="ControlFillBrush" Color="#FBFBFB"/>
  <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#F6F6F6"/>
  <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="ControlStrokeBrush" Color="#D6D6D6"/>
  <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="ControlStrokeDisabledBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#06000000"/>
  <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="FocusStrokeInnerBrush" Color="#FFFFFF"/>
  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#5F5F5F"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#A3A3A3"/>
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextOnAccentDisabledBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextOnSemanticBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#003E92"/>
  <!-- Accent -->
  <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A6FBF"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#337FC6"/>
  <SolidColorBrush x:Key="AccentDisabledBrush" Color="#BFBFBF"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E5F1FB"/>
  <!-- Semantic -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="SuccessHoverBrush" Color="#138613"/>
  <SolidColorBrush x:Key="SuccessPressedBrush" Color="#0C6A0C"/>
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#DFF6DD"/>
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="WarningHoverBrush" Color="#AB6600"/>
  <SolidColorBrush x:Key="WarningPressedBrush" Color="#8A5100"/>
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFF4CE"/>
  <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="DangerHoverBrush" Color="#CF3626"/>
  <SolidColorBrush x:Key="DangerPressedBrush" Color="#A92619"/>
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FDE7E9"/>
  <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="InfoHoverBrush" Color="#0A6CC4"/>
  <SolidColorBrush x:Key="InfoPressedBrush" Color="#00539F"/>
  <SolidColorBrush x:Key="InfoSubtleBrush" Color="#E5F1FB"/>
  <SolidColorBrush x:Key="InfoTextBrush" Color="#005FB8"/>
  <!-- Legacy keys (d3check palette names; kept for existing pages) -->
  <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#EFEFEF"/>
  <SolidColorBrush x:Key="BackgroundLightBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BackgroundHoverBrush" Color="#EAEAEA"/>
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelHeaderBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#003E92"/>
  <SolidColorBrush x:Key="TextDarkBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="TextAccentBrush" Color="#003E92"/>
  <SolidColorBrush x:Key="TextSuccessBrush" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="TextWarningBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="TextErrorBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#1A6FBF"/>
  <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#F1BBBC"/>
  <SolidColorBrush x:Key="ButtonSuccessBrush" Color="#9FD89F"/>
  <SolidColorBrush x:Key="ButtonDangerBrush" Color="#F1BBBC"/>
  <SolidColorBrush x:Key="ButtonAccentBrush" Color="#FFD98A"/>
  <SolidColorBrush x:Key="ButtonInfoBrush" Color="#A9CEF1"/>
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InputTextBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#D6D6D6"/>
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="BorderPrimaryBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="BorderSecondaryBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D6D6D6"/>
  <SolidColorBrush x:Key="SeparatorBrush" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="TabUnselectedBackgroundBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="TabUnselectedForegroundBrush" Color="#5F5F5F"/>
  <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="AccentDefaultBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentBlueBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentCyanBrush" Color="#00727C"/>
  <SolidColorBrush x:Key="AccentRedBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="AccentOrangeBrush" Color="#BC4B09"/>
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#0F7B0F"/>
  <!-- Elevation shadows (apply to a background-only element behind content to keep ClearType text) -->
  <DropShadowEffect x:Key="FlyoutShadowEffect" Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.16"/>
  <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.12"/>
</ResourceDictionary>
