    "laravel_rescue": {
        "purpose": "Linux Laravel rescue plane: a busybox httpd (ports.laravel_rescue_httpd) whose signed CGI (client_key_auth, client shell) only writes <epoch>-<nonce>.<action>.request files into <CORE_NODE_DATA_DIR>/<requests_subpath>; the watcher unit polls every poll_seconds, deletes each file at once and runs its Laravel action.",
        "httpd_service": "ncore-rescue-httpd",
        "watcher_service": "ncore-laravel-rescue",
        "root_subpath": "data/laravel_rescue",
        "docroot_subpath": "data/laravel_rescue/www",
        "requests_subpath": "data/laravel_rescue/requests",
        "nonces_subpath": "data/laravel_rescue/nonces",
        "status_file_subpath": "data/laravel_rescue/status.log",
        "cgi_name": "laravel",
        "poll_seconds": 30,
        "actions": ["start", "restart", "sys-init", "optimize-clear"],
        "read_actions": ["status"]
    },
