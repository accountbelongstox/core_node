        "clock_skew_seconds": 300,
        "nonce_ttl_seconds": 600,
        "nonce_pattern": "^[A-Za-z0-9_-]{16,128}$",
        "machine_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
