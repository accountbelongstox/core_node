        "driver_roles": ["source", "fetcher"],
        "passive_roles": ["receiver", "exporter"],
        "writer_roles": ["receiver", "fetcher"],
        "terminal_retention": 5,
        "default_port_ref": "ports.laravel_api_backend"
    }
