{
    "hosts": {
        "loopback": "127.0.0.1",
        "any": "0.0.0.0",
        "frankenphp_internal_tls": "localhost"
    },
    "ports": {
        "laravel_api_backend": 9000,
        "frankenphp_http": 80,
        "frankenphp_https": 443,
        "frankenphp_admin": 2019,
        "nexus_dash_frontend": 13054
    },
    "planes": {
        "web_server_default": "frankenphp",
        "nginx_plane_only_ports": ["laravel_api_backend"]
    },
    "versions": {
        "frankenphp": "v1.12.7",
        "mercure": "v0.24.2"
    },
    "realtime": {
        "mercure_cookie": "mercureAuthorization",
        "mercure_transport": "local",
        "mercure_cors_origins": [
            "http://127.0.0.1:13054",
            "http://localhost:13054"
        ]
    },
    "php_runtime": {
        "upload_max_filesize": "10G",
        "post_max_size": "10G",
        "max_execution_time_seconds": 1200,
        "max_input_time_seconds": 1200,
        "request_body_timeout": "20m"
    },
    "http": {
        "ui_early_hints_link": "<https://fonts.googleapis.com>; rel=preconnect, <https://fonts.gstatic.com>; rel=preconnect; crossorigin"
    },
    "paths": {
        "core_node_data_dir_posix": "/var/_core_node",
        "core_node_data_dir_windows_subpath": "var/_core_node",
        "global_var_dir_name": "global_var",
        "frankenphp_root_posix": "/www/programing/frankenphp"
    },
    "files": {
        "ui_allowed_hosts": "UI_ALLOWED_HOSTS",
        "ui_domain_config": "ui_domain_config.json"
    }
}
