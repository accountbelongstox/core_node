        },
        "error_codes": ["client_key_missing", "client_key_unknown", "client_key_protocol_invalid", "client_key_timestamp_invalid", "client_key_nonce_invalid", "client_key_nonce_replayed", "client_key_body_digest_invalid", "client_key_signature_invalid"],
