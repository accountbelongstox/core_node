    "code_sync": {
        "purpose": "When gitsync is run with the explicit notice flag (never by default) and the push succeeds, the client asks the Laravel server (client key auth, client 'shell') to run one fixed single-flight job: gitsync --skip-notice-laravel, safe migrations, graceful FrankenPHP worker restart only when the pulled commits touch reload_paths (minus reload_excluded_paths; FrankenPHP worker reboot can crash the process, php/frankenphp#2568). The status endpoint reports the phase; wait for it before reading server logs.",
        "client": "shell",
        "start_path": "/api/system/code-sync",
        "status_path": "/api/system/code-sync/status",
        "notice_flag": "--notice-laravel",
        "notice_flag_powershell": "-NoticeLaravel",
        "skip_flag": "--skip-notice-laravel",
        "skip_flag_powershell": "-SkipNoticeLaravel",
        "request_timeout_seconds": 30,
        "poll_interval_seconds": 3,
        "poll_timeout_seconds": 600,
        "job_timeout_seconds": 900,
        "stale_after_seconds": 1200,
        "output_tail_lines": 40,
        "job_description": "code-sync",
        "history_path": "/api/system/code-sync/history",
        "schedule_minutes": 10,
        "git_fetch_timeout_seconds": 120,
        "history_default_limit": 5,
        "history_max_limit": 20,
        "history_log_commits": 10,
        "ai_fix_path": "/api/system/code-sync/ai-fix",
        "ai_fix_provider": "deepseek",
        "ai_fix_backup_ref_prefix": "refs/code-sync-backup/",
        "ai_fix_max_files": 20,
        "ai_fix_max_file_bytes": 200000,
        "ai_fix_prompt_max_chars": 4000,
        "ai_fix_timeout_seconds": 180,
        "sys_init_path": "/api/system/code-sync/sys-init",
        "sys_init_timeout_seconds": 1800,
        "reload_paths": ["poly_apps/laravel_main/"],
        "reload_excluded_paths": ["poly_apps/laravel_main/storage/"],
        "conflict_doc": "docs_fix/GITSYNC_MERGE_CONFLICT.md",
        "conflict_readme": "docs_fix/README.md",
        "conflict_readme_marker": "<!-- GITSYNC_MERGE_CONFLICT -->",
        "conflict_ai_prompt": "The core_node repository at {repo} has an unresolved git merge conflict from gitsync. {context}Resolve every conflicted file (keep both sides' intended changes), git add the files, finish the merge with git commit --no-edit, then run the project's gitsync to push.{cleanup}",
        "conflict_ai_prompt_doc": "Read {doc} first. ",
        "conflict_ai_prompt_cleanup": " Then delete {doc} and the first line of {readme} that starts with {marker}.",
        "conflict_ai_prompt_files": "Conflicted files:"
    },
    "codemart_admin_password": {
        "purpose": "CodeMart seeded-account password, generated by the deploy ensure step (175 / Step175) on every run after a [Y/n] prompt (default Y; non-interactive = Y), applied to the database at once, saved, printed, viewable any time (user D17)",
        "secret_dir_key": "laravel_db",
        "secret_file": ".core_node_secrets/CODEMART_ADMIN_PASSWORD",
        "file_mode": "0600",
        "length": 24,
        "alphabet": "base64url",
        "artisan_apply": "codemart:admin-password",
        "artisan_apply_args": [
            "--file",
            "<absolute secret file path>"
        ],
        "artisan_apply_scope": "every CodeMart account the seeder creates (admin and demo users); hashed with the app hasher; idempotent",
        "seeder_rule": "the seeder never hardcodes a password: it reads secret_file, and when the file is missing it generates one with the same length/alphabet, writes it with file_mode and prints it",
        "regenerate_prompt_default": "Y",
        "show_step": "codemart-admin-password --show"
    },
