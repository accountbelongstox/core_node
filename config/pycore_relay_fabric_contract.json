{
  "schema_version": 1,
  "protocol_version": "3.0",
  "description": "Relay Fabric V3: hub-native RPC lane. Separate from pycore_relay_contract.json so the V2 contract digest (and every connected V2 device) is unaffected.",
  "endpoints": {
    "owner_grant": "/api/relay/fabric/grant",
    "owner_frames": "/api/relay/fabric/frames",
    "owner_telemetry": "/api/relay/fabric/telemetry",
    "owner_stats": "/api/relay/fabric/stats",
    "device_heartbeat": "/api/relay/fabric/device/heartbeat"
  },
  "topics": {
    "request": "{laravel_api_origin}/.well-known/relay/v3/req/{device_id}",
    "response": "{laravel_api_origin}/.well-known/relay/v3/res/{owner_topic_token}/{device_id}"
  },
  "event_types": {
    "request": "relay.fabric.request",
    "response": "relay.fabric.response"
  },
  "envelope": {
    "version": 3,
    "request_fields": ["v", "op", "owner", "pair", "m", "p", "q", "h", "pol", "lane", "b", "iat", "dl"],
    "request_body_fields": ["len", "sha256", "b64"],
    "response_fields": ["v", "op", "s", "h", "b", "part", "t"],
    "response_body_fields": ["len", "sha256", "b64"],
    "response_part_fields": ["i", "n"],
    "response_timing_fields": ["dev_recv", "exec_ms", "dev_send"],
    "time_unit": "unix_milliseconds",
    "digest_algorithm": "sha256",
    "body_encoding": "base64"
  },
  "limits": {
    "frame_bytes": 60000,
    "inline_body_bytes": 45000,
    "max_parts": 6,
    "response_total_bytes": 196608,
    "owner_frames_per_minute": 1200,
    "telemetry_batch": 200,
    "ledger_drain_batch": 500,
    "device_max_concurrent_requests": 8,
    "device_dedupe_entries": 512
  },
  "durations": {
    "grant_ttl_seconds": 300,
    "grant_refresh_margin_seconds": 90,
    "device_heartbeat_seconds": 20,
    "device_presence_ttl_seconds": 65,
    "roster_cache_seconds": 30,
    "operation_dedupe_seconds": 120,
    "device_dedupe_seconds": 120,
    "ledger_retention_seconds": 604800,
    "stats_window_default_minutes": 15,
    "publish_timeout_seconds": 5,
    "min_deadline_seconds": 3,
    "max_deadline_seconds": 30
  },
  "lanes": {
    "route_policy_profiles": {
      "general_read": "fast",
      "general_write": "fast",
      "terminal_read": "fast",
      "terminal_resource": "fast",
      "terminal_write": "fast",
      "general_action": "durable",
      "terminal_action": "durable",
      "terminal_integration": "durable",
      "denied": "durable"
    },
    "fast_retry_policies": ["read", "idempotent_write"],
    "default": "durable"
  },
  "errors": {
    "route_denied": 403,
    "lane_durable_required": 409,
    "device_fabric_unavailable": 503,
    "fabric_unavailable": 503,
    "fabric_rate_limited": 429,
    "frame_too_large": 413,
    "pairing_not_active": 409,
    "operation_duplicate": 200
  }
}
