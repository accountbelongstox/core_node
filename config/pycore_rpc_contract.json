{
  "description": "Route table of the pycore HTTP RPC surface served below the API prefix. Keys are the typed client names: path segments (without a leading ui) in camelCase. protocol_routes are the server's own descriptor and event-socket paths.",
  "api_prefix": "/api",
  "keyset_page": {
    "description": "One keyset-cursor list shape for every pycore list route (no page/offset). Request {cursor, limit}: cursor is the opaque next_cursor of the previous page (null = first page), limit is clamped to [1, limit_max]. Response {items, next_cursor, has_more}: next_cursor is null on the last page. Order is newest first by (sort key, id).",
    "request": [
      "cursor",
      "limit"
    ],
    "response": [
      "items",
      "next_cursor",
      "has_more"
    ],
    "limit_default": 20,
    "limit_max": 200,
    "routes": [
      "queueCenterEventPage",
      "taskHistoryGetRecentLocalTasks",
      "audioOrchTasksList",
      "aiProbeUsage",
      "speechHistoryHistory",
      "translateHistory",
      "imageSearchHistory",
      "aiImageImageHistory",
      "aiHubHistory",
      "subtitleSearchHistory"
    ]
  },
