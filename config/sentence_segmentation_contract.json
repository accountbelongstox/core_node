{
  "schema_version": 1,
  "purpose": "Single specification of how running text is cut into sentences, cleaned for speech and timed. Adapters: pycore/pyfoundations/sentence_segmenter.py, poly_apps/laravel_main/app/Support/SentenceSegmenter.php, poly_apps/pycore_laravel_wordnew_ui/core/contracts/SentenceSegmenter.ts. Change a rule or a vector ONLY here; every adapter must pass every vector.",
  "terminals": ".!?\u3002\uff01\uff1f\uff0e\uff61",
  "ellipsis": "\u2026",
  "period_like": ".\uff0e\uff61\u2026",
  "native_terminals": "\u3002\uff01\uff1f\uff61",
  "closers": "\"')]}\u201d\u2019\u300d\u300f\uff09\u3011\u300b",
  "openers": "(\"'[{\u201c\u2018\u300c\u300e\uff08\u3010\u300a",
