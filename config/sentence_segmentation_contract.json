  "rules": {
    "boundary": "A terminal run (terminals and the ellipsis char) plus closers ends a sentence when whitespace, the end of the block, or a CJK character follows, or when the run holds a native CJK terminal. A dot inside a token (file.md, 127.0.0.1, 3.14, RunIntent.apiUrl) is never followed by whitespace, so it never ends a sentence.",
    "no_boundary_after_period_like": "A period-like run (a dot or an ellipsis) does not end the sentence when the next word starts in lower case, when the previous token is an abbreviation, an initial (single upper-case letter) or a dotted abbreviation (U.S, p.m, e.g), or when the sentence is only a 1-2 digit list number.",
    "blocks": "Blank lines, a line that starts a list / numbered / quote item and a heading line (which is a block of its own) are hard boundaries; other line breaks are soft (joined with a space).",
    "text_is_never_rewritten": "Sentences are slices of the input with runs of whitespace collapsed; punctuation is kept."
  },
  "block_markers": {
    "list_prefixes": [
      "-",
      "*",
      "+",
      "\u2022"
    ],
    "numbered_max_digits": 3,
    "numbered_suffixes": [
      ".",
      ")"
    ],
    "heading_marker": "#",
    "quote_marker": ">"
  },
  "long_sentence": {
    "clause_breaks": ",;:\uff0c\uff1b\uff1a\u3001"
  },
  "speakable": {
    "min_letters": 3,
    "code_symbols": "`<>{}|=@#$^*~\\/_",
    "max_code_symbol_ratio": 0.3,
    "emphasis_markers": [
      "**",
      "__",
      "~~",
      "`"
    ]
  },
  "timing": {
    "en_words_per_second": 2.5,
    "zh_chars_per_second": 4.5,
    "sentence_gap_seconds": 1.0,
    "chars_language_prefixes": [
      "zh",
      "cn",
      "ja",
      "ko"
    ]
  },
