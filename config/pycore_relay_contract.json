{
  "schema_version": 2,
  "protocol_version": "2",
  "signature_profile": {
    "algorithm": "ed25519",
    "canonical_version": "pycore-relay-v2",
    "canonicalization": {
      "method": "uppercase-ascii",
      "path": "utf8-percent-decode-then-rfc3986-reencode",
      "path_safe_characters": "/-._~",
      "path_leading_slash": "exactly-one",
      "path_query_fragment": "forbidden",
      "path_multiple_leading_slashes": "forbidden",
      "path_backslash": "forbidden",
      "path_encoded_separator": "forbidden-percent-2f-and-percent-5c",
      "path_percent_triplets": "required-valid-hex",
      "path_control_characters": "forbidden",
      "query": "sorted-string-pairs-form-urlencoded-utf8",
      "query_key_and_value_types": "string-or-repeated-string-values-only",
      "query_duplicate_values": "expand-then-sort-by-key-and-value",
      "query_empty_value": "key-equals",
      "query_space": "plus",
      "query_existing_percent": "encode-as-percent-25",
      "unicode": "utf8-no-normalization",
      "body": "exact-transmitted-bytes"
    },
    "headers": {
      "protocol": "X-Pycore-Relay-Protocol",
      "device_id": "X-Pycore-Relay-Device-ID",
      "credential_id": "X-Pycore-Relay-Credential-ID",
      "credential_version": "X-Pycore-Relay-Credential-Version",
      "timestamp": "X-Pycore-Relay-Timestamp",
      "nonce": "X-Pycore-Relay-Nonce",
      "content_sha256": "X-Pycore-Relay-Content-SHA256",
      "signature": "X-Pycore-Relay-Signature"
    }
  },
  "request_digest_profile": {
    "algorithm": "sha256",
    "serialization": "canonical-json-utf8",
    "path": "signature_profile.canonicalization.path",
    "query": "signature_profile.canonicalization.query",
    "headers": "allowed-lowercase-string-map",
    "fields": [
      "method",
      "path",
      "query",
      "headers",
      "body_present",
      "body_sha256",
      "body_length"
    ]
  },
  "response_digest_profile": {
    "algorithm": "sha256",
    "serialization": "canonical-json-utf8",
    "fields": [
      "status",
      "headers",
      "body_present",
      "body_sha256",
      "body_length"
    ]
  },
  "endpoints": {
    "enrollment_create": "/api/relay/v2/device-enrollments",
    "enrollment_status": "/api/relay/v2/device-enrollments/{enrollment_id}",
    "device_heartbeat": "/api/relay/v2/device/heartbeat",
    "device_event": "/api/relay/v2/device/events",
    "device_hub_authorization": "/api/relay/v2/device/mercure-authorization",
    "operation_claim": "/api/relay/v2/device/operations/claim",
    "operation_execution_start": "/api/relay/v2/device/operations/{operation_id}/execution-start",
    "operation_lease_renew": "/api/relay/v2/device/operations/{operation_id}/lease",
    "operation_result": "/api/relay/v2/device/operations/{operation_id}/result",
    "device_request_blob_download": "/api/relay/v2/device/blobs/{blob_id}",
    "device_response_blob_allocate": "/api/relay/v2/device/operations/{operation_id}/response-blobs",
    "device_response_blob_chunk": "/api/relay/v2/device/blobs/{blob_id}/chunks/{chunk_index}",
    "device_response_blob_finalize": "/api/relay/v2/device/blobs/{blob_id}/finalize",
    "owner_enrollment_claim": "/api/relay/v2/device-enrollments/claim",
    "owner_device_roster": "/api/relay/v2/devices",
    "owner_pairing_create": "/api/relay/v2/pairings",
    "owner_pairing_renew": "/api/relay/v2/pairings/{pairingId}/renew",
    "owner_pairing_revoke": "/api/relay/v2/pairings/{pairingId}",
    "owner_hub_authorization": "/api/relay/v2/mercure-authorization",
    "owner_operation_admit": "/api/relay/v2/operations",
    "owner_operation_status": "/api/relay/v2/operations/{operationId}",
    "owner_operation_cancel": "/api/relay/v2/operations/{operationId}/cancel",
    "owner_request_blob_allocate": "/api/relay/v2/request-blobs",
    "owner_request_blob_chunk": "/api/relay/v2/blobs/{blobId}/chunks/{chunkIndex}",
    "owner_request_blob_finalize": "/api/relay/v2/blobs/{blobId}/finalize",
    "owner_response_blob_download": "/api/relay/v2/blobs/{blobId}"
  },
  "public_urls": {
    "laravel_api_origin": "https://api.si.12gm.com",
    "mercure_hub": "https://api.si.12gm.com/.well-known/mercure"
  },
  "topics": {
    "device_wake": "{laravel_api_origin}/.well-known/relay/v2/devices/{device_id}",
    "owner_roster": "{laravel_api_origin}/.well-known/relay/v2/owners/{owner_topic_token}",
    "pairing_operation": "{laravel_api_origin}/.well-known/relay/v2/pairings/{pairing_topic_token}"
  },
  "events": {
    "operation_available": "relay.operation.available",
    "operation_status": "relay.operation.status",
    "pairing_changed": "relay.pairing.changed",
    "credential_revoked": "relay.credential.revoked",
    "terminal_changed": "terminal.changed"
  },
  "event_payload_profiles": {
    "operation_available": ["operation_id", "revision", "state"],
    "operation_status": ["operation_id", "revision", "state"],
    "pairing_changed": ["pairing_id", "revision", "state"],
    "credential_revoked": ["device_id", "credential_id", "credential_version"],
    "terminal_changed": ["pairing_id", "device_id", "revision", "metadata"]
  },
  "claim_generation_profile": {
    "fields": ["operation_revision", "claim_epoch", "lease_owner"],
    "query_bound_endpoints": ["device_request_blob_download", "device_response_blob_chunk"]
  },
  "mercure_profile": {
    "hub_runtime": "mercure.rocks-0.24.2-embedded-frankenphp",
    "transport": "server-sent-events",
    "hub_path": "/.well-known/mercure",
    "subscription_query_parameter": "topic",
    "subscription_query_cardinality": "repeated",
    "authorization": "bearer-private-subscriber-jwt",
    "initial_cursor_query_parameter": "lastEventID",
    "resume_header": "Last-Event-ID",
    "redirects": "forbidden",
    "updates": "notification-identifiers-and-revisions-only",
    "history_is_authoritative": false,
    "reconciliation_required": true
  },
  "lease_profile": {
    "timestamp_format": "rfc3339-with-required-offset",
    "execution_start_response_fields": [
      "state",
      "revision",
      "claim_epoch",
      "server_time",
      "lease_expires_at"
    ],
    "renew_response_fields": [
      "state",
      "revision",
      "claim_epoch",
      "server_time",
      "lease_expires_at"
    ],
    "local_deadline_source": "server-time-to-expiry-duration-on-monotonic-clock"
  },
  "durations": {
    "heartbeat_seconds": 20,
    "recovery_claim_seconds": 15,
    "enrollment_poll_seconds": 5,
    "request_timeout_seconds": 30,
    "claim_timeout_seconds": 15,
    "execution_timeout_seconds": 50,
    "operation_lease_seconds": 90,
    "operation_lease_renew_seconds": 20,
    "operation_lease_expiry_guard_seconds": 2,
    "operation_lease_shutdown_wait_seconds": 2,
    "signature_clock_skew_seconds": 60,
    "nonce_retention_seconds": 300,
    "enrollment_retention_seconds": 600,
    "subscriber_token_seconds": 300,
    "credential_lifetime_seconds": 2592000,
    "pairing_lease_seconds": 86400,
    "operation_retention_seconds": 86400,
    "blob_retention_seconds": 3600,
    "outbox_retention_seconds": 86400,
    "outbox_retry_max_seconds": 300,
    "terminal_screenshot_freshness_seconds": 2,
    "terminal_screenshot_capture_lease_seconds": 10,
    "terminal_viewer_demand_lease_seconds": 15,
    "terminal_screenshot_resource_retention_seconds": 120,
    "subscriber_token_refresh_margin_seconds": 60,
    "subscriber_connect_timeout_seconds": 10,
    "subscriber_read_timeout_seconds": 90,
    "subscriber_reconnect_min_seconds": 1,
    "subscriber_reconnect_max_seconds": 30
  },
  "limits": {
    "claim_batch": 8,
    "inline_body_bytes": 262144,
    "blob_chunk_bytes": 4194304,
    "request_body_bytes": 67108864,
    "response_body_bytes": 67108864,
    "header_value_bytes": 8192,
    "owner_blob_bytes": 1073741824,
    "owner_pending_operations": 100,
    "device_active_leases": 8,
    "device_event_payload_bytes": 65536,
    "outbox_publish_batch": 100,
    "outbox_publish_attempts": 10,
    "maintenance_row_batch": 100,
    "maintenance_blob_batch": 20,
    "terminal_viewer_windows": 64,
    "terminal_viewers": 128,
    "terminal_screenshot_resources": 256,
    "terminal_screenshot_capture_batch": 8,
    "terminal_screenshot_max_width": 640,
    "terminal_screenshot_max_height": 360,
    "terminal_screenshot_png_compression": 1
  },
  "rate_limits": {
    "device_requests_per_minute": 240,
    "owner_requests_per_minute": 120,
    "enrollment_claims_per_minute": 10
  },
  "headers": {
    "request_allow": [
      "accept",
      "accept-language",
      "content-type",
      "if-match",
      "if-none-match",
      "range",
      "x-request-id"
    ],
    "response_allow": [
      "accept-ranges",
      "cache-control",
      "content-disposition",
      "content-length",
      "content-range",
      "content-type",
      "etag",
      "last-modified",
      "x-request-id"
    ]
  },
  "operation_states": [
    "accepted",
    "leased",
    "executing",
    "cancel_requested",
    "responded",
    "failed",
    "execution_unknown",
    "expired",
    "canceled"
  ],
  "operation_transitions": {
    "accepted": ["leased", "cancel_requested", "expired"],
    "leased": ["leased", "executing", "cancel_requested", "failed", "expired"],
    "executing": ["leased", "responded", "failed", "execution_unknown", "cancel_requested"],
    "cancel_requested": ["canceled", "responded", "failed", "execution_unknown"],
    "responded": [],
    "failed": [],
    "execution_unknown": [],
    "expired": [],
    "canceled": []
  },
  "transition_guards": {
    "claim": "current-state-and-revision, unexpired pairing, capacity, row lock, increment claim_epoch",
    "execution_start": "leased state conditionally becomes executing with one revision increment; an identical same-generation request in executing returns the existing revision",
    "lease_renew": "executing state, exact device, lease_owner, claim_epoch, revision, and unexpired lease",
    "safe_reclaim": "expired lease and retry policy read or idempotent_write",
    "at_most_once_expiry": "executing at_most_once_action transitions to execution_unknown and is never auto-claimed",
    "result": "executing state and exact device, lease_owner, claim_epoch, and operation revision",
    "nonexecution_result": "leased or cancel_requested state and exact device, lease_owner, claim_epoch, and revision; may only fail validation, acknowledge cancellation, or acknowledge expiry"
  },
  "result_outcomes": [
    "responded",
    "failed",
    "execution_unknown",
    "canceled",
    "expired"
  ],
  "retry_policies": [
    "read",
    "idempotent_write",
    "at_most_once_action"
  ],
  "route_policy_matching": {
    "precedence": ["exact", "prefix", "suffix"],
    "tie_breaker": "longest-value-then-first-declared",
    "default_profile": "denied"
  },
  "route_policy_profiles": {
    "terminal_read": {
      "exposure": "relay",
      "permission": "relay.terminal.read",
      "payload": "json-object",
      "timeout_seconds": 15,
      "retry": "read"
    },
    "terminal_resource": {
      "exposure": "relay",
      "permission": "relay.terminal.read",
      "payload": "opaque-response-bytes",
      "timeout_seconds": 30,
      "retry": "read"
    },
    "terminal_write": {
      "exposure": "relay",
      "permission": "relay.terminal.write",
      "payload": "json-object",
      "timeout_seconds": 15,
      "retry": "idempotent_write"
    },
    "terminal_action": {
      "exposure": "relay",
      "permission": "relay.terminal.control",
      "payload": "json-object",
      "timeout_seconds": 15,
      "retry": "at_most_once_action"
    },
    "general_read": {
      "exposure": "relay",
      "permission": "relay.route.read",
      "payload": "bounded-json-or-opaque-response",
      "timeout_seconds": 30,
      "retry": "read"
    },
    "general_write": {
      "exposure": "relay",
      "permission": "relay.route.write",
      "payload": "json-object",
      "timeout_seconds": 30,
      "retry": "idempotent_write"
    },
    "general_action": {
      "exposure": "relay",
      "permission": "relay.route.control",
      "payload": "json-object",
      "timeout_seconds": 30,
      "retry": "at_most_once_action"
    },
    "denied": {
      "exposure": "denied",
      "permission": "none",
      "payload": "none",
      "timeout_seconds": 0,
      "retry": "at_most_once_action"
    }
  },
  "route_policies": [
    {
