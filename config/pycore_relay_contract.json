{
  "schema_version": 1,
  "protocol_version": "1",
  "description": "The single pycore relay contract: hub-native frames between UI owners and pycore devices; Laravel is the control plane.",
  "signature_profile": {
    "algorithm": "ed25519",
    "canonical_version": "pycore-relay",
    "canonicalization": {
      "method": "uppercase-ascii",
      "path": "utf8-percent-decode-then-rfc3986-reencode",
      "path_safe_characters": "/-._~",
      "path_leading_slash": "exactly-one",
      "path_query_fragment": "forbidden",
      "path_multiple_leading_slashes": "forbidden",
      "path_backslash": "forbidden",
      "path_encoded_separator": "forbidden-percent-2f-and-percent-5c",
      "path_percent_triplets": "required-valid-hex",
      "path_control_characters": "forbidden",
      "query": "sorted-string-pairs-form-urlencoded-utf8",
      "query_key_and_value_types": "string-or-repeated-string-values-only",
      "query_duplicate_values": "expand-then-sort-by-key-and-value",
      "query_empty_value": "key-equals",
      "query_space": "plus",
      "query_existing_percent": "encode-as-percent-25",
      "unicode": "utf8-no-normalization",
      "body": "exact-transmitted-bytes"
    },
    "headers": {
      "protocol": "X-Pycore-Relay-Protocol",
      "device_id": "X-Pycore-Relay-Device-ID",
      "credential_id": "X-Pycore-Relay-Credential-ID",
      "credential_version": "X-Pycore-Relay-Credential-Version",
      "timestamp": "X-Pycore-Relay-Timestamp",
      "nonce": "X-Pycore-Relay-Nonce",
      "content_sha256": "X-Pycore-Relay-Content-SHA256",
      "signature": "X-Pycore-Relay-Signature"
    }
  },
  "request_digest_profile": {
    "algorithm": "sha256",
    "serialization": "canonical-json-utf8",
    "path": "signature_profile.canonicalization.path",
    "query": "signature_profile.canonicalization.query",
    "headers": "allowed-lowercase-string-map",
    "fields": [ "method", "path", "query", "headers", "body_present", "body_sha256", "body_length" ]
  },
  "response_digest_profile": {
    "algorithm": "sha256",
    "serialization": "canonical-json-utf8",
    "fields": [ "status", "headers", "body_present", "body_sha256", "body_length" ]
  },
  "endpoints": {
    "enrollment_create": "/api/relay/device-enrollments",
    "enrollment_status": "/api/relay/device-enrollments/{enrollment_id}",
    "device_heartbeat": "/api/relay/device/heartbeat",
    "device_event": "/api/relay/device/events",
    "device_request_blob_download": "/api/relay/device/blobs/{blob_id}",
    "device_response_blob_allocate": "/api/relay/device/response-blobs",
    "device_response_blob_chunk": "/api/relay/device/blobs/{blob_id}/chunks/{chunk_index}",
    "device_response_blob_finalize": "/api/relay/device/blobs/{blob_id}/finalize",
    "owner_enrollment_claim": "/api/relay/device-enrollments/claim",
    "owner_device_roster": "/api/relay/devices",
    "owner_pairing_create": "/api/relay/pairings",
    "owner_pairing_renew": "/api/relay/pairings/{pairingId}/renew",
    "owner_pairing_revoke": "/api/relay/pairings/{pairingId}",
    "owner_grant": "/api/relay/grant",
    "owner_frames": "/api/relay/frames",
    "owner_telemetry": "/api/relay/telemetry",
    "owner_stats": "/api/relay/stats",
    "owner_request_blob_allocate": "/api/relay/request-blobs",
    "owner_request_blob_chunk": "/api/relay/blobs/{blobId}/chunks/{chunkIndex}",
    "owner_request_blob_finalize": "/api/relay/blobs/{blobId}/finalize",
    "owner_response_blob_download": "/api/relay/blobs/{blobId}"
  },
  "public_urls": {
    "laravel_api_origin": "https://api.si.12gm.com",
    "mercure_hub": "https://api.si.12gm.com/.well-known/mercure"
  },
  "topics": {
    "request": "{laravel_api_origin}/.well-known/relay/req/{device_id}",
    "response": "{laravel_api_origin}/.well-known/relay/res/{owner_topic_token}/{device_id}",
    "owner_events": "{laravel_api_origin}/.well-known/relay/owners/{owner_topic_token}"
  },
  "events": {
    "request_frame": "relay.request",
    "response_frame": "relay.response",
    "pairing_changed": "relay.pairing.changed",
    "credential_revoked": "relay.credential.revoked",
    "device_presence": "relay.device.presence",
    "terminal_changed": "terminal.changed",
    "agent_history_prompt_new": "agent_history.prompt.new",
    "agent_history_prompt_derived": "agent_history.prompt.derived",
    "agent_history_config_changed": "agent_history.config.changed",
    "pycore_events": "pycore.events"
  },
  "event_payload_profiles": {
    "pairing_changed": [ "pairing_id", "revision", "state" ],
    "credential_revoked": [ "device_id", "credential_id", "credential_version" ],
    "device_presence": [ "device_id", "online", "device", "recommended_device_id", "selection_reason" ],
    "terminal_changed": [ "pairing_id", "device_id", "revision", "metadata" ],
    "agent_history_prompt_new": [ "pairing_id", "device_id", "revision", "metadata" ],
    "agent_history_prompt_derived": [ "pairing_id", "device_id", "revision", "metadata" ],
    "agent_history_config_changed": [ "pairing_id", "device_id", "revision", "metadata" ],
    "pycore_events": [ "pairing_id", "device_id", "revision", "metadata" ]
  },
  "host_capabilities": [ "desktop_session" ],
  "client_events": {
    "relay_events_dropped": {
      "type": "relay.events.dropped",
      "fields": [ "dropped", "since" ]
    }
  },
  "device_events": [
    "terminal_changed",
    "agent_history_prompt_new",
    "agent_history_prompt_derived",
    "agent_history_config_changed",
    "pycore_events"
  ],
  "hub_profile": {
    "hub_runtime": "mercure.rocks-0.24.2-embedded-frankenphp",
    "transport": "server-sent-events",
    "hub_path": "/.well-known/mercure",
    "subscription_query_parameter": "topic",
    "subscription_query_cardinality": "repeated",
    "authorization": "bearer-private-subscriber-jwt",
    "initial_cursor_query_parameter": "lastEventID",
    "resume_header": "Last-Event-ID",
    "redirects": "forbidden",
    "updates": "notification-identifiers-and-revisions-only",
    "history_is_authoritative": false,
    "reconciliation_required": true,
    "protocol": "mercure",
    "token_ttl_seconds": 600
  },
  "frame_profile": {
    "version": 1,
    "request_fields": [ "v", "op", "owner", "pair", "se", "m", "p", "q", "h", "pol", "b", "iat", "dl" ],
    "request_body_fields": [ "len", "sha256", "b64", "ref" ],
    "response_fields": [ "v", "op", "k", "s", "h", "b", "part", "t", "p" ],
    "response_body_fields": [ "len", "sha256", "b64", "ref" ],
    "response_part_fields": [ "i", "n" ],
    "response_timing_fields": [ "dev_recv", "exec_ms", "dev_send" ],
    "response_progress_fields": [ "phase", "done", "total", "bytes" ],
    "response_kinds": [ "ack", "progress", "result" ],
    "time_unit": "unix_milliseconds",
    "digest_algorithm": "sha256",
    "body_encoding": "base64"
  },
  "durations": {
    "heartbeat_seconds": 20,
    "presence_timeout_seconds": 65,
    "roster_reconciliation_seconds": 60,
    "enrollment_poll_seconds": 5,
    "request_timeout_seconds": 30,
    "execution_timeout_seconds": 50,
    "ack_timeout_seconds": 5,
    "stall_window_seconds": 30,
    "progress_min_interval_seconds": 2,
    "min_deadline_seconds": 3,
    "max_deadline_seconds": 180,
    "grant_ttl_seconds": 300,
    "grant_refresh_margin_seconds": 90,
    "roster_cache_seconds": 30,
    "operation_dedupe_seconds": 120,
    "device_dedupe_seconds": 120,
    "publish_timeout_seconds": 5,
    "signature_clock_skew_seconds": 60,
    "nonce_retention_seconds": 300,
    "enrollment_retention_seconds": 600,
    "credential_lifetime_seconds": 2592000,
    "pairing_lease_seconds": 86400,
    "blob_retention_seconds": 3600,
    "outbox_retention_seconds": 86400,
    "outbox_retry_max_seconds": 300,
    "ledger_retention_seconds": 604800,
    "session_retention_seconds": 604800,
    "stats_window_default_minutes": 15,
    "terminal_screenshot_freshness_seconds": 2,
    "terminal_screenshot_capture_lease_seconds": 10,
    "terminal_viewer_demand_lease_seconds": 15,
    "terminal_screenshot_resource_retention_seconds": 120,
    "subscriber_connect_timeout_seconds": 10,
    "subscriber_read_timeout_seconds": 90,
    "subscriber_reconnect_min_seconds": 1,
    "subscriber_reconnect_max_seconds": 30
  },
  "limits": {
    "frame_bytes": 60000,
    "inline_body_bytes": 45000,
    "max_parts": 6,
    "response_inline_bytes": 196608,
    "request_body_bytes": 67108864,
    "response_body_bytes": 67108864,
    "blob_chunk_bytes": 4194304,
    "owner_blob_bytes": 1073741824,
    "header_value_bytes": 8192,
    "device_event_payload_bytes": 65536,
    "device_max_concurrent_requests": 8,
    "device_dedupe_entries": 512,
    "telemetry_batch": 200,
    "ledger_drain_batch": 500,
    "outbox_publish_batch": 100,
    "outbox_publish_attempts": 10,
    "maintenance_row_batch": 100,
    "maintenance_blob_batch": 20,
    "terminal_viewer_windows": 64,
    "terminal_viewers": 128,
    "terminal_screenshot_resources": 256,
    "terminal_screenshot_capture_batch": 8,
    "terminal_screenshot_max_width": 640,
    "terminal_screenshot_max_height": 360,
    "terminal_screenshot_png_compression": 1,
    "terminal_image_upload_bytes": 20971520,
    "terminal_image_retain_count": 200,
    "terminal_image_retain_seconds": 604800,
    "terminal_capture_retain_count": 100,
    "terminal_capture_retain_seconds": 2592000,
    "terminal_backup_interval_seconds": 60,
    "terminal_backup_prompt_interval_seconds": 10,
    "terminal_backup_prompt_miss_limit": 10,
    "terminal_backup_retain_count": 200,
    "terminal_backup_retain_seconds": 259200,
    "terminal_backup_low_battery_percent": 10,
    "terminal_backup_min_idle_seconds": 30,
    "terminal_backup_defer_retry_seconds": 3,
    "terminal_backup_settle_seconds": 10,
    "machine_send_file_bytes": 2147483648,
    "machine_send_files_per_request": 32,
    "machine_send_text_bytes": 10485760
  },
  "rate_limits": {
    "device_requests_per_minute": 240,
    "owner_requests_per_minute": 120,
    "enrollment_claims_per_minute": 10,
    "owner_frames_per_minute": 1200
  },
  "headers": {
    "request_allow": [ "accept", "accept-language", "content-type", "if-match", "if-none-match", "range", "x-request-id" ],
    "response_allow": [
      "accept-ranges",
      "cache-control",
      "content-disposition",
      "content-length",
      "content-range",
      "content-type",
      "etag",
      "last-modified",
      "x-request-id"
    ]
  },
  "delivery_guarantees": {
    "read": "Re-executed on a duplicate operation id or answered from the device cache.",
    "idempotent_write": "Safe to re-execute; a duplicate operation id replays the cached result when present.",
    "at_most_once_action": "Executed at most once per operation id; duplicates replay the ledger result and an interrupted execution answers execution_unknown."
  },
  "route_policy_matching": {
    "precedence": [ "exact", "prefix", "suffix" ],
    "tie_breaker": "longest-value-then-first-declared",
    "default_profile": "general_action"
  },
  "route_policy_profiles": {
    "terminal_read": {
      "exposure": "relay",
      "permission": "relay.terminal.read",
      "payload": "json-object",
      "timeout_seconds": 15,
      "delivery": "read"
    },
    "terminal_resource": {
      "exposure": "relay",
      "permission": "relay.terminal.read",
      "payload": "opaque-response-bytes",
      "timeout_seconds": 30,
      "delivery": "read"
    },
    "terminal_backup_read": {
      "exposure": "relay",
      "permission": "relay.terminal.read",
      "payload": "json-object",
      "timeout_seconds": 30,
      "delivery": "read"
    },
    "terminal_write": {
      "exposure": "relay",
      "permission": "relay.terminal.write",
      "payload": "json-object",
      "timeout_seconds": 15,
      "delivery": "idempotent_write"
    },
    "terminal_action": {
      "exposure": "relay",
      "permission": "relay.terminal.control",
      "payload": "json-object",
      "timeout_seconds": 15,
      "delivery": "at_most_once_action"
    },
    "terminal_integration": {
      "exposure": "relay",
      "permission": "relay.terminal.control",
      "payload": "json-object",
      "timeout_seconds": 150,
      "delivery": "at_most_once_action",
      "ack": true
    },
    "terminal_upload": {
      "exposure": "relay",
      "permission": "relay.terminal.write",
      "payload": "multipart-form",
      "timeout_seconds": 60,
      "delivery": "at_most_once_action"
    },
    "machine_upload": {
      "exposure": "relay",
      "permission": "relay.route.control",
      "payload": "multipart-form",
      "timeout_seconds": 180,
      "delivery": "at_most_once_action",
      "ack": true
    },
    "machine_clipboard": {
      "exposure": "relay",
      "permission": "relay.route.control",
      "payload": "json-or-multipart-form",
      "timeout_seconds": 180,
      "delivery": "at_most_once_action"
    },
    "general_read": {
      "exposure": "relay",
      "permission": "relay.route.read",
      "payload": "bounded-json-or-opaque-response",
      "timeout_seconds": 30,
      "delivery": "read"
    },
    "general_write": {
      "exposure": "relay",
      "permission": "relay.route.write",
      "payload": "json-object",
      "timeout_seconds": 30,
      "delivery": "idempotent_write"
    },
    "general_action": {
      "exposure": "relay",
      "permission": "relay.route.control",
      "payload": "json-object",
      "timeout_seconds": 30,
      "delivery": "at_most_once_action"
    },
    "denied": {
      "exposure": "denied",
      "permission": "none",
      "payload": "none",
      "timeout_seconds": 0,
      "delivery": "at_most_once_action"
    }
  },
