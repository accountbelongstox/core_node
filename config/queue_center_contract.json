      "exact_aliases": {
        "word_translation": "translation",
        "prompt_translation": "translation",
        "google_translate": "translation",
        "word-translation": "translation",
        "ai_translate": "translation",
        "gemini_image": "media_image",
        "poster": "media_image"
      },
      "token_rules": [
        {"bucket": "word_audio", "all": ["word"], "any": ["tts", "audio"]},
        {"bucket": "sentence_audio", "all": ["sentence"], "any": ["tts", "audio", "prompt"]},
        {"bucket": "article_audio", "all": ["article"], "any": ["tts", "audio"]},
        {"bucket": "translation", "all": [], "any": ["translate", "translation"]},
        {"bucket": "assist", "all": [], "any": ["assist"]},
        {"bucket": "media_image", "all": [], "any": ["media", "image", "cover", "poster", "screenshot", "book"]}
      ],
