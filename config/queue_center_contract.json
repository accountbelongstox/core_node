{
  "schema_version": 30,
  "contract": "queue_center",
  "source_path": "config/queue_center_contract.json",
  "word_validity": {
    "batch_size": 20,
    "request_timeout_ms": 120000,
    "default_languages": ["en"],
    "source_marker": "ai_ensure",
    "idle_poll_seconds": 60
  },
  "http_transfer": {
    "protocol": "offset-v1",
    "chunk_bytes": 262144,
    "maximum_chunk_bytes": 1048576,
    "connect_timeout_seconds": 15,
    "idle_timeout_seconds": 30,
    "retry_interval_ms": 250
  },
  "realtime": {
    "transport": "mercure",
    "topic": "queue-center",
    "event": "queue.changed",
    "events": {
      "task_priority": "task.priority",
      "queue_changed": "queue.changed",
      "word_audio_head": "word_audio.head",
      "sentence_audio_head": "sentence_audio.head",
      "word_image_priority": "word_image.priority",
      "cover_priority": "cover.priority",
      "poster_priority": "poster.priority",
      "worker_presence": "worker.presence"
    }
  },
  "diff_delivery": {
    "version": 1,
    "cursor_store": "Persistent revision and high-water metadata only.",
    "id_page_store": "Bounded ID pages; queue-head moves update this layer without loading rows.",
    "data_segment_store": "Full records are materialized only on a UI or consumer request and compacted after consumption.",
    "id_page_limit": 64,
    "id_limit": 4096,
    "data_segment_limit": 128,
    "poll_interval_ms": 1000,
    "consumer_slice_default": 8,
    "head_reserve": 1,
    "head_notification_interval_seconds": 2,
    "producer_batch_limits": {
      "word_audio": 100
    },
    "consumer_batch_limits": {
      "word_audio": 100,
      "sentence_audio": 100
    },
    "consumer_task_timeout_seconds": {
      "word_audio": 300,
      "sentence_audio": 900
    },
    "consumer_upload_retry": {
      "initial_seconds": 2,
      "maximum_seconds": 30
    },
    "consumer_log_tags": {
      "sentence_audio": ["[SentenceAudioWorker]", "[SentenceAudioAuto]", "[qwen3tts]", "[managed]"]
    },
    "ready_ttl_seconds": 300,
    "consumed_ttl_seconds": 86400
  },
  "endpoints": {
    "queue_center_overview": "/api/queue-center/overview",
    "queue_center_events": "/api/queue-center/events",
    "queue_center_receipts": "/api/queue-center/receipts",
    "queue_center_queue_items": "/api/queue-center/queues/{queue}/items",
    "queue_center_queue_diff": "/api/queue-center/queues/{queue}/diff",
    "queue_center_queue_id_pages": "/api/queue-center/queues/{queue}/id-pages",
    "queue_center_queue_page_data": "/api/queue-center/queues/{queue}/page-data",
    "queue_center_queue_head": "/api/queue-center/queues/{queue}/head",
    "queue_center_task_cancel": "/api/queue-center/tasks/{task_id}/cancel",
    "queue_center_task_retry": "/api/queue-center/tasks/{task_id}/retry",
    "worker_register": "/api/worker/register",
    "worker_heartbeat": "/api/worker/heartbeat",
    "worker_unregister": "/api/worker/unregister",
    "worker_list": "/api/worker/list",
    "worker_stats": "/api/worker/stats",
    "worker_task_pull": "/api/worker/tasks/{task_type}/pull",
    "worker_task_accept": "/api/worker/tasks/{task_type}/accept",
    "worker_task_result": "/api/worker/tasks/{task_type}/result",
    "worker_task_release": "/api/worker/tasks/{task_type}/release",
    "relay_machines": "/api/relay/machines",
    "relay_machine_register": "/api/relay/machine/register",
    "relay_machine_heartbeat": "/api/relay/machine/heartbeat",
    "relay_machine_unregister": "/api/relay/machine/unregister",
    "relay_hub_auth": "/api/relay/hub-auth",
    "relay_pair_announce": "/api/relay/{machine_id}/pair",
    "relay_request": "/api/relay/{machine_id}/requests",
    "relay_request_fetch": "/api/relay/{machine_id}/requests/{request_id}",
    "relay_response": "/api/relay/{machine_id}/responses",
    "relay_response_fetch": "/api/relay/{machine_id}/responses/{request_id}",
    "relay_blob_create": "/api/relay/{machine_id}/blobs",
    "relay_blob_fetch": "/api/relay/{machine_id}/blobs/{blob_id}"
  },
  "relay": {
    "hub": {
      "protocol": "mercure",
      "path": "/.well-known/mercure",
      "token_ttl_seconds": 600
    },
    "device_identity": {
      "clock_skew_seconds": 300,
      "nonce_ttl_seconds": 600
    },
    "topics": {
      "machines": "pycore.machines",
      "pair": "pycore.pair.{machine_id}"
    },
    "events": {
      "request": "relay.request",
      "response": "relay.response",
      "roster": "roster.update"
    },
    "machine_heartbeat_seconds": 20,
    "machine_offline_after_seconds": 45,
    "pair_session_ttl_seconds": 60,
    "request_ttl_seconds": 60,
    "response_poll_interval_ms": 400,
    "caps": {
      "control_frame_bytes": 8192,
      "inline_body_bytes": 262144,
      "blob_chunk_bytes": 4194304,
      "request_total_bytes": 33554432
    },
    "capability_providers": {
      "pycore": {
        "class": "machine",
        "implemented": true,
        "provides": ["http-rpc-relay", "queue-worker"]
      },
      "laravel-manager": {
        "class": "ui-end",
        "implemented": false,
        "provides": []
      },
      "wordnew": {
        "class": "ui-end",
        "implemented": false,
        "provides": []
      },
      "mcp-chrome": {
        "class": "machine",
        "implemented": false,
        "provides": []
      }
    }
  },
  "delivery_receipt": {
    "stages": {
      "waiting": "waiting",
      "laravel_received": "laravel_received",
      "worker_received": "worker_received",
      "processing": "processing",
      "completed": "completed",
      "failed": "failed"
    },
    "worker_kinds": ["pycore", "chrome", "laravel"],
    "task_id_limit_source": "diff_delivery.data_segment_limit"
  },
  "metric_semantics": {
    "pending": "Ready work that has not been claimed.",
    "leased": "Claimed or assigned work that has not started processing.",
    "processing": "Work actively being processed.",
    "total": "All records represented by the section; live queue sections sum pending, leased, and processing only."
  },
  "control_names": [
    "assist_translation",
    "word_audio",
    "sentence_audio"
  ],
  "callback_queue_roles": {
    "translation_worker": "consumer",
    "translation_queue_monitor": "monitor",
    "translation_realtime_client": "signal",
    "tts_queue_poller": "consumer",
    "tts_sentence_worker": "consumer",
    "ai_rate_reset": "maintainer",
    "agent_history_extraction": "maintainer",
    "agent_history_pipeline": "maintainer"
  },
  "section_contract_defaults": {
    "queue": {"pending": 0, "leased": 0, "processing": 0, "total": 0},
    "worker": {"online": false, "claimed": 0, "ok": null, "fail": null, "last_heartbeat": null},
    "toggle": {"requested_by": null, "enabled": false, "reason": null, "graceful_stop": false, "paused_by_user": null},
    "lifecycle": "off",
    "error_code": null,
    "last_error": null,
    "age_s": null,
    "stale": false
  },
  "capability_claimants": {
    "translate": ["chrome"],
    "ai_translate": ["chrome"],
    "puter_translate": ["chrome"],
    "audio": ["pycore"],
    "image": ["chrome"],
    "sentence_audio": ["pycore"],
    "subtitle": ["pycore"],
    "poster": ["chrome"],
    "stt": ["pycore"]
  },
  "section_scopes": {
    "assist_translation": {
      "category": "assist_translation",
      "category_keys": [
        "word_translation",
        "ai_translate",
        "subtitle_search",
        "subtitle_lang",
        "book_lang"
      ],
      "queue_metrics": true
    },
    "word_audio": {
      "category": "word_audio",
      "category_keys": ["word_audio"],
      "queue_metrics": true
    },
    "sentence_audio": {
      "category": "sentence_audio",
      "category_keys": ["sentence_audio"],
      "queue_metrics": true
    },
    "media_image": {
      "category": "media_image",
      "category_keys": ["cover", "poster", "gemini_image"],
      "queue_metrics": true
    }
  },
  "task_contract": {
    "statuses": {
      "values": {
        "pending": "pending",
        "assigned": "assigned",
        "processing": "processing",
        "completed": "completed",
        "completed_demo": "completed_demo",
        "failed": "failed",
        "cancelled": "cancelled"
      },
      "all": ["pending", "assigned", "processing", "completed", "completed_demo", "failed", "cancelled"],
      "live": ["pending", "assigned", "processing"],
      "terminal": ["completed", "completed_demo", "failed", "cancelled"],
      "worker_reportable": ["processing", "completed", "failed"]
    },
    "events": {
      "values": {
        "assigned": "assigned",
        "processing": "processing",
        "completed": "completed",
        "failed": "failed",
        "timeout": "timeout",
        "reclaimed": "reclaimed",
        "cancelled": "cancelled"
      },
      "terminal": ["completed", "failed", "cancelled"]
    },
    "stream_events": {
      "initial": "task.detail-initial",
      "transition": "task.event",
      "ping": "ping",
      "close": "stream.close"
    },
    "execution_types": {
      "local_timer": "local_timer",
      "remote_client": "remote_client",
      "remote_compute": "remote_compute",
      "remote_ocr": "remote_ocr",
      "remote_translation": "remote_translation",
      "remote_video": "remote_video",
      "remote_io": "remote_io",
      "remote_audio": "remote_audio",
      "remote_notebooklm": "remote_notebooklm",
      "remote_gemini": "remote_gemini",
      "remote_gemini_text": "remote_gemini_text",
      "remote_validity": "remote_validity",
      "remote_fast": "remote_fast",
      "remote_subtitle": "remote_subtitle",
      "remote_poster": "remote_poster",
      "remote_sentence_audio": "remote_sentence_audio",
      "remote_stt": "remote_stt",
      "remote_chatgpt": "remote_chatgpt"
    },
    "priorities": {
      "default": 0,
      "manual": 50,
      "fast": 100,
      "maximum": 1000
    },
    "progress_stages": {
      "accepted": 1,
      "synthesizing": 10,
      "uploading": 80,
      "finalizing": 95,
      "completed": 100
    },
    "limits": {
      "list_default": 20,
      "list": 200,
      "monitor": 100,
      "worker_pull_default": 5,
      "worker_pull": 100,
      "completed": 500,
      "long_poll_seconds": 30,
      "history_records": 200,
      "history_timeline": 50,
      "event_batch": 200
    },
    "capability_labels": {
      "audio": "Audio",
      "image": "Image",
      "translate": "Translate (Chrome)",
      "sentence_audio": "Sentence Audio",
      "ai_translate": "AI Translate (Chrome)",
      "puter_translate": "Puter Translate",
      "subtitle": "Subtitle",
      "poster": "Poster",
      "stt": "Speech to Text"
    },
    "capability_single_lanes": {
      "translate": "remote_translation",
      "audio": "remote_audio",
      "image": "remote_gemini",
      "subtitle": "remote_subtitle",
      "poster": "remote_poster",
      "sentence_audio": "remote_sentence_audio",
      "stt": "remote_stt"
    },
    "fast_lane_capabilities": [
      "translate", "ai_translate", "puter_translate", "image"
    ],
    "chrome_capability_switches": {
      "image": {
        "storage_key": "tkCapImage",
        "label": "Cover and poster search",
        "hint": "Search and write back book covers and media posters through the shared browser worker",
        "processors": ["media_image"]
      },
      "gemini_image": {
        "storage_key": "tkCapGeminiImage",
        "label": "AI word-group cover generation",
        "hint": "Generate vocabulary-library covers with Gemini and write them back to Laravel",
        "processors": ["remote_gemini"]
      },
      "validity": {
        "storage_key": "tkCapValidity",
        "label": "Word validity and translation",
        "hint": "Pull unchecked or untranslated words from the backend vocabulary library and process them with DeepSeek",
        "processors": ["bing_dictionary", "word_validity_web"]
      },
      "notebooklm": {
        "storage_key": "tkCapNotebooklm",
        "label": "执行 NotebookLM 生成任务",
        "hint": "Laravel NotebookLM queue to shared browser runtime with result write-back",
        "processors": ["remote_notebooklm"]
      },
      "chatgpt": {
        "storage_key": "tkCapChatgpt",
        "label": "执行 ChatGPT 长语音任务",
        "hint": "ChatGPT web conversations with read-aloud audio capture and Laravel write-back",
        "processors": ["chatgpt_web"]
      }
    },
    "wire_shapes": {
      "create_result": ["task_id", "execution_type", "queue_position", "priority", "is_fast_tier"],
      "summary": [
        "task_id", "app_name", "task_type", "execution_type", "status", "progress",
        "assigned_to", "created_at", "capability", "queue_position", "priority", "is_fast_tier"
      ],
      "worker_pull": [
        "task_id", "app_name", "task_type", "execution_type", "status", "payload",
        "timeout_seconds", "retry_count", "queue_position", "priority", "capability", "is_fast_tier", "created_at"
      ],
      "status": [
        "task_id", "app_name", "task_type", "execution_type", "capability", "is_fast_tier",
        "status", "queue_position", "priority", "progress", "retry_count", "max_retries", "timeout_seconds",
        "payload", "result", "error", "assigned_to", "assigned_at", "timeout_at",
        "completed_at", "created_at", "updated_at"
      ],
      "detail": [
        "task_id", "app_name", "task_type", "execution_type", "capability", "is_fast_tier",
        "status", "queue_position", "priority", "progress", "payload", "result", "error", "assigned_to",
        "assigned_at", "timeout_at", "completed_at", "created_at", "updated_at"
      ],
      "event": ["id", "task_id", "event", "worker_id", "attempt", "detail", "created_at"],
      "detail_bundle": ["task", "events", "current_phase", "metadata"],
      "current_phase": ["phase", "worker_id", "elapsed_seconds"],
      "detail_metadata": [
        "total_attempts", "max_retries", "will_retry", "estimated_timeout_in_seconds"
      ],
      "stats": [
        "total", "pending", "assigned", "processing", "completed", "completed_demo", "failed", "cancelled"
      ],
      "worker_registration": [
        "worker_id", "worker_name", "processor_types", "capabilities", "hostname", "platform", "metadata", "lease_capacity"
      ],
      "worker_result": ["task_id", "worker_id", "attempt", "status", "progress", "result", "error"]
    },
