{
 "schema_version": 39,
 "contract": "queue_center",
 "source_path": "config/queue_center_contract.json",
 "word_validity": {
  "batch_size": 20,
  "view_page_size": 1000,
  "request_timeout_ms": 120000,
  "default_languages": [
   "en"
  ],
  "source_marker": "ai_ensure",
  "idle_poll_seconds": 60
 },
 "word_audio_batch": {
  "engine": "kokoro",
  "profile": "word_batch",
  "device": "cpu",
  "default_batch_size": 20
 },
 "word_identity": {
  "rule": "md5-of-exact-stored-dictionary-content",
  "producer": "laravel",
  "consumers_recompute": false,
  "fields": {
   "word_audio_lane": "payload.md5",
   "dict_lanes_batched": "payload.words[].md5",
   "word_audio_upload": "body.md5",
   "delivery_word_key": "<lang>:<md5>[:<variant>]"
  },
  "fallback_when_md5_absent": {
   "key_format": "<lang>:text:<cleaned_word>",
   "resolver": "laravel",
   "rule": "Laravel resolves the dictionary row by lang + cleaned_word; a word not in the dictionary is rejected with rejection_code (inside a delivery batch: item status delivery.batch_item_statuses.no_target) and no row is created",
   "rejection_code": "WORD_NOT_FOUND",
   "applies_to": [
    "word_audio_upload",
    "delivery_word_key",
    "dict_lanes_batched"
   ]
  }
 },
 "http_transfer": {
  "protocol": "offset-v1",
  "chunk_bytes": 262144,
  "maximum_chunk_bytes": 1048576,
  "connect_timeout_seconds": 15,
  "idle_timeout_seconds": 30,
  "retry_interval_ms": 250,
  "dedup_window_seconds": 300,
  "keepalive_idle_seconds": 15,
  "keepalive_interval_seconds": 5,
  "keepalive_probe_count": 3
 },
 "realtime": {
  "transport": "mercure",
  "topic": "queue-center",
  "event": "queue.changed",
  "events": {
   "task_priority": "task.priority",
   "queue_changed": "queue.changed",
   "word_audio_head": "word_audio.head",
   "sentence_audio_head": "sentence_audio.head",
   "word_image_priority": "word_image.priority",
   "cover_priority": "cover.priority",
   "poster_priority": "poster.priority",
   "worker_presence": "worker.presence"
  },
  "head_keys": {
   "task_priority": "task_id",
   "cover_priority": "items[].resource_key",
   "poster_priority": "items[].resource_key"
  },
  "resource_key_formats": {
   "cover_priority": "library:<library_id>",
   "poster_priority": "<media_type>:<media_id>"
  }
 },
 "head_parts": {
  "description": "Each audio lane (word_audio, sentence_audio) owns its OWN Queue = Part1 + Part2 (one whole-Queue heap per lane; the lanes never mix). Every mutation and dedup is whole-Queue. The split may be VISUALIZED read-only; actors never address a part. Binding docs: docs_fix/REQUIREMENTS_20260926_AUDIO_ORCH_QUEUE_STATE_DRIVEN.md (current), docs_fix/REQUIREMENTS_20260922_AUDIO_QUEUE_HEAD_PART1_PART2.md (origin).",
  "parts": {
   "part1": "pycore-local priority. Filled ONLY by audio orchestration manifest misses (missing words -> word_audio Part1, missing sentences -> sentence_audio Part1; local tasks owned by the orchestration task) and the pycore-manager manual promote. NEVER notifies Laravel. Empty by default.",
   "part2": "The Laravel backlog: Laravel initial sync, diff updates and realtime {queue}_head tickets (produced ONLY by wordnew), plus pycore's full-pull mirror of the dictionary backlog (accept_backlog)."
  },
  "ordering": "Every Part1 item sits in front of every Part2 item (part_rank 0 < 1), ahead of queue_position; language tier then queue_position then FIFO within a part.",
  "operation": "ANY head promotion operates on the WHOLE Queue; dedup always runs against the whole Queue (an item exists at most once across parts; a Part1 copy keeps its front position).",
  "generation": "One generator per item: an owner take_local()s its Part1 items before generating and settle_local()s the outcome; items a lane worker popped settle through complete(ok, provider).",
  "direction": "Laravel -> pycore only. pycore never sends head state to Laravel."
 },
 "word_audio_full_sync": {
  "description": "pycore word-audio full pull: while Word Audio is ON pycore mirrors EVERY dictionary word without audio (the Laravel word_audio dict-lane live view) into the local word_audio Queue as a Part2 backlog mirror (accept_backlog, whole-Queue dedup) and keeps generating while Laravel is offline; uploads resume through the shared Laravel delivery outbox (pycore/pyutils/laravel/delivery_outbox.py). Binding docs: docs_fix/REQUIREMENTS_20260922_WORD_AUDIO_OFFLINE_QUEUE.md, corrected by docs_fix/REQUIREMENTS_20260926_AUDIO_ORCH_QUEUE_STATE_DRIVEN.md.",
  "listing_endpoint": "GET /api/app_qy_v1/dictionary/words?language=<lang>&filter=without_audio&cursor_id=<id>&limit=1000 (stable keyset paging)",
  "language_source": "GET /api/app_qy_v1/vocabulary/language-breakdown, fallback: contract word_audio language priority, final fallback: english",
  "local_task_marker": "_local_source=full_sync (task_id full_sync-word-<lang>-<md5>); locally sourced tasks skip the just-in-time Laravel claim and the global result post; delivery is the domain report (encodeTaskId: dict_row_id*1000 + 1*100 + langIndex) plus the durable outbox",
  "cache_file": "get_app_cache_dir()/audio_queue/<lane>_queue.json per lane (whole-Queue snapshot + Part1 key set; restored once per process when the lane switch is ON, before any remote pull; writes debounced)",
  "rpc": "ui/queue_center/word_audio_full_sync (on-demand full pull, background, returns the status block)",
  "persisted_key": "assist_settings capabilities.tts (the pycore-manager Queue Center Word Audio Off/On control) is the only startup and live switch; no secondary setting and no CLI/env parameter",
  "snapshot_block": "queue-center snapshot word_audio section carries full_sync status (running, last_sync_at, last_result, languages, cache_saved_at, queue_count)"
 },
 "sentence_audio_full_sync": {
  "description": "pycore sentence-audio full pull: while Sentence Audio is ON pycore mirrors EVERY library sentence without audio into the local sentence_audio Queue as a Part2 backlog mirror (accept_backlog, whole-Queue dedup by {lang}:{content_id}); replaces the retired capacity-bounded sentence scan producer as the backlog feed. Binding doc: docs_fix/REQUIREMENTS_20260926_AUDIO_ORCH_QUEUE_STATE_DRIVEN.md.",
  "listing_endpoint": "GET /api/app_qy_v1/ai_tools/tts/sentence/without_audio?language=<code>&cursor_id=<id>&limit=1000 (keyset by id; without language -> {languages:[{language, without_audio}]})",
  "local_task_marker": "_local_source=full_sync; payload {text, content, language, content_id (Laravel's)}; claim and global result skipped; delivery is the sentence domain report by content_id plus the durable outbox",
  "cache_file": "get_app_cache_dir()/audio_queue/sentence_audio_queue.json",
  "persisted_key": "assist_settings capabilities.sentence_audio (the Queue Center Sentence Audio switch)"
 },
 "audio_lane_state": {
  "description": "State-driven Word Audio / Sentence Audio: pycore owns the lane truth (switch, lifecycle, section contract, Part1/Part2/whole-Queue view, Part1 tracker, worker, outbox, full pull) and pushes it on every change.",
  "topic": "queue_center.audio_lane.changed",
  "rpc": "ui/queue_center/audio_lane_state {owner?, item_limit?} -> {instance, revision, lanes: {word_audio, sentence_audio}, wordAudio, sentenceAudio}",
  "control_response": "ui/task_center/set_queue_center_control returns lane_state (the same payload) for audio lanes",
  "revision": "monotonic per pycore instance; the UI ignores payloads older than the one it holds (reset on a new instance)",
  "tracked_states": [
   "queued",
   "processing",
   "done",
   "failed"
  ],
  "activation": "one ON chain per lane: restore snapshot -> full pull into Part2 (word: dictionary without_audio listing; sentence: library sentences without audio listing) + the lane worker's FULL_SYNC diff mirror of Laravel's live tasks -> drain",
  "full_sync_rpc": "ui/queue_center/audio_lane_full_sync {lane} (ui/queue_center/word_audio_full_sync stays as the word-lane compatibility entry)"
 },
 "dict_lane_queue": {
  "description": "Dict-lane live queues: the backend no longer maintains these queues with timer tasks. Each lane is a live view over its dictionary source query, cached in the FrankenPHP worker's memory and mirrored to the database cache store; every serve runs one ms-level table probe (table length + write counters: PostgreSQL pg_stat_user_tables, fallback COUNT(*)+MAX(updated_at)); unchanged signature serves the cached queue with zero database reads, a changed signature re-fetches only the lane's lite id list and minimally diffs it. global_tasks rows are materialized just-in-time when a worker pulls (POST /api/worker/tasks/{taskType}/pull). Retired timer tasks: appqyv1_word_validity_scan, app_qy_v1_word_translation_scan_task, app_qy_v1_dictionary_translation_task, app_qy_v1_word_translation_filler_task, queue_center_audio_scan, appqyv1_word_media_scan, appqyv1_tts_generation, app_qy_v1_tts_lock_reclaim_task. Binding doc: docs_fix/DESIGN_20260922_DICT_LANE_LIVE_QUEUE.md.",
  "lanes": {
   "word_audio": {
    "source": "dictionary table per language; filter: has_audio=false OR has_audio IS NULL (identical to the without_audio management filter)",
    "order": "query_count DESC, id ASC",
    "materialize": "one word_audio global_tasks row per word via QueueCenterService::enqueue (group_key live-dedup)",
    "listing_endpoint": "GET /api/app_qy_v1/dictionary/words?filter=without_audio served from the lane cache when no search/sort narrowing (same for the view lanes)"
   },
   "word_translation": {
    "source": "has_translation=false AND is_valid=true",
    "order": "query_count DESC, id ASC",
    "materialize": "one task per 40 words; execution_type remote_translation; payload {words[],language,target_language=zh,word_count}; pile-up guard max 1 live task per language"
   },
   "word_validity": {
    "source": "validity_checked_at IS NULL",
    "order": "query_count DESC, id ASC",
    "materialize": "one task per contract word_validity.batch_size words; execution_type remote_validity; pile-up guard max 1 live task per language"
   },
   "dictionary_explanation": {
    "source": "has_translation=false AND is_valid=true (dictionary_explanation_demo shares the lane)",
    "order": "query_count DESC, id ASC",
    "materialize": "one task per 10 words; execution_type from contract task_types; pile-up guard max 2 live tasks per language"
   }
  },
  "probe": {
   "pgsql": "SELECT n_live_tup,n_tup_ins,n_tup_upd,n_tup_del FROM pg_stat_user_tables (ms-level, no table scan)",
   "fallback": "COUNT(*) + MAX(updated_at) on the source table",
   "dirty_bump": "AppQyV1LangDictionaryModel::forgetMetricsCache increments a per-language dirty counter folded into the signature, so same-request writes are visible immediately"
  },
  "direct_emit": "Head notifications and realtime outbox events publish in the same request that creates them; the queue_head_notification_task and realtime_outbox_publish_task pollers are decommissioned (registered but disabled as operator safety nets via user-data settings queue_center_head_notification_poller / realtime_outbox_publish_poller). Global task maintenance runs on-demand in the pull path (DictLaneMaintenance::onPull, throttled 15s; hourly slow slice); global_task_maintenance_task is disabled (safety net setting global_task_maintenance_poller).",
  "view_lanes": {
   "without_translation": "view-only listing lane; filter byte-identical to managementFilter without_translation (has_translation false/NULL AND translations empty); serves dictionaryWords?filter=without_translation",
   "valid": "view-only listing lane; is_valid=true OR NULL; serves dictionaryWords?filter=valid",
   "invalid": "view-only listing lane; is_valid=false; serves dictionaryWords?filter=invalid"
  }
 },
 "diff_delivery": {
  "version": 1,
  "cursor_store": "Persistent revision and high-water metadata only.",
  "id_page_store": "Bounded ID pages; queue-head moves update this layer without loading rows.",
  "data_segment_store": "Full records are materialized only on a UI or consumer request and compacted after consumption.",
  "id_page_limit": 64,
  "id_limit": 4096,
  "data_segment_limit": 128,
  "poll_interval_ms": 1000,
  "consumer_slice_default": 8,
  "head_reserve": 1,
