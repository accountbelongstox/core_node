{
  "schema_version": 3,
  "contract": "queue_center",
  "source_path": "config/queue_center_contract.json",
  "metric_semantics": {
    "pending": "Ready work that has not been claimed.",
    "leased": "Claimed or assigned work that has not started processing.",
    "processing": "Work actively being processed.",
    "total": "All records in the category source population, including terminal records when the source retains them."
  },
  "control_names": [
    "assist_translation",
    "word_audio",
    "sentence_audio"
  ],
  "section_contract_defaults": {
    "queue": {"pending": 0, "leased": 0, "processing": 0, "total": 0},
    "worker": {"online": false, "claimed": 0, "ok": null, "fail": null, "last_heartbeat": null},
    "toggle": {"requested_by": null, "enabled": false, "reason": null, "graceful_stop": false, "paused_by_user": null},
    "lifecycle": "off",
    "error_code": null,
    "last_error": null,
    "age_s": null,
    "stale": false
  },
  "capability_claimants": {
    "translate": ["pycore", "chrome"],
    "ai_translate": ["pycore", "chrome"],
    "puter_translate": ["chrome"],
    "audio": ["pycore", "chrome"],
    "image": ["chrome"],
    "sentence_audio": ["pycore"],
    "subtitle": ["pycore"],
    "poster": ["chrome"],
    "stt": ["pycore"]
  },
  "section_scopes": {
    "heartbeat": {
      "category": "heartbeat_workers",
      "category_keys": [],
      "queue_metrics": false
    },
    "assist_translation": {
      "category": "assist_translation",
      "category_keys": [
        "word_translation",
        "ai_translate",
        "subtitle_search",
        "subtitle_lang",
        "book_lang"
      ],
      "queue_metrics": true
    },
    "word_audio": {
      "category": "word_audio",
      "category_keys": ["word_audio"],
      "queue_metrics": true
    },
    "sentence_audio": {
      "category": "sentence_audio",
      "category_keys": ["sentence_audio"],
      "queue_metrics": true
    },
    "media_image": {
      "category": "media_image",
      "category_keys": ["word_media", "cover", "poster", "gemini_image"],
      "queue_metrics": true
    }
  },
  "task_contract": {
    "statuses": {
      "values": {
        "pending": "pending",
        "assigned": "assigned",
        "processing": "processing",
        "completed": "completed",
        "completed_demo": "completed_demo",
        "failed": "failed",
        "cancelled": "cancelled"
      },
      "all": ["pending", "assigned", "processing", "completed", "completed_demo", "failed", "cancelled"],
      "live": ["pending", "assigned", "processing"],
      "terminal": ["completed", "completed_demo", "failed", "cancelled"],
      "worker_reportable": ["processing", "completed", "failed"]
    },
    "execution_types": {
      "local_timer": "local_timer",
      "remote_client": "remote_client",
      "remote_compute": "remote_compute",
      "remote_ocr": "remote_ocr",
      "remote_translation": "remote_translation",
      "remote_video": "remote_video",
      "remote_io": "remote_io",
      "remote_audio": "remote_audio",
      "remote_notebooklm": "remote_notebooklm",
      "remote_gemini": "remote_gemini",
      "remote_gemini_text": "remote_gemini_text",
      "remote_validity": "remote_validity",
      "remote_fast": "remote_fast",
      "remote_subtitle": "remote_subtitle",
      "remote_poster": "remote_poster",
      "remote_sentence_audio": "remote_sentence_audio",
      "remote_stt": "remote_stt",
      "remote_chatgpt": "remote_chatgpt"
    },
    "priorities": {
      "default": 0,
      "manual": 50,
      "fast": 100,
      "maximum": 1000
    },
    "limits": {
      "list": 200,
      "worker_pull": 50,
      "completed": 500,
      "long_poll_seconds": 30
    },
    "capability_labels": {
      "audio": "Audio",
      "image": "Image",
      "translate": "Translate",
      "sentence_audio": "Sentence Audio",
      "ai_translate": "AI Translate",
      "puter_translate": "Puter Translate",
      "subtitle": "Subtitle",
      "poster": "Poster",
      "stt": "Speech to Text"
    },
    "capability_single_lanes": {
      "translate": "remote_translation",
      "audio": "remote_audio",
      "image": "remote_gemini",
      "subtitle": "remote_subtitle",
      "poster": "remote_poster",
      "sentence_audio": "remote_sentence_audio",
      "stt": "remote_stt"
    },
    "fast_lane_capabilities": [
      "translate", "ai_translate", "puter_translate", "audio", "image", "sentence_audio"
    ],
    "wire_shapes": {
      "summary": [
        "task_id", "app_name", "task_type", "execution_type", "status", "progress",
        "assigned_to", "created_at", "capability", "priority", "is_fast_tier"
      ],
      "worker_pull": [
        "task_id", "app_name", "task_type", "execution_type", "status", "payload",
        "timeout_seconds", "priority", "capability", "is_fast_tier", "created_at"
      ],
      "status": [
        "task_id", "app_name", "task_type", "execution_type", "capability", "is_fast_tier",
        "status", "priority", "progress", "retry_count", "max_retries", "timeout_seconds",
        "payload", "result", "error", "assigned_to", "assigned_at", "timeout_at",
        "completed_at", "created_at", "updated_at"
      ],
      "detail": [
        "task_id", "app_name", "task_type", "execution_type", "capability", "is_fast_tier",
        "status", "priority", "progress", "payload", "result", "error", "assigned_to",
        "assigned_at", "timeout_at", "completed_at", "created_at", "updated_at"
      ],
      "event": ["id", "task_id", "event", "worker_id", "attempt", "detail", "created_at"],
      "worker_registration": [
        "worker_id", "worker_name", "processor_types", "capabilities", "hostname", "platform", "metadata"
      ],
      "worker_result": ["task_id", "worker_id", "status", "progress", "result", "error"]
    },
