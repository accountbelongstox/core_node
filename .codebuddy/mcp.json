        },
        "SQLiteCRUD": {
            "command": "cmd",
            "args": [
                "/c",
                "python",
                "D:\\programing\\core_node\\ncore\\mcp_server\\sqlite_crud_38001\\ascii_server.py"
            ],
            "env": {
                "PYTHONPATH": "D:\\programing\\core_node\\ncore\\mcp_server\\sqlite_crud_38001",
                "SERVICE_ROOT": "D:\\programing\\core_node\\ncore\\mcp_server\\sqlite_crud_38001",
                "DB_PATH": "./databases/",
                "SERVER_HOST": "127.0.0.1",
                "SERVER_PORT": "38001"
            },
            "disabled": false,
            "autoApprove": []
        },
        "AlibabaDataworks": {
            "command": "cmd",
            "args": [
                "/c",
                "node",
                "alibabacloud-dataworks-mcp-server"
            ],
            "env": {
                "REGION": "your_dataworks_open_api_region_id_here",
                "ALIBABA_CLOUD_ACCESS_KEY_ID": "your_alibaba_cloud_access_key_id",
                "ALIBABA_CLOUD_ACCESS_KEY_SECRET": "your_alibaba_cloud_access_key_secret",
                "TOOL_CATEGORIES": "optional_your_tool_categories_here_ex_UTILS",
                "TOOL_NAMES": "optional_your_tool_names_here_ex_ListProjects"
            },
            "disabled": true,
            "autoApprove": []
        },
        "FeedbackEnhanced": {
            "command": "cmd",
            "args": [
                "/c",
                "uvx",
                "mcp-feedback-enhanced@latest"
            ],
            "env": {
                "MCP_DEBUG": "false",
                "MCP_WEB_HOST": "127.0.0.1",
                "MCP_WEB_PORT": "8765",
                "MCP_LANGUAGE": "en"
            },
            "disabled": false,
            "autoApprove": []
        }
